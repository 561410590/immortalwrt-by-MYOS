#!/bin/sh /etc/rc.common
START=99
STOP=15
USE_PROCD=1

start_service() {
	[ -s /www/5700/index.html ] || return 1
	procd_open_instance modem_webui
	procd_set_param command /usr/bin/python3 /usr/libexec/myos-nbcpe-webui
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
