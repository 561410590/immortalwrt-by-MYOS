#!/bin/sh /etc/rc.common
START=98

# NBCPE already owns modem dialing, cache collection, SMS and the WebUI.
# Let procd supervise only the AK68 LED/identity monitor on this platform.
if [ -x /etc/init.d/myos-nbcpe-cache ] && [ -x /etc/init.d/myos-nbcpe-webui ]; then
  USE_PROCD=1
  STOP=15
fi

start_service() {
  [ -x /etc/init.d/myos-nbcpe-leds ] && return 0
  procd_open_instance netmodeled
  procd_set_param command /usr/share/modem-AK68/netmodeled-AK68.sh
  procd_set_param respawn 3600 5 5
  procd_close_instance
}

nbcpe_optional_led() {
  local path="/sys/class/leds/hc:blue:$1/brightness"
  [ -w "$path" ] || return 0
  echo "$2" > "$path"
}

if [ -z "$USE_PROCD" ]; then
  restart(){
    modem_init_AK68
  }

  start(){
    modem_init_AK68
  }
fi

modem_init_AK68(){
  echo "已尝试开启短信转发服务。"
  python3 /usr/bin/smstrun-AK68.py &
  if [ -f /usr/bin/ledflagc.conf ]; then
      echo "0" > /tmp/ledflag.conf
      echo 0 > /sys/class/leds/hc:blue:cmode4/brightness
      echo 0 > /sys/class/leds/hc:blue:cmode5/brightness
      echo 0 > /sys/class/leds/hc:blue:wifi/brightness
      echo 0 > /sys/class/leds/hc:blue:status/brightness
      nbcpe_optional_led sig1 0
      nbcpe_optional_led sig2 0
      nbcpe_optional_led sig3 0
      nbcpe_optional_led int 0
  fi
  /usr/bin/BLUE4WAN-AK68.sh
  if [ ! -e /usr/share/modem/rm520n.sh ]; then
    echo 1 >/sys/class/gpio/cpe-pwr/value
  fi
  echo "AK68模块正在获取信息...请等待几分钟后刷新页面。" > /tmp/cpe_cell-AK68.file
  sleep 10
  echo "设备检测中..." > /tmp/devck.conf
  echo "模组检测中..." > /tmp/modconf-AK68.conf
  echo "未检测到模组设备连接,等待连接中..."
  python3 /usr/bin/httpapi-AK68.py &
  /usr/share/modem-AK68/MT5700-AK68.sh &
  /usr/share/modem-AK68/netmodeled-AK68.sh &
  /usr/share/modem-AK68/devck-AK68.sh &
  # 检测192.168.225.1是否能通
  #if ping -c 1 192.168.225.1 &> /dev/null; then
    #echo "RM520N" > /tmp/modconf-AK68.conf
    #cp -f /usr/share/modem-AK68/C-RM520N /etc/config/atsd_tools
    #/etc/init.d/atsd_tools restart
    #echo "已有设备" > /tmp/devck.conf
    #/usr/share/modem-AK68/rm520n-AK68.sh &
    #/usr/share/modem-AK68/netmodeled-AK68.sh &
    #/usr/share/modem-AK68/devck-AK68.sh &
    #python3 /usr/bin/httpapi-AK68.py &
    #echo "已尝试开启网络AT服务。"
  # 检测192.168.8.1是否能通
  #elif ping -c 1 192.168.8.1 &> /dev/null; then
    #echo "MT5700" > /tmp/modconf-AK68.conf
    #cp -f /usr/share/modem-AK68/C-MT5700 /etc/config/atsd_tools
    #/etc/init.d/atsd_tools restart
    #echo "已有设备" > /tmp/devck.conf
    #echo "已尝试开启网络AT服务。"
    #python3 /usr/bin/httpapi-AK68.py &
    #/usr/share/modem-AK68/MT5700-AK68.sh &
    #/usr/share/modem-AK68/netmodeled-AK68.sh &
    #/usr/share/modem-AK68/devck-AK68.sh &
  #else
    #echo "设备检测中..." > /tmp/devck.conf
    #echo "模组检测中..." > /tmp/modconf-AK68.conf
    #echo "未检测到模组设备连接,等待连接中..."
    #python3 /usr/bin/httpapi-AK68.py &
    #/usr/share/modem-AK68/MT5700-AK68.sh &
    #/usr/share/modem-AK68/netmodeled-AK68.sh &
    #/usr/share/modem-AK68/devck-AK68.sh &
  #fi
}

check_and_update_simsel_AK68_RM520() {
  local sim_slot=$(atsd_tools_cli -i cpe -c "AT+QUIMSLOT?" | grep '+QUIMSLOT:' | awk '{print $2}')
  local sim_sel_file="/etc/simsel-AK68"

  # 如果 sim_sel_file 不存在，则创建并写入外置卡 SIM 卡槽值，仅用于修正刷机和ui显示问题
  if [ ! -e "$sim_sel_file" ]; then
    echo 1 > "$sim_sel_file"
    atsd_tools_cli -i cpe -c "AT+QUIMSLOT=1"
  fi
}

check_and_update_simsel_AK68_MT5700() {
  local sim_slot=$(atsd_tools_cli -i cpe -c "AT+QUIMSLOT?" | grep '+QUIMSLOT:' | awk '{print $2}')
  local sim_sel_file="/etc/simsel-AK68"

  # 如果 sim_sel_file 不存在，则创建并写入外置卡 SIM 卡槽值，仅用于修正刷机和ui显示问题
  if [ ! -e "$sim_sel_file" ]; then
    echo 1 > "$sim_sel_file"
    atsd_tools_cli -i cpe -c "AT+QUIMSLOT=1"
  fi
}
