#!/bin/sh
# Recover the dynamic IPv6 child without restarting the ODU or its IPv4 lease.
. /usr/share/libubox/jshn.sh

ensure_odu_ipv6() {
	local parent child ipv4 device pdptype slot apn_cfg key value zone
	local now last attempt addresses mac1 mac2 mac3 mac4 mac5 mac6 linklocal
	[ "$(uci -q get network.globals.nbcpe)" = 1 ] || return 0
	[ "$(uci -q get network.cpe.mode)" = odu ] || return 0
	[ "$(uci -q get network.cpe.disabled)" != 1 ] || return 0
	[ "$(uci -q get network.globals.ipv6)" != 0 ] || return 0
	[ "$(uci -q get network.cpe.ipv6)" != 0 ] || return 0
	[ "$(uci -q get cpebr.config.enable)" != 1 ] || return 0
	[ "$(uci -q get network.cpe_6.disabled)" != 1 ] || return 0
	[ "$(uci -q get network.cpe_6.auto)" != 0 ] || return 0

	parent=$(ubus call network.interface.cpe status 2>/dev/null) || return 1
	[ "$(printf '%s' "$parent" | jsonfilter -e '@.up')" = true ] || return 0
	device=$(printf '%s' "$parent" | jsonfilter -e '@.l3_device')
	[ -n "$device" ] && [ "$device" = "$(uci -q get network.cpe.device)" ] || return 0
	pdptype=$(printf '%s' "$parent" | jsonfilter -e '@.data.pdptype')
	if [ -z "$pdptype" ]; then
		slot=$(uci -q get cpesel.sim.cur)
		case "$slot" in 1|2) ;; *) return 0 ;; esac
		pdptype=$(uci -q get "cpecfg.cpesim$slot.pdptype")
		apn_cfg=$(uci -q get "cpecfg.cpesim$slot.apn_cfg")
		[ -z "$apn_cfg" ] || pdptype=$(uci -q get "apn.$apn_cfg.pdptype")
	fi
	pdptype=$(printf '%s' "${pdptype:-ipv4v6}" | tr 'A-Z' 'a-z')
	case "$pdptype" in ipv6|ipv4v6) ;; *) return 0 ;; esac

	child=$(ubus call network.interface.cpe_6 status 2>/dev/null)
	if [ -n "$child" ]; then
		[ "$(printf '%s' "$child" | jsonfilter -e '@.up')" != true ] || return 0
		[ "$(printf '%s' "$child" | jsonfilter -e '@.pending')" != true ] || return 0
	fi
	if [ "$pdptype" = ipv4v6 ]; then
		ipv4=$(ubus call network.interface.cpe_4 status 2>/dev/null) || return 0
		[ "$(printf '%s' "$ipv4" | jsonfilter -e '@.up')" = true ] || return 0
	fi

	# A normal DHCPv6 negotiation stays pending and is never restarted here.
	# Rate-limit failed recovery attempts while the modem/link is unavailable.
	read -r now _ < /proc/uptime
	now=${now%%.*}
	last=$(cat /var/run/myos-nbcpe-ipv6.last 2>/dev/null)
	case "$last" in
		''|*[!0-9]*) ;;
		*) [ "$now" -lt "$last" ] || [ "$((now - last))" -ge 30 ] || return 0 ;;
	esac
	printf '%s\n' "$now" > /var/run/myos-nbcpe-ipv6.last
	[ -w "/proc/sys/net/ipv6/conf/$device/disable_ipv6" ] || return 1
	sysctl -q -w "net.ipv6.conf.$device.disable_ipv6=0" || return 1
	addresses=$(ip -6 address show dev "$device" scope link)
	if ! printf '%s\n' "$addresses" | grep -q 'inet6 '; then
		# Changing addrgenmode on an already-up DSA port does not restore a
		# removed link-local address. Add its MAC-derived EUI-64 explicitly.
		IFS=: read -r mac1 mac2 mac3 mac4 mac5 mac6 < "/sys/class/net/$device/address" || return 1
		for value in "$mac1" "$mac2" "$mac3" "$mac4" "$mac5" "$mac6"; do
			case "$value" in [0-9a-fA-F][0-9a-fA-F]) ;; *) return 1 ;; esac
		done
		linklocal=$(printf 'fe80::%02x%s:%sff:fe%s:%s%s' "$((0x$mac1 ^ 2))" "$mac2" "$mac3" "$mac4" "$mac5" "$mac6")
		ip -6 address add "$linklocal/64" dev "$device" scope link || return 1
		logger -t nbcpe-ipv6 "Restored missing link-local address on $device"
	fi
	for attempt in 1 2 3 4 5; do
		addresses=$(ip -6 address show dev "$device" scope link)
		if printf '%s\n' "$addresses" | grep -v -e tentative -e dadfailed | grep -q 'inet6 '; then
			break
		fi
		[ "$attempt" -lt 5 ] || {
			logger -t nbcpe-ipv6 "Link-local address not ready on $device; IPv6 startup deferred"
			return 1
		}
		sleep 1
	done
	# Parent state may change while IPv6 duplicate-address detection completes.
	parent=$(ubus call network.interface.cpe status 2>/dev/null) || return 1
	[ "$(printf '%s' "$parent" | jsonfilter -e '@.up')" = true ] || return 0
	[ "$(printf '%s' "$parent" | jsonfilter -e '@.l3_device')" = "$device" ] || return 0
	child=$(ubus call network.interface.cpe_6 status 2>/dev/null)
	if [ -n "$child" ]; then
		[ "$(printf '%s' "$child" | jsonfilter -e '@.up')" != true ] || return 0
		[ "$(printf '%s' "$child" | jsonfilter -e '@.pending')" != true ] || return 0
		[ "$(printf '%s' "$child" | jsonfilter -e '@.proto')" = dhcpv6 ] || return 0
		ubus call network.interface.cpe_6 up >/dev/null || return 1
	else
		json_init
		json_add_string name cpe_6
		json_add_string device @cpe
		json_add_string proto dhcpv6
		json_add_boolean auto 1
		json_add_boolean extendprefix 1
		for key in defaultroute peerdns; do
			value=$(uci -q get "network.cpe.$key")
			[ -z "$value" ] || json_add_boolean "$key" "$value"
		done
		value=$(uci -q get network.cpe.metric)
		case "$value" in ''|*[!0-9]*) ;; *) json_add_int metric "$value" ;; esac
		zone=$(fw4 -q network cpe 2>/dev/null)
		[ -z "$zone" ] || json_add_string zone "$zone"
		ubus call network add_dynamic "$(json_dump)" >/dev/null || return 1
	fi
	logger -t nbcpe-ipv6 "Requested cpe_6 startup on $device; ODU and IPv4 session retained"
}

(
	flock -n 9 || exit 0
	ensure_odu_ipv6
) 9>/var/run/myos-nbcpe-ipv6.lock
