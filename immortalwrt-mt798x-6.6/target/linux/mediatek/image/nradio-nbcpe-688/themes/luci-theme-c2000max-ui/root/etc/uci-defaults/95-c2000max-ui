#!/bin/sh
# MYOS default theme for the two supported board profiles.
uci -q delete luci.themes.MYOS_UI
uci -q delete luci.themes.Argon
uci -q set luci.themes.MYOS='/luci-static/c2000max-ui'
uci -q set luci.themes.MWRT='/luci-static/argon'
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
 nradio_wt9111_No2-manper_NB68|HCMT7981-emmc-NB68)
		case "$(uci -q get luci.main.mediaurlbase)" in
			/luci-static/c2000max-ui|/luci-static/argon) ;;
			*) uci -q set luci.main.mediaurlbase='/luci-static/c2000max-ui' ;;
		esac
  ;;
esac
uci -q commit luci
/etc/init.d/c2000max-wallpaper enable
[ -n "$IPKG_INSTROOT" ] || /etc/init.d/c2000max-wallpaper start
exit 0
