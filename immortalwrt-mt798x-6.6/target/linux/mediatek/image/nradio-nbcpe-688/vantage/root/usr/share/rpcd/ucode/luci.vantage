// luci-app-vantage: server side of the Vantage dashboard.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// ubus object luci.vantage, loaded by rpcd-mod-ucode:
//
//   wireless   network.wireless status reduced to the fields the dashboard
//              reads: no key, sae_password, RADIUS or 802.11r secrets, no
//              EAP credentials. Read group luci-app-vantage.
//   sensors    temperatures in millidegrees Celsius: the SoC from the
//              thermal zone sysfs, Wi-Fi phys through iwpriv/mwctl, the
//              cellular module from the qmodem cache. Null where a source
//              is missing. Read group luci-app-vantage.
//   cellular   the cellular modem's registration and signal, from the
//              qmodem-next caches (/tmp/cache_*_info_<section>): module,
//              network mode, operator, cell ids and RSRP/RSRQ/SINR. No
//              subscriber identifiers (ICCID, IMSI, IMEI) and no AT port.
//              Read group luci-app-vantage.
//   set_alias  { mac, name, icon }: name one station, or remove its name
//              with name ''. Validated here, whatever the browser did, and
//              written to /etc/config/vantage only. Write group
//              luci-app-vantage-names.
//
// Keep the validation in step with names.js (validateAlias, normMac,
// ICONS) and with dev/replay/vantage-plugin.js; tests/plugin.test.js runs
// all three against the same cases.

'use strict';

import { cursor } from 'uci';
import { connect } from 'ubus';
import { readfile, stat, lsdir, popen } from 'fs';

const CONFIG = 'vantage';
const NAME_MAX = 48;              // code points, after collapsing spaces
const NAME_MAX_UNITS = NAME_MAX * 8; // raw input cap, in UTF-16 code units (as names.js)
const MAX_ALIASES = 512;          // client sections; bounds /etc/config/vantage
const ICONS = [ 'phone', 'laptop', 'tablet', 'desktop', 'tv', 'speaker', 'printer', 'camera', 'console', 'watch', 'iot', 'router', 'device' ];

/* ------------------------------------------------------------ helpers */

// '02-00-5E-00-53-0F' / '0200.5e00.530f' / '02005e00530f' -> '02:00:5e:00:53:0f'
function norm_mac(v) {
	if (type(v) != 'string')
		return null;

	let h = lc(trim(v));

	if (match(h, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
		return h;

	if (match(h, /^[0-9a-f]{2}(-[0-9a-f]{2}){5}$/))
		return replace(h, /-/g, ':');

	if (match(h, /^[0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4}$/) || match(h, /^[0-9a-f]{12}$/)) {
		h = replace(h, /\./g, '');
		return join(':', map(match(h, /../g), (m) => m[0]));
	}

	return null;
}

function is_multicast(mac) {
	return (hex(substr(mac, 0, 2)) & 1) == 1;
}

// UTF-8 -> [ [ code point, byte offset, byte length ], ... ]; null when the
// bytes are not well-formed UTF-8 (overlong forms and surrogates included)
function decode(s) {
	let out = [], n = length(s), i = 0;

	while (i < n) {
		let b = ord(s, i), cp, need;

		if (b < 0x80) { cp = b; need = 0; }
		else if (b >= 0xc2 && b <= 0xdf) { cp = b & 0x1f; need = 1; }
		else if (b >= 0xe0 && b <= 0xef) { cp = b & 0x0f; need = 2; }
		else if (b >= 0xf0 && b <= 0xf4) { cp = b & 0x07; need = 3; }
		else return null;

		if (i + need >= n)
			return null;

		for (let k = 1; k <= need; k++) {
			let c = ord(s, i + k);

			if ((c & 0xc0) != 0x80)
				return null;

			cp = (cp << 6) | (c & 0x3f);
		}

		if ((need == 2 && cp < 0x800) || (need == 3 && (cp < 0x10000 || cp > 0x10ffff)) || (cp >= 0xd800 && cp <= 0xdfff))
			return null;

		push(out, [ cp, i, need + 1 ]);
		i += need + 1;
	}

	return out;
}

// control, invisible, bidi and format characters: the C0/C1 controls plus
// fmt.js UNSAFE_TEXT
function forbidden(cp) {
	return cp <= 0x1f || (cp >= 0x7f && cp <= 0x9f) ||
		cp == 0xad || cp == 0x34f || cp == 0x61c || cp == 0x115f || cp == 0x1160 ||
		cp == 0x17b4 || cp == 0x17b5 || cp == 0x180e || cp == 0x200b || cp == 0x200e || cp == 0x200f ||
		(cp >= 0x2028 && cp <= 0x202e) || (cp >= 0x2060 && cp <= 0x206f) || cp == 0x3164 ||
		(cp >= 0xfe00 && cp <= 0xfe0d) || cp == 0xfeff || cp == 0xffa0 || (cp >= 0xfff9 && cp <= 0xfffb) ||
		(cp >= 0xe0000 && cp <= 0xe007f);
}

// space characters that collapse to one U+0020
function is_space(cp) {
	return cp == 0x20 || cp == 0xa0 || cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200a) ||
		cp == 0x202f || cp == 0x205f || cp == 0x3000;
}

// names.js validateAlias: -> { ok: true, value } ('' clears) or { ok: false, error }
function validate_name(name) {
	if (name == null)
		name = '';

	if (type(name) != 'string')
		return { ok: false, error: 'invalid-name' };

	let cps = decode(name);

	if (cps == null)
		return { ok: false, error: 'invalid-name' };

	let units = 0;

	for (let c in cps)
		units += (c[0] > 0xffff) ? 2 : 1;

	if (units > NAME_MAX_UNITS)
		return { ok: false, error: 'name-too-long' };

	for (let c in cps)
		if (forbidden(c[0]))
			return { ok: false, error: 'invalid-name' };

	// collapse runs of spaces, trim both ends
	let out = '', count = 0, pending = false;

	for (let c in cps) {
		if (is_space(c[0])) {
			pending = true;
			continue;
		}

		if (pending && count) {
			out += ' ';
			count++;
		}

		pending = false;
		out += substr(name, c[1], c[2]);
		count++;
	}

	if (count > NAME_MAX)
		return { ok: false, error: 'name-too-long' };

	return { ok: true, value: out };
}

function scalar(v) {
	return (type(v) in [ 'string', 'int', 'double', 'bool' ]) ? v : null;
}

function short_string(v, max) {
	return (type(v) == 'string' && length(v) <= max) ? v : null;
}

/* ----------------------------------------------------------- wireless */

// the encryption mode ('sae-mixed+ccmp', 'psk2', 'none', ...): its leading
// run of mode characters and nothing after it
function encryption(v) {
	let m = (type(v) == 'string') ? match(v, /^[A-Za-z0-9+_-]{1,40}/) : null;
	return m ? m[0] : null;
}

function reduce_iface(i) {
	let c = (type(i.config) == 'object') ? i.config : {};
	let networks = [];

	for (let n in ((type(c.network) == 'array') ? c.network : [ c.network ]))
		if (type(n) == 'string' && length(n) <= 64)
			push(networks, n);

	return {
		ifname: short_string(i.ifname, 64),
		section: short_string(i.section, 64),
		config: {
			ssid: short_string(c.ssid, 128),
			mode: short_string(c.mode, 32),
			hidden: scalar(c.hidden),
			encryption: encryption(c.encryption),
			ieee80211w: scalar(c.ieee80211w),
			ieee80211r: scalar(c.ieee80211r),
			ieee80211k: scalar(c.ieee80211k),
			ieee80211v: scalar(c.ieee80211v),
			network: networks,
			macaddr: norm_mac(c.macaddr)
		}
	};
}

function reduce_radio(r) {
	let c = (type(r.config) == 'object') ? r.config : {};
	let ifaces = [];

	for (let i in ((type(r.interfaces) == 'array') ? r.interfaces : []))
		if (type(i) == 'object')
			push(ifaces, reduce_iface(i));

	return {
		up: r.up === true,
		pending: r.pending === true,
		disabled: r.disabled === true,
		config: {
			band: short_string(c.band, 16),
			channel: scalar(c.channel),
			htmode: short_string(c.htmode, 16),
			country: short_string(c.country, 8),
			txpower: scalar(c.txpower),
			disabled: scalar(c.disabled)
		},
		interfaces: ifaces
	};
}

/* ---------------------------------------------------------- set_alias */

function set_alias(args) {
	let mac = norm_mac(args.mac);

	if (!mac || is_multicast(mac))
		return { ok: false, error: 'invalid-mac' };

	let v = validate_name(args.name);

	if (!v.ok)
		return v;

	let icon = args.icon ?? '';

	if (icon != '' && !(icon in ICONS))
		return { ok: false, error: 'invalid-icon' };

	let uci = cursor();
	let mine = [], total = 0;

	uci.load(CONFIG);
	uci.foreach(CONFIG, 'client', (s) => {
		total++;

		if (norm_mac(s.mac) == mac)
			push(mine, s['.name']);
	});

	let op;

	if (v.value == '') {
		if (!length(mine))
			return { ok: true, op: 'none', mac };

		for (let sid in mine)
			uci.delete(CONFIG, sid);

		op = 'delete';
	}
	else if (length(mine)) {
		// one section per MAC: update the first, drop duplicates
		uci.set(CONFIG, mine[0], 'mac', mac);
		uci.set(CONFIG, mine[0], 'name', v.value);

		if (icon != '')
			uci.set(CONFIG, mine[0], 'icon', icon);
		else
			uci.delete(CONFIG, mine[0], 'icon');

		for (let sid in slice(mine, 1))
			uci.delete(CONFIG, sid);

		op = 'set';
	}
	else {
		if (total >= MAX_ALIASES)
			return { ok: false, error: 'too-many' };

		let sid = uci.add(CONFIG, 'client');

		if (!sid)
			return { ok: false, error: 'failed' };

		uci.set(CONFIG, sid, 'mac', mac);
		uci.set(CONFIG, sid, 'name', v.value);

		if (icon != '')
			uci.set(CONFIG, sid, 'icon', icon);

		op = 'add';
	}

	if (!uci.commit(CONFIG))
		return { ok: false, error: 'failed' };

	return { ok: true, op, mac };
}

/* ------------------------------------------------------------ sensors */

// SoC temperature: the first thermal zone sysfs that answers
const CPU_TEMP_PATHS = [
	'/sys/devices/virtual/thermal/thermal_zone0/temp',
	'/sys/class/thermal/thermal_zone0/temp'
];

// qmodem-next caches its AT answers as /tmp/cache_<kind>_info_<section>
const CACHE_NAME = /^cache_(base|cell|sim|network)_info_([A-Za-z0-9_.-]{1,64})$/;

// one file, read directly. rpcd is single-threaded: calling its own
// `file` object from a handler would deadlock the event loop.
function read_file(path) {
	let r = readfile(path);
	return (type(r) == 'string') ? r : null;
}

// /tmp qmodem cache file names -> mtime, read directly (see read_file)
function list_tmp() {
	let names = lsdir('/tmp'), out = {};

	if (type(names) == 'array')
		for (let name in names) {
			if (type(name) != 'string' || !match(name, CACHE_NAME))
				continue;
			let st = stat('/tmp/' + name);
			if (type(st) != 'object' || st.type != 'file')
				continue;
			out[name] = (type(st.mtime) in [ 'int', 'double' ]) ? int(st.mtime) : 0;
		}

	return out;
}

// sysfs thermal reading ('48473', maybe with a newline) -> millidegrees,
// clamped to what a real sensor reports; null when absent or nonsense
function milli_c(v) {
	if (type(v) != 'string')
		return null;

	let m = match(trim(v), /^-?\d{1,6}$/);

	if (!m)
		return null;

	let n = int(m[0]);
	return (n >= -40000 && n <= 150000) ? n : null;
}

// a decimal integer out of a modem field like '-81'; null when absent
function int_value(v) {
	if (type(v) != 'string')
		return null;

	let m = match(trim(v), /^-?\d{1,9}$/);
	return m ? int(m[0]) : null;
}

// '30 °C' -> 30000 millidegrees (the modem reports whole Celsius)
function temp_mc(v) {
	if (type(v) != 'string')
		return null;

	let m = match(trim(v), /^-?\d{1,3}/);

	if (!m)
		return null;

	let n = int(m[0]);
	return (n >= -40 && n <= 150) ? n * 1000 : null;
}

// 'Yes'/'ready' -> true, 'No'/anything else -> false, absent -> null
function yes_no(v, yes) {
	if (type(v) != 'string')
		return null;

	return lc(trim(v)) == yes;
}

// short_string, but '' means absent
function opt_string(v, max) {
	let s = short_string(v, max);
	return (s == null || s == '') ? null : s;
}

// modem_info rows -> one key -> value map, first occurrence wins
function entries_map(rows) {
	let out = {};

	for (let e in (type(rows) == 'array' ? rows : []))
		if (type(e) == 'object' && type(e.key) == 'string' && type(e.value) == 'string' &&
		    length(e.key) <= 64 && length(e.value) <= 128 && !(e.key in out))
			out[e.key] = e.value;

	return out;
}

// { section, kinds: { base: rows, ... }, updated }: the qmodem caches of
// one modem section (the lexicographically first found). updated is the
// newest mtime among the caches used. null when /tmp holds none.
function modem_caches() {
	let files = list_tmp(), seen = {}, sections = [];

	for (let name in files) {
		let m = match(name, CACHE_NAME);

		if (m && !(m[2] in seen)) {
			seen[m[2]] = true;
			push(sections, m[2]);
		}
	}

	if (!length(sections))
		return null;

	let section = sort(sections)[0], kinds = {}, updated = 0;

	for (let kind in [ 'base', 'cell', 'sim', 'network' ]) {
		let name = `cache_${kind}_info_${section}`;

		if (!(name in files))
			continue;

		let data = read_file('/tmp/' + name);

		if (type(data) != 'string' || !match(data, /^\s*\{/))
			continue;

		let parsed = null;
		try { parsed = json(data); } catch (e) { parsed = null; }

		if (type(parsed) != 'object' || type(parsed.modem_info) != 'array')
			continue;

		kinds[kind] = parsed.modem_info;

		if (files[name] > updated)
			updated = files[name];
	}

	if (!length(keys(kinds)))
		return null;

	return { section, kinds, updated };
}

// Wi-Fi phy temperatures: the mt_wifi driver exposes them through
// iwpriv/mwctl only, which needs a shell. The firmware's c2000max.ui
// wraps the same command, but it is an rpcd ucode plugin and calling it
// from here would deadlock rpcd, so run the tool directly (exactly as
// the firmware's own c2000max-ui plugin does).
function wifi_temps() {
	let out = [];

	for (let iface in [ 'ra0', 'rai0', 'rax0' ]) {
		if (!stat('/sys/class/net/' + iface))
			continue;
		let command = stat('/usr/sbin/iwpriv') ? ('/usr/sbin/iwpriv ' + iface + ' stat')
			: stat('/usr/sbin/mwctl') ? ('/usr/sbin/mwctl dev ' + iface + ' stat') : null;
		if (!command)
			continue;
		let pipe = popen(command, 'r');
		if (!pipe)
			continue;
		let output = pipe.read('all');
		pipe.close();
		let found = match(output ?? '', /CurrentTemperature\s*=\s*(-?[0-9]+)/);
		if (found && int(found[1]) > -40 && int(found[1]) < 150)
			push(out, { phy: iface, temp_mc: int(found[1]) * 1000 });
	}

	return out;
}

function cpu_temp() {
	for (let p in CPU_TEMP_PATHS) {
		let n = milli_c(read_file(p));

		if (n != null)
			return { temp_mc: n, sensor: p };
	}

	return { temp_mc: null, sensor: null };
}

function modem_temp(caches) {
	return (caches == null) ? null : temp_mc(entries_map(caches.kinds.base).temperature);
}

/* ----------------------------------------------------------- cellular */

// the caches reduced to the fields the dashboard reads. The rows also
// carry subscriber identifiers (ICCID, IMSI, IMEI) and the AT port; those
// are dropped here, like the Wi-Fi keys in reduce_radio.
function reduce_cellular(caches) {
	if (caches == null)
		return {
			present: false, section: null, module: null, manufacturer: null,
			revision: null, connected: null, tech: null, rat: null,
			operator: null, mcc: null, mnc: null, cell_id: null, pci: null,
			tac: null, arfcn: null, band: null, scs: null,
			rsrp: null, rsrq: null, sinr: null, sim_ready: null, updated: null
		};

	let base = entries_map(caches.kinds.base);
	let cell = entries_map(caches.kinds.cell);
	let net = entries_map(caches.kinds.network);
	let sim = entries_map(caches.kinds.sim);

	// 'NR5G-SA Mode' -> 'NR5G-SA'
	let tech = (type(cell.network_mode) == 'string') ? replace(trim(cell.network_mode), /\s+Mode$/, '') : '';

	return {
		present: true,
		section: opt_string(caches.section, 64),
		module: opt_string(base.name, 64),
		manufacturer: opt_string(base.manufacturer, 64),
		revision: opt_string(base.revision, 64),
		connected: yes_no(base.connect_status, 'yes'),
		tech: opt_string(tech, 24),
		rat: opt_string(net.MODE ?? net.Mode, 8),
		operator: opt_string(net.Operator ?? net.ISP, 16),
		mcc: opt_string(cell.MMC, 8),
		mnc: opt_string(cell.MNC, 8),
		cell_id: opt_string(cell['Cell ID'], 32),
		pci: opt_string(cell['Physical Cell ID'], 16),
		tac: opt_string(cell.TAC, 16),
		arfcn: opt_string(cell.ARFCN, 16),
		band: opt_string(cell.Band, 16),
		scs: int_value(cell.SCS),
		rsrp: int_value(cell.RSRP),
		rsrq: int_value(cell.RSRQ),
		sinr: int_value(cell.SINR),
		sim_ready: yes_no(sim['SIM Status'], 'ready'),
		updated: (type(caches.updated) == 'int' && caches.updated > 0) ? caches.updated : null
	};
}

/* ------------------------------------------------------------ methods */

// The collector publishes a reduced snapshot outside rpcd. Dashboard reads
// must not execute the former cellular VM path, which aborts rpcd on NB68.
// The snapshot contains no subscriber identifiers or modem control commands.
function nbcpe_dashboard() {
	let snapshot = null;
	try { snapshot = json(readfile('/tmp/myos-nbcpe-dashboard.json') ?? ''); }
	catch (e) { return {}; }
	if (type(snapshot) != 'object' || type(snapshot.sampled_at) != 'int' ||
	    time() < snapshot.sampled_at || time() - snapshot.sampled_at > 120)
		return {};
	return snapshot;
}

const methods = {
	wireless: {
		call: function() {
			let reply = connect()?.call('network.wireless', 'status');
			let out = {};

			if (type(reply) != 'object')
				return out;

			for (let name, r in reply)
				if (type(r) == 'object' && match(name, /^[A-Za-z0-9_.-]{1,64}$/))
					out[name] = reduce_radio(r);

			return out;
		}
	},

	sensors: {
		call: function() {
			let cpu = cpu_temp();

			return {
				cpu_temp_mc: cpu.temp_mc,
				cpu_sensor: cpu.sensor,
				wifi_temps: wifi_temps(),
				modem_temp_mc: nbcpe_dashboard().modem_temp_mc
			};
		}
	},

	cellular: {
		call: function() {
			let snapshot = nbcpe_dashboard();
			return type(snapshot.cellular) == 'object' ? snapshot.cellular : { present: false };
		}
	},

	set_alias: {
		args: { mac: 'mac', name: 'name', icon: 'icon' },
		call: function(request) {
			return set_alias(request.args);
		}
	}
};

return { 'luci.vantage': methods };
