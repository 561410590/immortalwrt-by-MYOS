#!/bin/sh /etc/rc.common

START=90
STOP=92
USE_PROCD=1

checker_interface() {
	local rule="$1" proto disabled mode
	config_get proto "$rule" proto
	config_get disabled "$rule" disabled
	config_get mode "$rule" mode

	if [ "$mode" = "odu" ] && [ "$disabled" != "1" ] && [ "$proto" = "wwan" ]; then
		procd_open_instance
		# Discovery must keep watching an unpowered/unplugged ODU. Its normal
		# retries are diagnostic chatter; retain warnings and errors instead.
		procd_set_param command /usr/sbin/atserver-sniffer -i "$rule" -l 4
		procd_set_param respawn 5 5 -1
		procd_close_instance
	fi
}

start_service() {
	config_load network
	config_foreach checker_interface interface
}
