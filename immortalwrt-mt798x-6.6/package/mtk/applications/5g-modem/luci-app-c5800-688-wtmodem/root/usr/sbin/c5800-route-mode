#!/bin/sh
# Change only the new-connection rules; keep native modem routes and sessions.
case "$1" in
	daily) policy=poe_first ;;
	download) policy=dual_download ;;
	*) exit 2 ;;
esac
if [ "$1" = "download" ]; then
	case "$(uci -q get network.cpe1.proto)" in
		wwan|odu|nrcpe) ;;
		*) exit 5 ;;
	esac
fi

iptables -t mangle -S mwan3_rules >/dev/null 2>&1 || exit 3
mkdir /var/run/c5800-route-mode.lock 2>/dev/null || exit 4
trap 'rmdir /var/run/c5800-route-mode.lock' EXIT
trap 'exit 1' INT TERM

uci set "mwan3.web_tcp.use_policy=$policy" || exit 1
uci set "mwan3.web_quic.use_policy=$policy" || exit 1
uci set "mwan3.globals.download_mode=$1" || exit 1
uci commit mwan3 || exit 1

. /lib/functions.sh
. /lib/functions/network.sh
. /lib/mwan3/mwan3.sh
mwan3_init
mwan3_set_user_rules
iptables -t mangle -C mwan3_rules -i br-lan -p tcp -m multiport --dports 80,443 \
	-m mark --mark 0/0x3f00 -j "mwan3_policy_$policy" || exit 1
iptables -t mangle -C mwan3_rules -i br-lan -p udp -m multiport --dports 443 \
	-m mark --mark 0/0x3f00 -j "mwan3_policy_$policy" || exit 1
