#!/bin/sh /etc/rc.common
START=99
STOP=11
USE_PROCD=1
start_service() {
    [ "$(uci -q get dual_pdp.main.enabled)" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/dual-pdp-worker
    procd_set_param respawn 120 10 5
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger dual_pdp; }
