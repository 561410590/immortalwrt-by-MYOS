#!/bin/sh

# argv is passed directly by execve(2); no command text is evaluated by a
# shell.  modem_util provides the same locks used by QModem, SIM switching,
# SMS and LED status reads.
port="$1"
timeout_seconds="$2"
command="$3"

case "$port" in
	/dev/*) ;;
	*) echo "invalid AT port" >&2; exit 2 ;;
esac
case "$timeout_seconds" in
	''|*[!0-9]*) echo "invalid AT timeout" >&2; exit 2 ;;
esac
[ -n "$command" ] || {
	echo "empty AT command" >&2
	exit 2
}

. /usr/share/qmodem/modem_util.sh
QMODEM_AT_BACKEND=ubus
export QMODEM_AT_BACKEND
options="-t $timeout_seconds"
at "$port" "$command"
