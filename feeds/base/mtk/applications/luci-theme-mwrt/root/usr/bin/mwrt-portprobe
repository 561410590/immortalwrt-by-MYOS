#!/usr/bin/env python3
# 网口对端识别:网口当 LAN 用时,看插上来的是上级路由器/光猫,还是电脑这类终端。
# 只发两种"问询"广播,有回应就算网关设备:
#   DHCP 发现包   光猫路由模式、上级路由器都会回 DHCP 应答;终端设备不会
#   PPPoE 发现包  光猫桥接模式时由运营商的拨号服务器回(PADO)
# 只问不要:不请求地址、不建拨号会话,对端不会留下状态。
#
# 收发都直接在这个物理口上走原始帧:发出去的帧只走这根网线、不进网桥,
# 本机 dnsmasq 看不到,无线那边也收不到。收要用 ETH_P_ALL —— 网桥成员口上
# 只有这种抓包挂钩排在网桥接管之前,按协议绑的 packet socket 一个帧也收不到。
# 挂一段 BPF 只放行 PPPoE 发现帧和源端口 67 的 UDP,口上跑满流量也不费 CPU。
#
# 用法: mwrt-portprobe <网口>
# 结果写 /tmp/mwrt-portprobe.json,controller/modem.lua 的 port_probe 读。
# cnt = 网口的 carrier_up_count,拔插一次加一,控制器靠它判断要不要重测。
import ctypes
import fcntl
import json
import os
import re
import select
import socket
import struct
import sys
import time

OUT = "/tmp/mwrt-portprobe.json"
LOCK = "/tmp/mwrt-portprobe.lock"
WAIT = 2.5      # 一轮最多等几秒
RESEND = 1.0    # 到这个时刻还没回应就再发一遍(对端偶尔丢第一个广播)
ETH_P_ALL = 0x0003
PACKET_OUTGOING = 4
SO_ATTACH_FILTER = 26

# 0x8863 直接放行;IPv4 + UDP + 非分片 + 源端口 67 放行;其余丢
BPF = [
    (0x28, 0, 0, 12),       # ldh [12]
    (0x15, 8, 0, 0x8863),   # jeq #0x8863      -> 放行
    (0x15, 0, 8, 0x0800),   # jeq #0x0800      否则丢
    (0x30, 0, 0, 23),       # ldb [23]
    (0x15, 0, 6, 17),       # jeq #17(UDP)     否则丢
    (0x28, 0, 0, 20),       # ldh [20]
    (0x45, 4, 0, 0x1fff),   # jset #0x1fff     分片丢
    (0xb1, 0, 0, 14),       # ldxb 4*([14]&0xf)
    (0x48, 0, 0, 14),       # ldh [x+14]       UDP 源端口
    (0x15, 0, 1, 67),       # jeq #67
    (0x06, 0, 0, 0x40000),  # 放行
    (0x06, 0, 0, 0),        # 丢
]


def rd(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return ""


def save(r):
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(r, f)
    os.rename(tmp, OUT)


def csum(b):
    if len(b) % 2:
        b += b"\0"
    s = sum(struct.unpack("!%dH" % (len(b) // 2), b))
    while s >> 16:
        s = (s & 0xffff) + (s >> 16)
    return ~s & 0xffff


def dhcp_discover(mac, xid):
    opts = bytes([53, 1, 1, 55, 4, 1, 3, 6, 54, 255])
    bootp = struct.pack("!BBBBIHH4s4s4s4s16s64s128s", 1, 1, 6, 0, xid, 0, 0,
                        b"", b"", b"", b"", mac, b"", b"")
    bootp = (bootp + b"\x63\x82\x53\x63" + opts).ljust(300, b"\0")
    udp = struct.pack("!HHHH", 68, 67, 8 + len(bootp), 0) + bootp
    ip = struct.pack("!BBHHHBBH4s4s", 0x45, 0, 20 + len(udp), 0, 0, 64, 17, 0,
                     b"\0\0\0\0", b"\xff\xff\xff\xff")
    ip = ip[:10] + struct.pack("!H", csum(ip)) + ip[12:]
    return b"\xff" * 6 + mac + b"\x08\x00" + ip + udp


def padi(mac, uniq):
    tags = struct.pack("!HH", 0x0101, 0) + struct.pack("!HH", 0x0103, len(uniq)) + uniq
    f = b"\xff" * 6 + mac + b"\x88\x63" + struct.pack("!BBHH", 0x11, 0x09, 0, len(tags)) + tags
    return f.ljust(60, b"\0")


def hexmac(b):
    return ":".join("%02x" % x for x in b)


def text(b):
    s = b.decode("utf-8", "replace")
    return re.sub(r"[\x00-\x1f\x7f]", "", s).strip()[:64]


def parse_offer(d, mac, xid):
    ihl = (d[14] & 0x0f) * 4
    bp = d[14 + ihl + 8:]
    if len(bp) < 240 or bp[0] != 2 or struct.unpack("!I", bp[4:8])[0] != xid:
        return None
    if bp[28:34] != mac or bp[236:240] != b"\x63\x82\x53\x63":
        return None
    o, i, n = {}, 240, len(bp)
    while i < n:
        t = bp[i]
        if t == 255:
            break
        if t == 0:
            i += 1
            continue
        if i + 1 >= n:
            break
        ln = bp[i + 1]
        o[t] = bp[i + 2:i + 2 + ln]
        i += 2 + ln
    if o.get(53) != b"\x02":
        return None
    v4 = lambda k: socket.inet_ntoa(o[k][:4]) if len(o.get(k, b"")) >= 4 else ""
    return {"mac": hexmac(d[6:12]), "ip": socket.inet_ntoa(bp[16:20]),
            "mask": v4(1), "gw": v4(3), "srv": v4(54)}


def parse_pado(d, uniq):
    if d[15] != 0x07:
        return None
    ln = struct.unpack("!H", d[18:20])[0]
    tags, i, ok, ac = d[20:20 + ln], 0, False, ""
    while i + 4 <= len(tags):
        t, l = struct.unpack("!HH", tags[i:i + 4])
        v = tags[i + 4:i + 4 + l]
        if t == 0x0103 and v == uniq:
            ok = True
        elif t == 0x0102:
            ac = text(v)
        i += 4 + l
    return {"mac": hexmac(d[6:12]), "ac": ac} if ok else None


def probe(ifn, mac):
    xid = struct.unpack("!I", os.urandom(4))[0]
    uniq = os.urandom(4)
    prog = b"".join(struct.pack("HBBI", *x) for x in BPF)
    buf = ctypes.create_string_buffer(prog)
    s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, 0)
    try:
        # 先挂过滤再绑协议:协议为 0 时什么也不收,不会先进来一堆没过滤的帧
        s.setsockopt(socket.SOL_SOCKET, SO_ATTACH_FILTER,
                     struct.pack("HP", len(BPF), ctypes.addressof(buf)))
        s.bind((ifn, ETH_P_ALL))
        frames = (dhcp_discover(mac, xid), padi(mac, uniq))
        for f in frames:
            s.send(f)
        t0 = time.monotonic()
        resent = False
        dh = pp = None
        while True:
            el = time.monotonic() - t0
            # 两种都回了就收工;只回了一种的,再多等一小会儿看另一种
            if (dh and pp) or el >= WAIT or ((dh or pp) and el >= RESEND + 0.5):
                break
            if not resent and el >= RESEND and not (dh or pp):
                for f in frames:
                    s.send(f)
                resent = True
            if dh or pp:
                nxt = RESEND + 0.5
            elif not resent:
                nxt = RESEND
            else:
                nxt = WAIT
            r, _, _ = select.select([s], [], [], max(0.01, nxt - el))
            if not r:
                continue
            d, a = s.recvfrom(2048)
            if a[2] == PACKET_OUTGOING or len(d) < 20:
                continue
            et = struct.unpack("!H", d[12:14])[0]
            try:
                if et == 0x0800 and not dh:
                    dh = parse_offer(d, mac, xid)
                elif et == 0x8863 and not pp:
                    pp = parse_pado(d, uniq)
            except (IndexError, struct.error, OSError):
                pass
        return dh, pp
    finally:
        s.close()


def main():
    ifn = sys.argv[1] if len(sys.argv) > 1 else ""
    if not re.match(r"^[\w.-]{1,15}$", ifn) or not os.path.isdir("/sys/class/net/" + ifn):
        sys.exit(2)
    lk = open(LOCK, "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)  # 已经有一个在测
    base = "/sys/class/net/%s/" % ifn
    cnt = int(rd(base + "carrier_up_count") or 0)
    prev = {}
    try:
        with open(OUT) as f:
            prev = json.load(f)
    except (OSError, ValueError):
        pass
    tries = prev.get("tries", 0) + 1 if prev.get("if") == ifn and prev.get("cnt") == cnt else 1
    r = {"v": 1, "if": ifn, "cnt": cnt, "tries": tries, "t": int(time.time())}
    save(dict(r, state="probing"))
    if rd(base + "carrier") != "1":
        save(dict(r, state="nolink"))
        return
    try:
        mac = bytes.fromhex(rd(base + "address").replace(":", ""))
        dh, pp = probe(ifn, mac)
    except Exception as e:  # 发不出去/收不了:记下来,控制器过一会儿再试
        save(dict(r, state="error", err=str(e)[:120], t=int(time.time())))
        return
    r["t"] = int(time.time())
    if not (dh or pp):
        save(dict(r, state="none"))
        return
    r.update(state="router", kind="both" if dh and pp else ("dhcp" if dh else "pppoe"),
             mac=(dh or pp)["mac"])
    if dh:
        r.update(gw=dh["gw"] or dh["srv"], srv=dh["srv"], ip=dh["ip"], mask=dh["mask"])
    if pp:
        r["ac"] = pp["ac"]
    save(r)


if __name__ == "__main__":
    main()
