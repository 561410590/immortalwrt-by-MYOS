{%
	include(`themes/${theme}/header`);
-%}

<script src="{{ resource }}/luci.js?v={# PKG_VERSION #}-{{ pkgs_update_time }}-oafmenu1166-{{ theme == 'myos-new' ? '20261114-connection-ui2-wan-quality2' : '20261112-theme-polish1' }}{{ theme == 'myos-new' && join('/', ctx.path ?? []) == 'admin/myos' ? '-home-density1-outlet1-home3-samples2-readout1' : '' }}{% if (join('/', ctx.path ?? []) == 'admin/embedded/simcard'): %}-ultra-sim-r3{% elif (join('/', ctx.path ?? []) == 'admin/network/wireless'): %}-ultra-wifi-apply3{% elif (join('/', ctx.path ?? []) == 'admin/status/overview'): %}-ultra-overview-link1{% elif (join('/', ctx.path ?? []) == 'admin/embedded/phone'): %}-ultra-phone-exp2{% elif (join('/', ctx.path ?? []) == 'admin/system/flash'): %}-ultra-local-keep1166-r2{% elif (join('/', ctx.path ?? []) == 'admin/system/myos_update'): %}-ultra-ota-keep1166{% elif (join('/', ctx.path ?? []) in ['admin/mwrtstore', 'admin/system/package-manager']): %}-ultra-mwrt-store1166-source1{% endif %}{{ theme == 'myos-new' && (join('/', ctx.path ?? []) in ['admin/status/realtime/bandwidth', 'admin/status/logs/syslog', 'admin/network/network', 'admin/network/diagnostics', 'admin/modem/qmodem', 'admin/modem/qmodem/overview']) ? '-submenu1' : '' }}{{ theme == 'myos-new' && !(join('/', ctx.path ?? []) in ['admin/embedded/simcard', 'admin/modem/qmodem/sim_switch']) ? '-views20261120' : '' }}{{ theme == 'myos-new' && (join('/', ctx.path ?? []) in ['admin/myos', 'admin/network/network']) ? '-iface-links1' : '' }}{{ theme == 'myos-new' && join('/', ctx.path ?? []) == 'admin/network/network' ? '-iface-details2' : '' }}{{ theme == 'myos-new' && join('/', ctx.path ?? []) == 'admin/myos' ? '-home-polish2' : '' }}"></script>
<script>
	L = new LuCI({{ replace(`${ {
		media          : media,
		resource       : resource,
		scriptname     : http.getenv("SCRIPT_NAME"),
		pathinfo       : http.getenv("PATH_INFO"),
		documentroot   : http.getenv("DOCUMENT_ROOT"),
		requestpath    : ctx.request_path,
		dispatchpath   : ctx.path,
		pollinterval   : +config.main.pollinterval || 5,
		ubuspath       : config.main.ubuspath || '/ubus/',
		sessionid      : ctx.authsession,
		token          : ctx.authtoken,
		nodespec       : dispatched,
		apply_rollback : max(+config.apply.rollback ||  90, 90),
		apply_holdoff  : max(+config.apply.holdoff  ||   4,  1),
		apply_timeout  : max(+config.apply.timeout  ||   5,  1),
		apply_display  : max(+config.apply.display  || 1.5,  1),
		rollback_token : rollback_token
	} }`, '/', '\\/') }});
</script>
