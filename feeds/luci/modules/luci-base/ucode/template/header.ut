{%
	const myos_board = theme == 'myos-new' ? (ubus.call('system', 'board') ?? {}) : {};
	const myos_model = replace(lc(myos_board.model ?? ''), /[^a-z0-9]/g, '');
	const myos_device = replace(lc(myos_board.board_name ?? ''), /[^a-z0-9]/g, '');
	const myos_compact = myos_model in ['c5800688', 'nradioc5800688', 'c8688', 'nradioc8688',
                           'c8new688', 'nradioc8new688', 'nbcpe688', 'nradionbcpe688', 'nradionb68no2'] ||
                  myos_device in ['nradioc5800688', 'hcmt7981688emmc', 'nradiowt9104no2manpernew688',
                            'hcmt7981emmcnb68', 'nradionbcpe688', 'nradiowt9111no2manpernb68'];
	include(`themes/${theme}/header`);
-%}

<script src="{{ resource }}/luci.js?v={# PKG_VERSION #}-{{ pkgs_update_time }}-{{ theme == 'myos-new' ? '20261114-c8-feedback1-overview-link2-wan-quality2' : '20261112-theme-polish1' }}{{ myos_board.model == 'NRadio-C5800-688' ? (join('/', ctx.path ?? []) == 'admin/myos' ? '-c5800-wan1-c5800-density2-outlet3' : '-c5800-wan1') : (theme == 'myos-new' && join('/', ctx.path ?? []) == 'admin/myos' ? (myos_compact ? '-home-density1-outlet1' : '-home-density1') : '') }}{{ myos_board.model == 'NRadio-C5800-688' && join('/', ctx.path ?? []) == 'admin/network/wireless' ? '-stations2' : '' }}{{ myos_compact && (join('/', ctx.path ?? []) in ['admin/status/realtime/bandwidth', 'admin/status/logs/syslog', 'admin/network/network', 'admin/network/diagnostics']) ? '-submenu1' : '' }}"></script>
<script>
	L = new LuCI({{ replace(`${ {
		media          : media,
		resource       : resource,
		scriptname     : http.getenv("SCRIPT_NAME"),
		pathinfo       : http.getenv("PATH_INFO"),
		documentroot   : http.getenv("DOCUMENT_ROOT"),
		requestpath    : ctx.request_path,
		dispatchpath   : ctx.path,
		pollinterval   : +config.main.pollinterval || 5,
		ubuspath       : config.main.ubuspath || '/ubus/',
		sessionid      : ctx.authsession,
		token          : ctx.authtoken,
		nodespec       : dispatched,
		apply_rollback : max(+config.apply.rollback ||  90, 90),
		apply_holdoff  : max(+config.apply.holdoff  ||   4,  1),
		apply_timeout  : max(+config.apply.timeout  ||   5,  1),
		apply_display  : max(+config.apply.display  || 1.5,  1),
		rollback_token : rollback_token
	} }`, '/', '\\/') }});
</script>
{% if (media == '/luci-static/argon'): %}
<script src="{{ resource }}/mwrt-aurora-boot.js?v=27-wifiqr-support"></script>
<link rel="stylesheet" href="{{ resource }}/mwrt-aurora-full.css?v=21">
<link rel="stylesheet" href="{{ resource }}/mwrt-aurora-chrome.css?v=29-support">
{% endif %}
