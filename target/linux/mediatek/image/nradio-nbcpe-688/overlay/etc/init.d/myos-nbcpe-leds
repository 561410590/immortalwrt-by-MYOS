#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1

start_service() {
    . /lib/functions/system.sh
	[ "$(board_name)" = "HCMT7981-emmc-NB68" ] || return 0
	[ -x /usr/bin/atsd_tools_cli ] || return 0
	# Preserve the original permanent LED-off option after retiring modeminit.
	if [ -f /usr/bin/ledflagc.conf ]; then
		echo 0 > /tmp/ledflag.conf
		local led
		for led in status wifi cmode4 cmode5; do
			[ -w "/sys/class/leds/hc:blue:$led/brightness" ] &&
				echo 0 > "/sys/class/leds/hc:blue:$led/brightness"
		done
	fi
	procd_open_instance
    procd_set_param command /bin/sh /usr/share/modem-AK68/netmodeled-AK68.sh
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
