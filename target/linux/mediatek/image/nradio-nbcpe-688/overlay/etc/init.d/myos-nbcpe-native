#!/bin/sh /etc/rc.common
START=99
STOP=15
USE_PROCD=1

start_service() {
	procd_open_instance at_websocket
	procd_set_param command /usr/bin/python3 /usr/bin/httpapi-AK68.py
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	if [ -s /usr/bin/smstrun-AK68.conf ]; then
		procd_open_instance sms_forward
		procd_set_param command /usr/libexec/myos-nbcpe-sms-forward
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}
