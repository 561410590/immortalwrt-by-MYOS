#!/usr/bin/python3
"""Apply a completed MT5700 settings batch across the ODU link interruption."""
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import time

PENDING = Path("/var/run/myos-nbcpe-radio.pending")
LOCK = "/var/run/myos-nbcpe-radio.lock"


def log(message):
    subprocess.run(["logger", "-t", "nbcpe-radio", message], check=False)


def at(command):
    try:
        result = subprocess.run(
            ["/usr/sbin/atsd_cli", "-i", "cpe", "-c", command, "-w", "2000"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, text=True, timeout=4,
        )
        lines = result.stdout.replace("\r", "").splitlines()
        for index in range(len(lines) - 1, -1, -1):
            if lines[index].strip() == command:
                lines = lines[index:]
                break
        else:
            return "", False
        output = "\n".join(lines)
        return output, (not re.search(r"(?m)^\s*(?:ERROR|\+CME ERROR:|\+CMS ERROR:)", output)
                        and bool(re.search(r"(?m)^\s*OK\s*$", output)))
    except (OSError, subprocess.TimeoutExpired):
        return "", False


def radio_state():
    output, acknowledged = at("AT+CFUN?")
    state = re.search(r"(?m)^\s*\+CFUN:\s*([0-9]+)\s*$", output)
    return int(state[1]) if acknowledged and state else None


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "start":
        if PENDING.exists():
            # netifd kills the setup process group when port5 drops. setsid
            # keeps the matching CFUN=1 alive without restarting any service.
            subprocess.Popen(
                [sys.executable, os.path.abspath(__file__), "run"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, start_new_session=True,
                close_fds=True,
            )
        return 0
    if action not in ("wait", "run"):
        return 2
    with open(LOCK, "a") as lock:
        deadline = time.monotonic() + 45
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if action == "run":
                    return 0
                if time.monotonic() >= deadline:
                    log("Timed out waiting for the active RF settings transaction")
                    return 1
                time.sleep(0.2)
        if action == "wait" or not PENDING.exists():
            return 0
        generation = PENDING.stat().st_mtime_ns
        started = time.monotonic()
        log("Settings written; applying one CFUN=0/1 cycle")
        _, off_ok = at("AT+CFUN=0")
        # Wait for a real CFUN readback across the ODU link interruption.
        # Repeated online commands while atsd reconnects can queue requests.
        # An acknowledged RF-off is followed by at most one online command;
        # a missing command acknowledgement is resolved by state readback.
        deadline = time.monotonic() + 40
        online_requests = 0
        last_request = 0
        while time.monotonic() < deadline:
            state = radio_state()
            if state == 1:
                if off_ok:
                    if PENDING.exists() and PENDING.stat().st_mtime_ns == generation:
                        PENDING.unlink()
                    log("RF settings applied in %.2fs; online requests %d; CFUN readback 1" %
                        (time.monotonic() - started, online_requests))
                    return 0
                log("Online restored, but RF-off was not acknowledged; settings remain pending")
                return 1
            if state == 0 and (online_requests == 0 or
                              time.monotonic() - last_request >= 5):
                if online_requests >= 3:
                    break
                online_requests += 1
                last_request = time.monotonic()
                _, acknowledged = at("AT+CFUN=1")
                log("Online request %d; acknowledged %d" %
                    (online_requests, acknowledged))
                # Never issue another online request after acknowledgement.
                if acknowledged:
                    last_request = deadline
            time.sleep(0.5)
        log("RF online restoration failed; settings remain pending")
        return 1


if __name__ == "__main__":
    sys.exit(main())
