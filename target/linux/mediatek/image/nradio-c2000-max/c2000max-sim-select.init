#!/bin/sh /etc/rc.common

START=97

extra_command "select_sim" "<logical-slot> [mode] select a SIM and redial asynchronously"
extra_command "status_json" "show SIM selection and cellular interface state"
extra_command "restore" "restore the saved SIM route before the native dial command"
SIM_LOCK=/var/run/c2000max-sim-select.lock
SIM_STATE=/var/run/c2000max-sim-select.status.json

save_selection() {
	local cur="$1" mode="$2" slot
	case "$cur" in
		1) slot=simcard1 ;;
		2) slot=simcard2 ;;
		3) slot=esimcard1 ;;
		*) return 1 ;;
	esac
	uci -q set cpesel.sim=cpesel &&
	uci -q set "cpesel.sim.cur=$cur" &&
	uci -q set cpesel.sim.selection_synced=1 || return 1
	[ -z "$mode" ] || uci -q set "cpesel.sim.mode=$mode" || return 1
	uci -q set embed_simcard.general=general &&
	uci -q set "embed_simcard.general.slot=$slot" &&
	uci -q commit embed_simcard && uci -q commit cpesel
}

resolve_target() {
	local mapping="$1" cur="$2" index entry gpio usim
	case "$cur" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$cur" -ge 1 ] || return 1
	index=1
	while [ "$index" -lt "$cur" ]; do
		case "$mapping" in
			*,*) mapping="${mapping#*,}" ;;
			*) return 1 ;;
		esac
		index=$((index + 1))
	done
	entry="${mapping%%,*}"
	case "$entry" in
		*-*) gpio="${entry%%-*}"; usim="${entry#*-}" ;;
		*) return 1 ;;
	esac
	case "$gpio" in ''|*[!01]*) return 1 ;; esac
	case "$usim" in 1|2) ;; *) return 1 ;; esac
	printf '%s %s\n' "$gpio" "$((usim - 1))"
}

pick_modem() {
	local section="$1" state port override path
	[ -z "$modem_section" ] || return
	config_get state "$section" state
	[ "$state" != "disabled" ] || return
	config_get path "$section" path
	[ -n "$path" ] && [ -d "$path" ] || return
	config_get port "$section" at_port
	config_get override "$section" override_at_port
	[ -z "$override" ] || port="$override"
	[ -n "$port" ] && [ -c "$port" ] || return
	modem_section="$section"
	modem_at_port="$port"
}

wait_for_modem() {
	local retries="${1:-45}"
	while [ "$retries" -gt 0 ]; do
		modem_section=
		modem_at_port=
		config_load qmodem
		config_foreach pick_modem modem-device
		[ -z "$modem_section" ] || return 0
		retries=$((retries - 1))
		[ "$retries" -eq 0 ] || sleep 1
	done
	return 1
}

find_gpio_prefix() {
	local prefix default root="${SIM_GPIO_ROOT:-/sys/class/gpio}"
	default="$(uci -q get network.globals.default_cellular 2>/dev/null)"
	for prefix in "$modem_section" "$default" cpe; do
		case "$prefix" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
		[ -w "$root/$prefix-sel0/value" ] || continue
		printf '%s\n' "$prefix"
		return 0
	done
	return 1
}

read_gpio() {
	local prefix="$1" root="${SIM_GPIO_ROOT:-/sys/class/gpio}" index=0 bit value=
	while [ -r "$root/$prefix-sel$index/value" ]; do
		read -r bit < "$root/$prefix-sel$index/value"
		case "$bit" in 0|1) value="$bit$value" ;; *) return 1 ;; esac
		index=$((index + 1))
	done
	printf '%s\n' "$value"
}

write_gpio() {
	local prefix="$1" value="$2" root="${SIM_GPIO_ROOT:-/sys/class/gpio}"
	local index=0 rest bit path
	while [ -n "$value" ]; do
		rest="${value%?}"
		bit="${value#"$rest"}"
		path="$root/$prefix-sel$index/value"
		[ -w "$path" ] || return 1
		printf '%s\n' "$bit" > "$path" || return 1
		value="$rest"
		index=$((index + 1))
	done
}

current_pid() {
	local rest
	read -r own_pid rest < /proc/self/stat
}

lock_alive() {
	local owner
	[ -r "$SIM_LOCK/pid" ] || return 1
	read -r owner < "$SIM_LOCK/pid"
	case "$owner" in ''|*[!0-9]*) return 1 ;; esac
	kill -0 "$owner" 2>/dev/null
}

release_lock() {
	local owner
	current_pid
	read -r owner < "$SIM_LOCK/pid" 2>/dev/null
	[ "$owner" = "$own_pid" ] || return 0
	rm -f "$SIM_LOCK/pid" "$SIM_LOCK/target" "$SIM_LOCK/mode"
	rmdir "$SIM_LOCK" 2>/dev/null
}

reply() {
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string message "$1"
	json_dump
}

set_status() {
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string stage "$1"
	json_add_string message "$2"
	json_add_string target "${selection_cur:-}"
	json_add_string actual "${actual_cur:-}"
	json_add_string physical_slot "${actual_slot:-}"
	json_add_string cpin "${sim_cpin:-}"
	json_add_string modem "${modem_section:-}"
	json_add_int updated "$(date +%s)"
	json_dump > "$SIM_STATE.new" && mv "$SIM_STATE.new" "$SIM_STATE"
}

fail_selection() {
	set_status error "$1"
	logger -t c2000max-sim-select "$1"
	return 1
}

lock_selection() {
	local cur="$1" mode="$2" mapping target held_mode created now
	case "$cur" in 1|2|3) ;; *) reply "无效卡槽"; return 1 ;; esac
	case "$mode" in ''|0|1) ;; *) reply "无效切卡模式"; return 1 ;; esac
	mapping="$(uci -q get cpesel.sim.gval)"
	resolve_target "$mapping" "$cur" >/dev/null || {
		reply "SIM 卡槽映射无效"; return 1
	}
	if ! mkdir "$SIM_LOCK" 2>/dev/null; then
		if lock_alive; then
			read -r target < "$SIM_LOCK/target" 2>/dev/null
			read -r held_mode < "$SIM_LOCK/mode" 2>/dev/null
			if [ "$cur" = "$target" ] && { [ -z "$mode" ] || [ "$mode" = "$held_mode" ]; }; then
				reply "相同切卡任务正在执行"
				return 3
			fi
			reply "正在切换其他卡槽，请等待当前任务完成"
			return 2
		fi
		# Allow the acquiring process time to create its PID file.
		created="$(stat -c %Y "$SIM_LOCK" 2>/dev/null)"
		now="$(date +%s)"
		if [ ! -s "$SIM_LOCK/pid" ] && [ -n "$created" ] && [ "$((now - created))" -lt 3 ]; then
			reply "切卡任务正在启动，请稍后重试"; return 2
		fi
		rm -f "$SIM_LOCK/pid" "$SIM_LOCK/target" "$SIM_LOCK/mode"
		rmdir "$SIM_LOCK" 2>/dev/null
		mkdir "$SIM_LOCK" 2>/dev/null || { reply "切卡任务繁忙"; return 2; }
	fi
	current_pid
	printf '%s\n' "$own_pid" > "$SIM_LOCK/pid"
	printf '%s\n' "$cur" > "$SIM_LOCK/target"
	printf '%s\n' "$mode" > "$SIM_LOCK/mode"
}

status_json() {
	local stage target actual modem busy=0 info interface ip4 ip6 live_cpin live_slot prefix gpio mapping logical vendor platform raw_slot last_message
	. /lib/functions.sh
	. /usr/share/libubox/jshn.sh
	json_init
	[ ! -s "$SIM_STATE" ] || json_load "$(cat "$SIM_STATE")"
	json_get_var stage stage
	json_get_var last_message message
	json_add_string last_action_stage "$stage"
	json_add_string last_action_message "$last_message"
	json_get_var target target
	[ -n "$target" ] || target="$(uci -q get cpesel.sim.cur)"
	json_add_string target "$target"
	lock_alive && busy=1
	if [ "$busy" = 0 ]; then
		modem_section=
		modem_at_port=
		config_load qmodem
		config_foreach pick_modem modem-device
		modem="$modem_section"
		json_add_string modem "$modem"
		if [ -n "$modem" ]; then
			vendor="$(uci -q get "qmodem.$modem.manufacturer")"
			platform="$(uci -q get "qmodem.$modem.platform")"
			info="$(tom_modem -u -t 2 -d "$modem_at_port" -o a -c 'AT+CPIN?' 2>/dev/null)"
			live_cpin="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*+CPIN:[[:space:]]*//p' | tr -d '\r' | head -n 1)"
			case "$vendor:$platform" in
				huawei:hisilicon)
					info="$(tom_modem -u -t 2 -d "$modem_at_port" -o a -c 'AT^SCICHG?' 2>/dev/null)"
					live_slot="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*\^SCICHG:[[:space:]]*\([01]\)[[:space:]]*,.*/\1/p' | head -n 1)"
					;;
				quectel:*)
					info="$(tom_modem -u -t 2 -d "$modem_at_port" -o a -c 'AT+QUIMSLOT?' 2>/dev/null)"
					raw_slot="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*+QUIMSLOT:[[:space:]]*\([12]\).*/\1/p' | head -n 1)"
					case "$raw_slot" in 1|2) live_slot="$((raw_slot - 1))" ;; esac
					;;
				*)
					info="$(/usr/share/qmodem/modem_ctrl.sh get_sim_slot "$modem" 2>/dev/null)"
					raw_slot="$(printf '%s' "$info" | jsonfilter -e '@.sim_slot' 2>/dev/null)"
					case "$vendor" in
						huawei|fibocom) case "$raw_slot" in 0|1) live_slot="$raw_slot" ;; esac ;;
						*) case "$raw_slot" in 1|2) live_slot="$((raw_slot - 1))" ;; esac ;;
					esac
					;;
			esac
			prefix="$(find_gpio_prefix)"
			gpio="$(read_gpio "$prefix")"
			mapping="$(uci -q get cpesel.sim.gval)"
			if [ -n "$live_slot" ] && [ -n "$gpio" ]; then
				for logical in 1 2 3; do
					[ "$(resolve_target "$mapping" "$logical")" != "$gpio $live_slot" ] || actual="$logical"
				done
			fi
		fi
		json_add_string cpin "$live_cpin"
		json_add_string physical_slot "$live_slot"
		json_add_string actual "$actual"
		interface="$(uci -q get "qmodem.$modem.alias")"
		[ -n "$interface" ] || interface="${modem:-2_1}"
		info="$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null)"
		if [ "$(printf '%s' "$info" | jsonfilter -e '@.up')" = true ]; then
			ip4="$(printf '%s' "$info" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
			ip6="$(printf '%s' "$info" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)"
		fi
		info="$(ubus -t 2 call "network.interface.${interface}v6" status 2>/dev/null)"
		if [ -z "$ip6" ] && [ "$(printf '%s' "$info" | jsonfilter -e '@.up')" = true ]; then
			ip6="$(printf '%s' "$info" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)"
		fi
		json_add_string ipv4 "$ip4"
		json_add_string ipv6 "$ip6"
		if [ -n "$ip4$ip6" ]; then
			stage=online
			json_add_string message "蜂窝接口已获取地址"
		elif [ -n "$modem" ]; then
			stage=dialing
			json_add_string message "正在等待蜂窝接口获取地址"
		else
			stage=idle
			json_add_string message "正在读取模组状态"
		fi
		json_add_string stage "$stage"
	fi
	json_add_int updated "$(date +%s)"
	json_add_boolean busy "$busy"
	json_dump
}

at_command() {
	tom_modem -u -t 5 -d "$modem_at_port" -o a -c "$1" 2>/dev/null
}

apply_sim() {
	local cur="$1" mapping target target_gpio target_slot vendor_slot gpio_prefix payload result
	local manufacturer platform operation_failed=0 command_status
	mapping="$(uci -q get cpesel.sim.gval)"
	target="$(resolve_target "$mapping" "$cur")" || { fail_selection "SIM 卡槽映射无效"; return 1; }
	set -- $target
	target_gpio="$1"; target_slot="$2"
	. /lib/functions.sh
	wait_for_modem 1 || { fail_selection "模组 AT 端口尚未出现，原拨号继续运行"; return 1; }
	config_get manufacturer "$modem_section" manufacturer
	config_get platform "$modem_section" platform
	gpio_prefix="$(find_gpio_prefix)" || { fail_selection "SIM 选择 GPIO 不存在"; return 1; }
	vendor_slot="$((target_slot + 1))"
	case "$manufacturer" in huawei|fibocom) vendor_slot="$target_slot" ;; esac
	set_status switching "正在切换目标 SIM"
	selection_started=1
	# Only an explicit selection changes the SIM; replies never gate dialing.
	if [ "$manufacturer:$platform" = huawei:hisilicon ]; then
		result="$(at_command 'AT^HVSST=1,0')"
		logger -t c2000max-sim-select "SIM deactivate: $result"
		case "$result" in *ERROR*) operation_failed=1 ;; esac
	fi
	write_gpio "$gpio_prefix" "$target_gpio" || operation_failed=1
	payload="{\"config_section\":\"$modem_section\",\"slot\":\"$vendor_slot\"}"
	result="$(ubus -t 10 call qmodem set_sim_slot "$payload" 2>/dev/null)"
	command_status=$?
	logger -t c2000max-sim-select "SIM selection response: $result"
	[ "$command_status" -eq 0 ] || operation_failed=1
	case "$result" in *ERROR*) operation_failed=1 ;; esac
	if [ "$manufacturer:$platform" = huawei:hisilicon ]; then
		result="$(at_command 'AT^HVSST=1,1')"
		logger -t c2000max-sim-select "SIM activate: $result"
		case "$result" in *ERROR*) operation_failed=1 ;; esac
		printf '%s\n' "$target_slot" > "/tmp/huawei_sim_slot_$modem_section"
	fi
	result="$(at_command 'AT+CFUN=1')"
	logger -t c2000max-sim-select "SIM online response: $result"
	case "$result" in *ERROR*) operation_failed=1 ;; esac
	if [ "$operation_failed" -ne 0 ]; then
		fail_selection "切卡操作返回错误，拨号继续运行；请查看实际卡槽与日志"
		return 1
	fi
	set_status dialing "切卡命令已发送，实际卡槽与识卡状态以实时读取为准"
	return 0
}

run_selection() {
	local cur="$1" booting="$2" status dial_status
	selection_started=0
	apply_sim "$cur"
	status=$?
	if [ "$booting" != 1 ] && [ "$selection_started" = 1 ]; then
		/etc/init.d/qmodem_network restart >/dev/null 2>&1
		dial_status=$?
		if [ "$dial_status" -ne 0 ]; then
			fail_selection "拨号服务返回错误"
			return "$dial_status"
		fi
	fi
	return "$status"
}

start() {
	local cur status booting="$1"
	cur="$(uci -q get cpesel.sim.cur)"
	[ -n "$cur" ] || cur=1
	lock_selection "$cur" || return 1
	selection_cur="$cur"; actual_cur=; actual_slot=; sim_cpin=
	trap 'release_lock' EXIT
	trap 'fail_selection "切卡任务被中断"; exit 1' INT TERM
	set_status queued "切卡任务已启动"
	if save_selection "$cur"; then
		run_selection "$cur" "$booting"; status=$?
	else
		fail_selection "保存目标卡槽失败"; status=1
	fi
	release_lock
	trap - EXIT INT TERM
	return "$status"
}

restore() {
	local cur mapping target prefix gpio vendor platform info raw_slot live_slot result
	. /lib/functions.sh
	cur="$(uci -q get cpesel.sim.cur)"
	[ -n "$cur" ] || cur=1
	modem_section="$1"
	config_load qmodem
	config_get modem_at_port "$modem_section" at_port
	config_get vendor "$modem_section" manufacturer
	config_get platform "$modem_section" platform
	case "$vendor:$platform" in
		huawei:hisilicon)
			info="$(at_command 'AT^SCICHG?')"
			live_slot="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*\^SCICHG:[[:space:]]*\([01]\)[[:space:]]*,.*/\1/p' | head -n 1)"
			;;
		quectel:*)
			info="$(at_command 'AT+QUIMSLOT?')"
			raw_slot="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*+QUIMSLOT:[[:space:]]*\([12]\).*/\1/p' | head -n 1)"
			case "$raw_slot" in 1|2) live_slot="$((raw_slot - 1))" ;; esac
			;;
		*)
			info="$(/usr/share/qmodem/modem_ctrl.sh get_sim_slot "$modem_section" 2>/dev/null)"
			raw_slot="$(printf '%s' "$info" | jsonfilter -e '@.sim_slot' 2>/dev/null)"
			case "$vendor" in
				huawei|fibocom) live_slot="$raw_slot" ;;
				*) case "$raw_slot" in 1|2) live_slot="$((raw_slot - 1))" ;; esac ;;
			esac
			;;
	esac
	mapping="$(uci -q get cpesel.sim.gval)"
	target="$(resolve_target "$mapping" "$cur")"
	prefix="$(find_gpio_prefix)"
	gpio="$(read_gpio "$prefix")"
	# A matching route does not mean the modem has detected the selected SIM.
	if [ -n "$live_slot" ] && [ "$target" = "$gpio $live_slot" ]; then
		if [ "$vendor:$platform" = huawei:hisilicon ]; then
			result="$(at_command 'AT^HVSST=1,1')"
			logger -t c2000max-sim-select "Saved SIM activate: $result"
		fi
		return 0
	fi
	selection_cur="$cur"
	apply_sim "$cur"
}

boot() {
	local cur mapping target gpio_prefix
	cur="$(uci -q get cpesel.sim.cur)"
	[ -n "$cur" ] || cur=1
	mapping="$(uci -q get cpesel.sim.gval)"
	modem_section=
	# Restore the saved hardware route even when the modem has no AT port yet.
	if target="$(resolve_target "$mapping" "$cur")" && gpio_prefix="$(find_gpio_prefix)"; then
		set -- $target
		write_gpio "$gpio_prefix" "$1" || logger -t c2000max-sim-select "保存的 SIM GPIO 恢复失败"
	fi
	# The native dial path restores the modem channel before its dial command.
	# Do not deactivate the SIM asynchronously after dialing has already started.
}

select_sim() {
	local cur="$1" mode="$2" status worker
	lock_selection "$cur" "$mode"
	status=$?
	[ "$status" != 3 ] || return 0
	[ "$status" = 0 ] || return "$status"
	selection_cur="$cur"; actual_cur=; actual_slot=; sim_cpin=
	save_selection "$cur" "$mode" || {
		fail_selection "保存目标卡槽失败"
		release_lock
		reply "保存目标卡槽失败"; return 1
	}
	set_status queued "切卡任务已提交"
	(
		current_pid
		printf '%s\n' "$own_pid" > "$SIM_LOCK/pid"
		trap 'release_lock' EXIT
		trap 'fail_selection "切卡任务被中断"; exit 1' INT TERM
		run_selection "$cur"
	) </dev/null >/tmp/c2000max-sim-select.log 2>&1 &
	worker=$!
	# The worker owns the lock before the request process exits.
	printf '%s\n' "$worker" > "$SIM_LOCK/pid"
	reply "切卡任务已提交"
	return 0
}
