#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
    local addresses address
    addresses="$(uci -q get network.lan.ipaddr)"
    set -- $addresses
    address="${1%%/*}"
    [ -n "$address" ] || return
    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -p "$address:18083" \
        -h /usr/lib/nros-2.3.9-webui/www -x /cgi-bin -D -S -I index.html
    procd_set_param respawn
    procd_close_instance
}
