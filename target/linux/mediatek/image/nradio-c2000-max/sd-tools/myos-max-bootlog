#!/bin/sh

base=/overlay/myos-boot
[ -d "$base" ] || exit 0

# Keep the latest early-boot snapshot on SD for inspection from the stock OS.
for delay in 0 10 20 30 60 120; do
	[ "$delay" -eq 0 ] || sleep "$delay"
	{
		date
		uptime
		uname -a
		cat /etc/openwrt_release /proc/cmdline /proc/mounts
		df -k /overlay
		/usr/libexec/myos-max-gpt status
		cat /tmp/c2000max-gpt-grow.json /tmp/c2000max-fs-grow.log
		ip link show
		ip address show dev br-lan
		ubus call network.interface.lan status
		netstat -lnt
		dmesg
	} >"$base/current.new" 2>&1
	mv -f "$base/current.new" "$base/current.log" || exit 1
done
