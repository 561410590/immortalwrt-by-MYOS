#!/bin/sh /etc/rc.common

START=12
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'nradio,c2000-max' ] || return 0
	[ -d /overlay/upper ] || return 0
	mkdir -p /overlay/myos-boot || return 0
	[ ! -f /overlay/myos-boot/current.log ] ||
		mv -f /overlay/myos-boot/current.log /overlay/myos-boot/previous.log
	procd_open_instance
	procd_set_param command /usr/libexec/myos-max-bootlog
	procd_close_instance
}
