#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

# Sampling never changes interfaces, acceleration, or filtering rules.

start_service() {
    [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "nradio,c2000-max" ] || return 0
    [ "$(uci -q get appfilter.global.record_enable)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/lua -e '
        local stats = require "luci.model.c2000max_oaf"
        local nixio = require "nixio"
        local last_error
        while true do
            local ok, err = pcall(stats.sample)
            if not ok and tostring(err) ~= last_error then
                nixio.syslog("err", "c2000max-oaf-stats: " .. tostring(err))
            end
            last_error = not ok and tostring(err) or nil
            nixio.nanosleep(3)
        end'
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "appfilter"
}
