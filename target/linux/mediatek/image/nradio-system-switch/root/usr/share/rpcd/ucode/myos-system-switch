'use strict';
import { popen } from 'fs';
function run(action) {
	let p = popen('/usr/libexec/myos-boot-system ' + action + ' 2>/dev/null', 'r');
	if (!p) return { error: '系统切换服务不可用' };
	let output = p.read('all'); p.close();
	try { return json(output); } catch (e) { return { error: '系统切换服务返回异常' }; }
}
return {
	'myos.system': {
		status: { call: function() { return run('status'); } },
		official: { args: { confirmed: false }, call: function(req) {
			if (req.args.confirmed !== true) return { error: '请确认返回官方系统并重启' };
			return run('official');
		} }
	}
};
