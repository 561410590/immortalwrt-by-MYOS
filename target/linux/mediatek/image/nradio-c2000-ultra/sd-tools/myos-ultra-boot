#!/bin/sh
case "$1" in
 status|stock) action="$1" ;;
 *) printf '%s\n' '{"ok":false,"error":"invalid_action"}'; exit 1 ;;
esac
state="$(/usr/libexec/myos-ultra-gpt status)" || { printf '%s\n' "$state"; exit 1; }
layout="$(printf '%s' "$state" | jsonfilter -e '@.layout')"
if [ "$action" = status ]; then
	printf '%s\n' "$state"
	exit 0
fi
if [ "$layout" = official ]; then
	/usr/libexec/myos-ultra-ubenv -o 0 -s boot_from_sd -v 0 >/dev/null || exit 1
	mode="$(/usr/libexec/myos-ultra-ubenv -o 1 -s boot_from_sd)" || exit 1
	printf '%s' "$mode" | grep -q 'boot_from_sd = 0' || exit 1
	result='{"ok":true,"changed":true,"mode":"stock"}'
else
	result="$(/usr/libexec/myos-ultra-gpt "$action")"
	[ "$?" = 0 ] || { printf '%s\n' "$result"; exit 1; }
fi
status=$?
printf '%s\n' "$result"
if [ "$status" = 0 ] && [ "$action" = stock ]; then
 sync
 (sleep 5; /sbin/reboot) </dev/null >/dev/null 2>&1 &
fi
exit "$status"


