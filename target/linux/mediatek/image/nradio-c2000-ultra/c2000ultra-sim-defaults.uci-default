#!/bin/sh

# UCI cannot create a missing package with set; retain this default on failure.
[ -f /etc/config/cpesel ] || : > /etc/config/cpesel || exit 1

cur="$(uci -q get cpesel.sim.cur)"
slot="$(uci -q get embed_simcard.general.slot)"
# Legacy plugin writes never reached cpesel. Migrate its non-default choice once.
if [ "$(uci -q get cpesel.sim.selection_synced)" != 1 ]; then
	case "$cur:$slot" in
		:esimcard1|1:esimcard1) cur=3 ;;
		:simcard2|1:simcard2) cur=2 ;;
	esac
fi
case "$cur" in 1|2|3) ;; *) cur=1 ;; esac
case "$cur" in
	1) slot=simcard1 ;;
	2) slot=simcard2 ;;
	3) slot=esimcard1 ;;
esac
uci -q set cpesel.sim=cpesel &&
uci -q set cpesel.sim.max=4 &&
uci -q set cpesel.sim.gval=0-2,1-1,1-2 &&
uci -q set cpesel.sim.stype=0,0,4 || exit 1
uci -q get cpesel.sim.mode >/dev/null || uci -q set cpesel.sim.mode=1 || exit 1
uci -q set "cpesel.sim.cur=$cur" || exit 1
uci -q get cpesel.sim.default >/dev/null || uci -q set cpesel.sim.default=1 || exit 1
uci -q set cpesel.sim.selection_synced=1 &&
uci -q set embed_simcard.general=general &&
uci -q set "embed_simcard.general.slot=$slot" &&
uci -q commit embed_simcard &&
uci -q commit cpesel || exit 1
logger -t c2000ultra-sim-select "preserved logical slot $cur; SIM selectors synchronized"
exit 0
