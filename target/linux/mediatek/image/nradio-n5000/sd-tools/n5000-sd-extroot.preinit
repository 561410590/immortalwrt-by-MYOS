#!/bin/sh

N5000_SD_DISK="/dev/mmcblk0"
N5000_SD_PART="/dev/mmcblk0p7"
N5000_SD_MOUNT="/tmp/n5000-extroot"
N5000_SD_TABLE="/tmp/n5000-fdisk"
N5000_SD_FSTAB="/tmp/n5000-extroot-config"
N5000_SD_SYSDEV="/sys/class/block/mmcblk0p7/dev"
N5000_SD_MIN_FREE_SECTORS=524288
N5000_SD_PART_WAIT=20
N5000_SD_ROOTFS_ID="/etc/n5000-rootfs-id"
N5000_SD_OVERLAY_ID=".n5000-overlay-id"
N5000_SD_RESET_REQUEST=".n5000-reset-on-boot"
N5000_SD_GPT_TOOL="/usr/libexec/myos-n5000-gpt"

n5000_sd_log() {
	echo "n5000-extroot: $*" > /dev/kmsg 2>/dev/null || true
}

n5000_sd_board() {
	[ -r /proc/device-tree/compatible ] || return 1
	tr '\000' '\n' < /proc/device-tree/compatible 2>/dev/null |
		grep -qx 'nradio,n5000'
}

n5000_sd_make_partition_node() {
	local dev major minor

	[ -b "$N5000_SD_PART" ] && return 0
	[ -r "$N5000_SD_SYSDEV" ] || return 1
	read -r dev < "$N5000_SD_SYSDEV"
	case "$dev" in
		*:*) ;;
		*) return 1 ;;
	esac
	major="${dev%%:*}"
	minor="${dev#*:}"
	case "$major$minor" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ ! -e "$N5000_SD_PART" ] || return 1
	mknod "$N5000_SD_PART" b "$major" "$minor" 2>/dev/null || return 1
	n5000_sd_log "created p7 node from sysfs ${major}:${minor}"
}

n5000_sd_wait_partition() {
	local count=0
	while [ "$count" -lt "$N5000_SD_PART_WAIT" ]; do
		n5000_sd_make_partition_node && return 0
		sleep 1
		count=$((count + 1))
	done
	n5000_sd_make_partition_node
}

n5000_sd_bind_extroot() {
	# Only publish this override after p7 has passed ownership and mount checks.
	# block extroot otherwise prefers a stale fstab from the p6/F2FS overlay.
	mkdir -p "$N5000_SD_FSTAB/etc/config" || return 1
	cat > "$N5000_SD_FSTAB/etc/config/fstab" <<-EOF || return 1
	config global 'myos_extroot'
		option delay_root '5'
		option check_fs '0'

	config mount 'n5000_extroot'
		option target '/overlay'
		option device '$N5000_SD_PART'
		option fstype 'ext4'
		option options 'rw,noatime'
		option enabled '1'
	EOF
	export MYOS_SD_EXTROOT_CONFIG="$N5000_SD_FSTAB"
}

n5000_sd_grow_extroot() {
	local disk_sectors p7_start p7_size desired
	[ -x "$N5000_SD_GPT_TOOL" ] || return 0
	command -v resize2fs >/dev/null 2>&1 || return 0
	"$N5000_SD_GPT_TOOL" grow >/tmp/n5000-gpt-grow.json 2>&1 || {
		n5000_sd_log "cannot grow GPT p7; preserve existing extroot"
		return 0
	}
	partprobe "$N5000_SD_DISK" >/dev/null 2>&1 || true
	disk_sectors="$(cat /sys/class/block/mmcblk0/size 2>/dev/null)"
	p7_start="$(cat /sys/class/block/mmcblk0p7/start 2>/dev/null)"
	p7_size="$(cat /sys/class/block/mmcblk0p7/size 2>/dev/null)"
	case "$disk_sectors:$p7_start:$p7_size" in
		*[!0-9:]*|:*|*::*|*:) return 0 ;;
	esac
	# GPT last usable LBA is disk_sectors - 34; partition length is inclusive.
	desired=$((disk_sectors - p7_start - 33))
	[ "$p7_size" -eq "$desired" ] || {
		n5000_sd_log "kernel p7 size update pending; retry filesystem growth next boot"
		return 0
	}
	# Resize after the ext4 journal has been replayed by the read-write mount.
	N5000_SD_RESIZE_READY=1
}

n5000_sd_grow_native() {
	local state offset data_bytes fs_bytes grown_bytes fstype loop rc attached
	local loop_tool=/usr/sbin/losetup
	# Run before mount_root: p4 is the SquashFS root, and its overlay is idle.
	"$N5000_SD_GPT_TOOL" grow >/tmp/n5000-gpt-grow.json 2>&1 || {
		n5000_sd_log "p4 GPT growth deferred; see /tmp/n5000-gpt-grow.json"
		return 0
	}
	state="$("$N5000_SD_GPT_TOOL" status)" || return 0
	offset="$(jsonfilter -s "$state" -e '@.rootfs_data_offset')"
	data_bytes="$(jsonfilter -s "$state" -e '@.rootfs_data_bytes')"
	fs_bytes="$(jsonfilter -s "$state" -e '@.filesystem_bytes')"
	fstype="$(jsonfilter -s "$state" -e '@.filesystem')"
	case "$offset:$data_bytes:$fs_bytes" in
		*[!0-9:]*|:*|*::*|*:) return 0 ;;
	esac
	[ "$offset" -gt 0 ] && [ "$fs_bytes" -gt 0 ] || return 0
	# F2FS grows in segments. Ignore the normal sub-segment trailing gap.
	[ "$data_bytes" -ge "$fs_bytes" ] &&
		[ "$((data_bytes - fs_bytes))" -ge 2097152 ] || return 0
	case "$fstype" in
		f2fs) command -v resize.f2fs >/dev/null 2>&1 || return 0 ;;
		ext4) command -v resize2fs >/dev/null 2>&1 || return 0 ;;
		*) return 0 ;;
	esac
	# Never resize an overlay that another preinit hook has already attached.
	attached="$("$loop_tool" -j /dev/mmcblk0p4)" || return 0
	[ -z "$attached" ] || {
		n5000_sd_log "p4 loop already attached; defer filesystem growth"
		return 0
	}
	loop="$("$loop_tool" -f)" || return 0
	"$loop_tool" -o "$offset" "$loop" /dev/mmcblk0p4 || return 0
	rc=0
	case "$fstype" in
		f2fs)
			fsck.f2fs -p 1 "$loop" >/tmp/n5000-fs-grow.log 2>&1 || rc=$?
			if [ "$rc" -le 1 ]; then
				resize.f2fs "$loop" >>/tmp/n5000-fs-grow.log 2>&1
				rc=$?
			fi
			;;
		ext4)
			e2fsck -p "$loop" >/tmp/n5000-fs-grow.log 2>&1 || rc=$?
			if [ "$rc" -le 1 ]; then
				resize2fs "$loop" >>/tmp/n5000-fs-grow.log 2>&1
				rc=$?
			fi
			;;
	esac
	"$loop_tool" -d "$loop" || n5000_sd_log "cannot release growth loop $loop"
	if [ "$rc" -eq 0 ]; then
		state="$("$N5000_SD_GPT_TOOL" status)"
		grown_bytes="$(jsonfilter -s "$state" -e '@.filesystem_bytes')"
		case "$grown_bytes" in ''|*[!0-9]*) grown_bytes=0 ;; esac
		[ "$grown_bytes" -gt 0 ] && [ "$grown_bytes" -le "$data_bytes" ] &&
			[ "$((data_bytes - grown_bytes))" -lt 2097152 ] || rc=1
	fi
	if [ "$rc" -eq 0 ]; then
		n5000_sd_log "p4 $fstype growth completed; mount_root will attach overlay"
	else
		n5000_sd_log "p4 $fstype growth returned $rc; see /tmp/n5000-fs-grow.log"
	fi
}

n5000_sd_prepare_extroot() {
	local disk_sectors p6_end p7_start start free_sectors
	local fstype probe_status created=0 new_fs=0 owned=0 reset_requested=0
	local cleanup_requested=0 rootfs_id applied_overlay_id cleanup_reason

	n5000_sd_board || return 0
	[ -b "$N5000_SD_DISK" ] || return 0
	# The official formatter assigns p1 to official storage and p4 to the
	# second system. rootdisk/fstools uses all of p4 after the SquashFS offset;
	# no separate p7 or fixed card capacity belongs to this layout.
	if [ -x "$N5000_SD_GPT_TOOL" ] &&
		"$N5000_SD_GPT_TOOL" status | grep -q '"layout":"official"'; then
		n5000_sd_grow_native
		n5000_sd_log "official SD layout: use dynamic p4 rootfs_data"
		return 0
	fi
	[ -r "$N5000_SD_ROOTFS_ID" ] || {
		n5000_sd_log "missing ROM rootfs ID; preserve p7 and skip"
		return 0
	}
	IFS= read -r rootfs_id < "$N5000_SD_ROOTFS_ID"
	case "$rootfs_id" in
		''|*[!A-Za-z0-9._-]*)
			n5000_sd_log "invalid ROM rootfs ID; preserve p7 and skip"
			return 0
			;;
	esac
	for command in fdisk partprobe blkid mkfs.ext4 mount umount mknod awk grep tr \
		dd cp rm rmdir mkdir mv sync sleep; do
		command -v "$command" >/dev/null 2>&1 || {
			n5000_sd_log "missing command: $command"
			return 0
		}
	done

	disk_sectors="$(cat /sys/class/block/mmcblk0/size 2>/dev/null)"
	case "$disk_sectors" in
		''|*[!0-9]*) return 0 ;;
	esac
	fdisk -l "$N5000_SD_DISK" > "$N5000_SD_TABLE" 2>/dev/null || {
		n5000_sd_log "cannot read GPT"
		return 0
	}
	awk -v d="$N5000_SD_DISK" '
		$1 == "Disk" && $2 == "identifier:" && $3 == "5452574F-2211-4433-5566-778899AABB00" { guid=1 }
		$1 == d "p1" && $2 == 34 && $3 == 8191 { p1=1 }
		$1 == d "p2" && $2 == 8192 && $3 == 9215 { p2=1 }
		$1 == d "p3" && $2 == 9216 && $3 == 17407 { p3=1 }
		$1 == d "p4" && $2 == 17408 && $3 == 21503 { p4=1 }
		$1 == d "p5" && $2 == 21504 && $3 == 87039 { p5=1 }
		$1 == d "p6" && $2 == 87040 && $3 == 213119 { p6=1 }
		END { exit !(guid && p1 && p2 && p3 && p4 && p5 && p6) }
	' "$N5000_SD_TABLE" || {
		n5000_sd_log "unexpected GPT identity or p1-p6 layout"
		return 0
	}
	p6_end=213119

	p7_start="$(awk -v p="$N5000_SD_PART" '$1 == p { print $2; exit }' "$N5000_SD_TABLE")"
	if [ -z "$p7_start" ] && [ -r /sys/class/block/mmcblk0p7/start ]; then
		p7_start="$(cat /sys/class/block/mmcblk0p7/start 2>/dev/null)"
	fi
	if [ -n "$p7_start" ]; then
		[ "$p7_start" -gt "$p6_end" ] 2>/dev/null || {
			n5000_sd_log "p7 overlaps p6; skip"
			return 0
		}
		if [ ! -b "$N5000_SD_PART" ]; then
			printf 'w\n' | fdisk "$N5000_SD_DISK" >/dev/null 2>&1 || return 0
			partprobe "$N5000_SD_DISK" >/dev/null 2>&1 || true
		fi
	else
		start=$(( (p6_end + 2048) / 2048 * 2048 ))
		free_sectors=$((disk_sectors - start - 34))
		[ "$free_sectors" -ge "$N5000_SD_MIN_FREE_SECTORS" ] || {
			n5000_sd_log "less than 256 MiB free; keep p6 overlay"
			return 0
		}
		printf 'n\n7\n%s\n\nw\n' "$start" | fdisk "$N5000_SD_DISK" >/dev/null 2>&1 || {
			n5000_sd_log "cannot create p7"
			return 0
		}
		created=1
		partprobe "$N5000_SD_DISK" >/dev/null 2>&1 || true
	fi

	n5000_sd_wait_partition || {
		n5000_sd_log "p7 node did not appear"
		return 0
	}
	fstype="$(blkid -s TYPE -o value "$N5000_SD_PART" 2>/dev/null)"
	if [ -z "$fstype" ]; then
		# Ignore parent GPT PART_ENTRY_* details; keep filesystem/table probing.
		probe_status=0
		blkid -p -D "$N5000_SD_PART" >/tmp/n5000-p7-probe.log 2>&1 || probe_status=$?
		if [ "$probe_status" != 2 ] || [ -s /tmp/n5000-p7-probe.log ]; then
			n5000_sd_log "p7 probe is not blank; preserve and skip"
			return 0
		fi
		if [ "$created" != 1 ]; then
			# Recover the retained, uninitialized MYOS p7 left by an earlier image.
			[ "$p7_start" = 215040 ] && [ -x "$N5000_SD_GPT_TOOL" ] &&
				"$N5000_SD_GPT_TOOL" grow >/tmp/n5000-gpt-grow.json 2>&1 || {
				n5000_sd_log "cannot validate retained unformatted p7; preserve and skip"
				return 0
			}
			partprobe "$N5000_SD_DISK" >/dev/null 2>&1 || true
			n5000_sd_log "initializing existing unformatted p7"
		fi
		mkfs.ext4 -F -L data "$N5000_SD_PART" >/dev/null 2>&1 || {
			n5000_sd_log "cannot initialize unformatted p7"
			return 0
		}
		fstype=ext4
		new_fs=1
	fi
	[ "$fstype" = ext4 ] || {
		n5000_sd_log "p7 is ${fstype:-unformatted}; preserve and skip"
		return 0
	}

	umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
	rmdir "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
	mkdir -p "$N5000_SD_MOUNT" || return 0
	if [ "$new_fs" = 1 ]; then
		owned=1
	else
		mount -t ext4 -o ro,noload "$N5000_SD_PART" "$N5000_SD_MOUNT" || {
			n5000_sd_log "cannot inspect existing p7"
			return 0
		}
		if [ -f "$N5000_SD_MOUNT/$N5000_SD_RESET_REQUEST" ]; then
			reset_requested=1
			owned=1
		fi
		if [ -f "$N5000_SD_MOUNT/.myos-extroot" ] || \
			[ -f "$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID" ] || \
			[ -f "$N5000_SD_MOUNT/.n5000-reset-rootfs-id" ] || \
			{ [ -d "$N5000_SD_MOUNT/upper" ] && [ -d "$N5000_SD_MOUNT/work" ]; }; then
			owned=1
		fi
		if [ "$owned" = 1 ]; then
			applied_overlay_id=
			[ ! -f "$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID" ] || \
				IFS= read -r applied_overlay_id < \
					"$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID"
			if [ "$reset_requested" = 1 ]; then
				cleanup_requested=1
				cleanup_reason="firstboot reset requested"
			elif [ "$applied_overlay_id" != "$rootfs_id" ]; then
				cleanup_requested=1
				cleanup_reason="firmware changed"
			fi
		fi
		umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || return 0
	fi
	[ "$owned" = 1 ] || {
		rmdir "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
		n5000_sd_log "existing p7 is not a MYOS extroot; preserve and skip"
		return 0
	}
	N5000_SD_RESIZE_READY=0
	n5000_sd_grow_extroot
	mount -t ext4 -o rw,noatime "$N5000_SD_PART" "$N5000_SD_MOUNT" || {
		n5000_sd_log "cannot mount p7 read-write"
		return 0
	}
	if [ "$N5000_SD_RESIZE_READY" = 1 ]; then
		resize2fs "$N5000_SD_PART" >/tmp/n5000-resize2fs.log 2>&1 ||
			n5000_sd_log "filesystem resize deferred; keep mounted extroot"
	fi
	if [ -x "$N5000_SD_GPT_TOOL" ]; then
		mkdir -p "$N5000_SD_MOUNT/myos-recovery"
		cp "$N5000_SD_GPT_TOOL" /usr/share/myos-n5000-sd/return-myos.sh \
			/usr/share/myos-n5000-sd/recovery-README.txt \
			"$N5000_SD_MOUNT/myos-recovery/" &&
			chmod 0755 "$N5000_SD_MOUNT/myos-recovery/myos-n5000-gpt" \
				"$N5000_SD_MOUNT/myos-recovery/return-myos.sh"
	fi
	if [ "$cleanup_requested" = 1 ]; then
		# Carry only sysupgrade configuration across a deliberate online update.
		# Stage it before the old overlay is removed; 80_mount_root restores it.
		local restore_version= restore_staged=0
		if [ "$reset_requested" != 1 ] && \
			[ -r "$N5000_SD_MOUNT/.myos-update-restore" ] && \
			[ -s "$N5000_SD_MOUNT/myos-update-config.tgz" ]; then
			IFS= read -r restore_version < "$N5000_SD_MOUNT/.myos-update-restore"
			case "${rootfs_id#V}" in
				"${restore_version#V}"-*)
					if gzip -t "$N5000_SD_MOUNT/myos-update-config.tgz" && \
						gzip -dc "$N5000_SD_MOUNT/myos-update-config.tgz" > /tmp/sysupgrade.tar; then
						chmod 0600 /tmp/sysupgrade.tar
						restore_staged=1
					else
						rm -f /tmp/sysupgrade.tar
						n5000_sd_log "online update configuration archive invalid; preserve old overlay"
						umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
						return 0
					fi
					;;
			esac
		fi
		n5000_sd_log "$cleanup_reason; resetting system overlay without formatting p7"
		# A missing ID makes an interrupted reset repeat on the next boot.
		rm -f "$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID" \
			"$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID.new" || {
			n5000_sd_log "cannot invalidate old p7 overlay ID"
			umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
			return 0
		}
		sync
		rm -rf "$N5000_SD_MOUNT/upper" \
			"$N5000_SD_MOUNT/work" \
			"$N5000_SD_MOUNT/etc" || {
			n5000_sd_log "cannot remove old system overlay"
			umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
			return 0
		}
	fi
	mkdir -p "$N5000_SD_MOUNT/upper" "$N5000_SD_MOUNT/work" \
		"$N5000_SD_MOUNT/etc" || {
		n5000_sd_log "cannot create clean system overlay"
		umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
		return 0
	}
	[ -f "$N5000_SD_MOUNT/.myos-extroot" ] || \
		printf '%s\n' 'format=1' 'board=nradio,n5000' > \
			"$N5000_SD_MOUNT/.myos-extroot" || {
			n5000_sd_log "cannot write p7 ownership marker"
			umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
			return 0
		}
	if [ "$new_fs" = 1 ] || [ "$cleanup_requested" = 1 ]; then
		rm -f "$N5000_SD_MOUNT/$N5000_SD_RESET_REQUEST" \
			"$N5000_SD_MOUNT/.n5000-reset-generation" \
			"$N5000_SD_MOUNT/.n5000-reset-rootfs-id" \
			"$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID.new" || {
			n5000_sd_log "cannot remove old p7 reset markers"
			umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
			return 0
		}
		# Commit the new ID only after the clean overlay is durable.
		sync
		printf '%s\n' "$rootfs_id" > \
			"$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID.new" || {
			n5000_sd_log "cannot stage p7 overlay ID"
			umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
			return 0
		}
		sync
		mv -f "$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID.new" \
			"$N5000_SD_MOUNT/$N5000_SD_OVERLAY_ID" || {
			n5000_sd_log "cannot commit p7 overlay ID"
			umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || true
			return 0
		}
		if [ "${restore_staged:-0}" = 1 ]; then
			rm -f "$N5000_SD_MOUNT/.myos-update-restore" \
				"$N5000_SD_MOUNT/myos-update-config.tgz"
		fi
		sync
	fi
	# Managed p7 must survive the new squashfs UUID generated by each reflash.
	rm -f "$N5000_SD_MOUNT/etc/.extroot-default" "$N5000_SD_MOUNT/etc/.extroot-uuid"
	umount "$N5000_SD_MOUNT" >/dev/null 2>&1 || {
		n5000_sd_log "cannot unmount p7 preparation mount"
		return 0
	}
	rmdir "$N5000_SD_MOUNT" >/dev/null 2>&1 || true

	n5000_sd_bind_extroot || {
		n5000_sd_log "cannot prepare managed extroot fstab"
		return 0
	}
	n5000_sd_log "p7 prepared; requesting managed extroot"
}

boot_hook_add preinit_main n5000_sd_prepare_extroot
