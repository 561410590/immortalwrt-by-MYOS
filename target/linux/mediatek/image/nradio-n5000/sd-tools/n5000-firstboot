#!/bin/sh

board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"

if [ "$board" = 'nradio,n5000' ] && \
	grep -qs '^/dev/mmcblk0p7 /overlay ' /proc/mounts; then
	confirmed=0
	for arg in "$@"; do
		[ "$arg" = '-y' ] && confirmed=1
	done
	[ "$confirmed" = 1 ] || {
		echo 'N5000 SD extroot reset requires: firstboot -y' >&2
		exit 1
	}

	touch /overlay/.n5000-reset-on-boot || exit 1
	sync
	echo 'N5000 system overlay will be reset during next boot; p7 will be preserved.'
	exit 0
fi

exec /sbin/jffs2reset "$@"

