#!/usr/bin/lua

local mosq = require "mosquitto"
local ok_json, cjson = pcall(require, "cjson.safe")
if not ok_json then cjson = require "cjson" end
local uci = require "luci.model.uci".cursor()
local util = require "luci.util"
local shared = require "myos_nradio_data"
local app_session = require "myos_nradio_app_session"
local ssh_authorization = require "myos_nradio_ssh_authorization"

local ID, client, last_status, last_presence = nil, nil, 0, 0
local bridge_online = false
local local_broker_online = false
local connection_topic = ""
local cache = { t = 0, data = nil }
local shared_cache_file = "/tmp/myos-nradio-app-summary.json"
local cloud_state_file = "/tmp/myos-nros-cloud-state.json"
local summary_cache_ttl = 120
local online_interval = 180
local presence_interval = 10
local last_state_write = 0
local ok_nixio, nixio = pcall(require, "nixio")
local ok_nixiofs, nixiofs = pcall(require, "nixio.fs")
local mode = (arg and arg[1]) or "status"
local mqtt_loop_timeout_ms = 5000
local mqtt_loop_packets = 10

local function write_cloud_state(now)
	if mode == "command" then return end
	now = tonumber(now) or os.time()
	local ok, payload = pcall(cjson.encode, {
		updated = now,
		local_broker_online = local_broker_online,
		bridge_online = bridge_online
	})
	if not ok or not payload then return end
	local tmp = cloud_state_file .. ".tmp"
	local f = io.open(tmp, "w")
	if not f then return end
	f:write(payload)
	f:close()
	if os.rename(tmp, cloud_state_file) then last_state_write = now end
end

local function idle_sleep(sec)
	if ok_nixio and nixio and nixio.nanosleep then
		local seconds = math.floor(tonumber(sec) or 0)
		local nanoseconds = math.floor(((tonumber(sec) or 0) - seconds) * 1000000000)
		nixio.nanosleep(seconds, nanoseconds)
	else
		os.execute("sleep " .. tostring(sec))
	end
end

local function response_timestamp()
	if ok_nixio and nixio and type(nixio.gettimeofday) == "function" then
		local ok, seconds, microseconds = pcall(nixio.gettimeofday)
		seconds = ok and tonumber(seconds) or nil
		if seconds then
			local value = string.format("%d.%06d", math.floor(seconds),
				math.floor(tonumber(microseconds) or 0)):gsub("0+$", "")
			return value:sub(-1) == "." and (value .. "0") or value
		end
	end
	return tostring(os.time()) .. ".000001"
end

local function cloud_enabled()
	uci:load("myos_nros")
	return tostring(uci:get("myos_nros", "main", "enabled") or "0") == "1"
end

local function remote_enabled(service)
	uci:load("myos_nros")
	local option = service == "rweb" and "remote_web_enabled" or
		(service == "rssh" and "remote_ssh_enabled" or nil)
	return option ~= nil and tostring(uci:get("myos_nros", "main", "enabled") or "0") == "1" and
		tostring(uci:get("myos_nros", "main", option) or "1") ~= "0"
end

local function write_shared_summary(now, data)
	local tmp = shared_cache_file .. ".tmp"
	local f = io.open(tmp, "w")
	if not f then return end
	f:write(cjson.encode({ t = now, data = data }) or "{}")
	f:close()
	os.rename(tmp, shared_cache_file)
end

local function trim(v)
	return (tostring(v or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function read1(path)
	local f = io.open(path, "r")
	if not f then return "" end
	local v = trim(f:read("*l") or "")
	f:close()
	return v
end

local function valid_mac(v)
	return tostring(v or ""):match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") ~= nil
end

local function normalize_mac(v)
	local mac = trim(v):gsub(":", ""):upper()
	mac = mac:gsub("%-MYOS$", "")
	if mac:match("^%x%x%x%x%x%x%x%x%x%x%x%x$") then
		return mac:gsub("(%x%x)", "%1:"):sub(1, 17)
	end
	return trim(v):upper()
end

local function placeholder_mac(mac)
	mac = normalize_mac(mac)
	return mac == "" or mac == "00:00:00:00:00:00" or mac == "FF:FF:FF:FF:FF:FF" or mac == "00:66:88:00:00:00"
end

local function valid_identity_mac(mac)
	return valid_mac(mac) and not placeholder_mac(mac)
end

local function identity_from_blob(path, key)
	local f = io.open(path, "rb")
	if not f then return "" end
	local data = f:read(65536) or ""
	f:close()
	for entry in data:gmatch("[^%z\r\n]+") do
		local k, v = entry:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
		if k == key then return trim(v) end
	end
	return ""
end

local function bd_dev()
	local f = io.open("/proc/mtd", "r")
	if f then
		for line in f:lines() do
			local dev = line:match("^(mtd%d+):")
			local name = line:match('"(.-)"')
			if dev and name and (name:match("bdinfo") or name:match("oeminfo")) then f:close(); return "/dev/" .. dev end
		end
		f:close()
	end
	local p = io.popen("blkid -t PARTLABEL=bdinfo -o device 2>/dev/null")
	if p then local dev = trim(p:read("*l") or ""); p:close(); if dev ~= "" then return dev end end
	p = io.popen("[ -e /dev/disk/by-partlabel/bdinfo ] && readlink -f /dev/disk/by-partlabel/bdinfo 2>/dev/null")
	if p then local dev = trim(p:read("*l") or ""); p:close(); if dev ~= "" then return dev end end
	return nil
end

local function identity_get(key)
	for _, path in ipairs({"/mnt/app_data/bdinfo", "/etc/bdinfo.bin", "/bdinfo/bdinfo.bin"}) do
		local v = identity_from_blob(path, key)
		if v ~= "" then return v end
	end
	local dev = bd_dev()
	if dev then
		local v = identity_from_blob(dev, key)
		if v ~= "" then return v end
	end
	for _, path in ipairs({"/etc/nradio/identity", "/boot/nradio-identity"}) do
		local v = identity_from_blob(path, key)
		if v ~= "" then return v end
	end
	return ""
end

local function device_id()
	if shared then return shared.device_id() end
	local mac = normalize_mac(identity_get("fac_mac"))
	if not valid_identity_mac(mac) then mac = normalize_mac(identity_get("mac")) end
	if not valid_identity_mac(mac) then mac = normalize_mac(uci:get("oem", "board", "id") or "") end
	if not valid_identity_mac(mac) then mac = normalize_mac(uci:get("mosquitto", "bridge", "remote_clientid") or "") end
	if not valid_identity_mac(mac) then return "" end
	return (mac:gsub(":", ""):upper())
end

local function device_code()
	if shared then return shared.device_code() end
	local code = identity_get("device_code")
	if code ~= "" then return code end
	code = trim(uci:get("oem", "board", "device_code") or "")
	if code ~= "" then return code end
	return ""
end

local function ubus(path, method, data)
	local ok, res = pcall(util.ubus, path, method, data or {})
	if ok and type(res) == "table" then return res end
	return {}
end

local function stats(dev)
	dev = trim(dev)
	if dev == "" or not dev:match("^[%w_.:%-]+$") then return "0", "0" end
	local rx = tonumber(read1("/sys/class/net/" .. dev .. "/statistics/rx_bytes")) or 0
	local tx = tonumber(read1("/sys/class/net/" .. dev .. "/statistics/tx_bytes")) or 0
	return tostring(tx), tostring(rx)
end

local function summary() return shared.summary() end

local function wifistatus()
	pcall(function() uci:load("wireless") end)
	local list, idx = {}, 0
	uci:foreach("wireless", "wifi-iface", function(s)
		idx = idx + 1
		local dev = s.device or ""
		local device_band = tostring(uci:get("wireless", dev, "band") or ""):lower()
		local band = device_band:find("5", 1, true) and 1 or 0
		local disabled = s.disabled or uci:get("wireless", dev, "disabled") or "0"
		list[#list + 1] = {
			ssid = s.ssid or "",
			password = s.key or "",
			rule_name = "wlan" .. tostring(idx - 1),
			ruleName = "wlan" .. tostring(idx - 1),
			band = band,
			dbsc = "0",
			hidden = s.hidden or "0",
			encryption = s.encryption or "none",
			channel = uci:get("wireless", dev, "channel") or "auto",
			disabled = disabled,
			max_link = tonumber(s.maxassoc or s.max_inactivity or 0) or 0
		}
	end)
	if #list == 0 then list[1] = {} end
	return { list = require("luci.controller.nradio.app").wifi_app_list(list) }
end

local function radio_status()
	pcall(function() uci:load("wireless") end)
	local radio = {}
	local count = {
		band2 = 0,
		band5 = 0,
		phy2 = 0,
		phy5 = 0,
		chlist = {},
		skip_channels = {},
		bwlist = {}
	}
	local index = 0
	uci:foreach("wireless", "wifi-iface", function(s)
		if tostring(s.mode or "ap") ~= "ap" then return end
		index = index + 1
		local device = tostring(s.device or "")
		local band = tostring(uci:get("wireless", device, "band") or
			uci:get("wireless", device, "hwmode") or ""):lower()
		local band5 = band:find("5", 1, true) ~= nil or
			device:lower():find("5g", 1, true) ~= nil or
			tostring(s.ssid or ""):lower():find("5g", 1, true) ~= nil or
			index > 1
		local frequency = band5 and "5G" or "2.4G"
		count[band5 and "band5" or "band2"] =
			count[band5 and "band5" or "band2"] + 1
		count[band5 and "phy5" or "phy2"] =
			count[band5 and "phy5" or "phy2"] + 1
		radio[#radio + 1] = {
			name = s[".name"] or ("wlan" .. tostring(index - 1)),
			ssid = s.ssid or "",
			channel = uci:get("wireless", device, "channel") or "auto",
			frequency = frequency,
			assoclist = {}
		}
	end)
	return radio, count
end

local previous_cpu_total, previous_cpu_idle

local function cpu_counters()
	local line = read1("/proc/stat")
	if not line:match("^cpu%s") then return nil end
	local values = {}
	for value in line:gmatch("%d+") do values[#values + 1] = tonumber(value) or 0 end
	if #values < 4 then return nil end
	local total = 0
	for index = 1, math.min(#values, 8) do total = total + values[index] end
	return total, values[4] + (values[5] or 0)
end

local function cpu_percent()
	local total, idle = cpu_counters()
	if not total then return 0 end
	if not previous_cpu_total or total <= previous_cpu_total then
		previous_cpu_total, previous_cpu_idle = total, idle
		idle_sleep(0.1)
		total, idle = cpu_counters()
		if not total then return 0 end
	end
	local elapsed = total - previous_cpu_total
	local idle_elapsed = idle - previous_cpu_idle
	previous_cpu_total, previous_cpu_idle = total, idle
	if elapsed <= 0 then return 0 end
	local percent = math.floor(((elapsed - idle_elapsed) * 100 / elapsed) + 0.5)
	if percent < 0 then return 0 end
	if percent > 100 then return 100 end
	return percent
end

local function runtime() return {result=shared.runtime()} end

local function diagnosis()
 local m=summary()
 return {netlink=m.up and 1 or 0}
end

local function basic_info()
	return {
		version = shared.app_software_version(),
