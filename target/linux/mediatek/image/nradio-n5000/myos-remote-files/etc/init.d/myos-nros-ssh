#!/bin/sh /etc/rc.common

USE_PROCD=1
START=31
STOP=69

# On-demand endpoint for the official reverse SSH tunnel.
# The normal LAN Dropbear configuration remains managed by OpenWrt.
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dropbear -F -E -R \
		-P /var/run/myos-nros-ssh.pid -p 127.0.0.1:22
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
