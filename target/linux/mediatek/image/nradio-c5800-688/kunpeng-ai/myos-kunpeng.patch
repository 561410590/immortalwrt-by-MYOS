+local function reply(result)
+	http.prepare_content("application/json")
+	http.write_json({result = result})
+end
+
+local function preview_catalog(provider, uri, key)
+	local path = util.exec("mktemp -d /tmp/myos-ai-catalog.XXXXXX"):match("^(/tmp/myos%-ai%-catalog%.%w+)\n?$")
+	if not path then
+		return nil
+	end
+
+	local dir = util.shellquote(path)
+	local alias = provider .. "." .. providers_alias
+	local field = "providers.models." .. alias
+	local create = "/usr/bin/zeroclaw providers create --config-dir " .. dir
+	local set = "/usr/bin/zeroclaw config set --config-dir " .. dir .. " --no-interactive "
+	local commands = {create .. " models " .. util.shellquote(provider) .. " " .. providers_alias .. " >/dev/null 2>&1"}
+	if uri ~= "" then
+		commands[#commands + 1] = set .. field .. ".uri " .. util.shellquote(uri) .. " >/dev/null 2>&1"
+	end
+	if key ~= "" then
+		commands[#commands + 1] = set .. field .. ".api_key " .. util.shellquote(key) .. " >/dev/null 2>&1"
+	end
+	commands[#commands + 1] = "timeout 15 /usr/bin/zeroclaw models preview --config-dir " .. dir ..
+		" --model-provider " .. util.shellquote(alias) .. " --json 2>/dev/null"
+	local output = util.exec(table.concat(commands, " && "))
+	util.exec("rm -rf -- " .. dir)
+	return require("cjson.safe").decode(output)
 end
 
