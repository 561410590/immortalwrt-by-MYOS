# IPv4 LAN policy. Tables 33/34 leave native health-check tables 1/24 intact.
config globals 'globals'
	option mmx_mask '0x3F00'
	option rt_table_offset '32'
	list rt_table_lookup '1'
	list rt_table_lookup '24'
	option download_mode 'daily'
	option net_kind 'Priority'
	option dividing 'client'
	option dividing_default 'poe'
	list priority 'poe'
	list priority 'main'
	list priority 'wan'

config interface 'cpe_4'
	option enabled '1'
	option family 'ipv4'
	option initial_state 'online'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '5'
	option down '3'
	option up '2'

config interface 'cpe1'
	option enabled '1'
	option family 'ipv4'
	option initial_state 'offline'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '5'
	option down '3'
	option up '2'

# IPv6 keeps native source-prefix routing; no cross-provider NAT66.
config interface 'cpe_6'
	option enabled '0'
	option family 'ipv6'

config interface 'cpe1_6'
	option enabled '0'
	option family 'ipv6'

config member 'main_backup'
	option interface 'cpe_4'
	option metric '2'
	option weight '1'

config member 'poe_primary'
	option interface 'cpe1'
	option metric '1'
	option weight '1'

config member 'main_download'
	option interface 'cpe_4'
	option metric '1'
	option weight '1'

config member 'poe_download'
	option interface 'cpe1'
	option metric '1'
	option weight '1'

config policy 'poe_first'
	list use_member 'poe_primary'
	list use_member 'main_backup'
	option last_resort 'default'

config policy 'dual_download'
	list use_member 'main_download'
	list use_member 'poe_download'
	option last_resort 'default'

config rule 'lan_default'
	option src_iface 'lan'
	option family 'ipv4'
	option proto 'all'
	option use_policy 'poe_first'
