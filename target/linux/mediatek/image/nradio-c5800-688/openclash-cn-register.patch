--- a/etc/init.d/openclash
+++ b/etc/init.d/openclash
@@ -3811,6 +3811,36 @@
    {
       LOG_OUT "Step 1: Get The Configuration..."
+      if ! uci -q get openclash.c5800_cn_route >/dev/null; then
+         uci -q batch <<'C5800_CN_ROUTE' || LOG_WARN "C5800 domestic route module registration failed"
+set openclash.c5800_cn_route=config_overwrite
+set openclash.c5800_cn_route.name='c5800_cn_route'
+set openclash.c5800_cn_route.type='file'
+set openclash.c5800_cn_route.enable='1'
+set openclash.c5800_cn_route.order='1'
+add_list openclash.c5800_cn_route.config='/etc/openclash/config/clash-all-smart.yaml'
+commit openclash
+C5800_CN_ROUTE
+         QUICK_START=false
+      fi
+
+      if [ "$(uci -q get openclash.c5800_cn_route.enable)" = 1 ] &&
+         [ "$(uci -q get openclash.config.config_path)" = '/etc/openclash/config/clash-all-smart.yaml' ]; then
+         local c5800_route_module=/etc/openclash/overwrite/c5800_cn_route
+         # A keep-config upgrade can restore the old built-in module over ROM.
+         if ! grep -qFx 'routing-mark: 1048576' "$c5800_route_module" 2>/dev/null &&
+            [ -f "/rom$c5800_route_module" ]; then
+            cp -p "/rom$c5800_route_module" "$c5800_route_module" ||
+               LOG_WARN "C5800 route module update failed"
+            QUICK_START=false
+         fi
+         if [ "$(uci -q get openclash.config.interface_name)" = eth1 ]; then
+            uci -q set openclash.config.interface_name=0 && uci -q commit openclash ||
+               LOG_WARN "C5800 old OpenClash interface setting could not be cleared"
+            QUICK_START=false
+         fi
+      fi
+
       # Check instead of restart
       check_run_quick
       overwrite_file
       get_config
