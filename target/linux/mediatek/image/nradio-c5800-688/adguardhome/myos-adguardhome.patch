--- a/etc/uci-defaults/40_luci-AdGuardHome
+++ b/etc/uci-defaults/40_luci-AdGuardHome
@@ -8,5 +8,19 @@
 	delete AdGuardHome.AdGuardHome.ucitracktest
 EOF
 
+# Preserved upgrades may restore an older core over the copy in the image.
+core=/usr/bin/AdGuardHome/AdGuardHome
+if [ ! -L "$core" ] && [ -x "/rom$core" ] &&
+   [ "$(uci -q get AdGuardHome.AdGuardHome.binpath)" = "$core" ]; then
+	adguard_core_version() {
+		"$1" --version 2>/dev/null | sed -n 's/^.*version v\([^ ,]*\).*$/\1/p'
+	}
+	current=$(adguard_core_version "$core")
+	bundled=$(adguard_core_version "/rom$core")
+	if [ -n "$current" ] && [ -n "$bundled" ] && opkg compare-versions "$current" lt "$bundled"; then
+		cp -p "/rom$core" "$core" || logger -t AdGuardHome "Cannot restore the bundled AdGuard Home core"
+	fi
+fi
+
 rm -f /tmp/luci-indexcache
 exit 0
