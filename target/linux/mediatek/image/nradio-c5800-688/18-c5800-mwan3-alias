#!/bin/sh
# Ordinary WAN never supplies PoE, including when mwan3 is disabled.
case "$INTERFACE:$ACTION" in
	cpe1:ifup|cpe1:ifupdate)
		case "$(uci -q get network.cpe1.proto)" in
			dhcp|static|pppoe)
				[ -w /sys/class/gpio/cpe1-pwr/value ] &&
					printf '1' > /sys/class/gpio/cpe1-pwr/value
				;;
		esac
		;;
esac
# Track port5 through its stable parent for both ODU and ordinary WAN protocols.
[ -d /var/run/mwan3 ] || exit 0
case "$INTERFACE" in cpe_4|cpe1|cpe1_4) ;; *) exit 0 ;; esac
case "$ACTION" in ifup|ifupdate|ifdown) ;; *) exit 0 ;; esac

# Native routing can move the main modem default into its health-check table.
# Keep router DNS and other unmarked traffic working when port5 is absent.
ip -4 rule show | grep -q '32767:.*lookup 1$' ||
	ip -4 rule add pref 32767 lookup 1

case "$INTERFACE:$ACTION" in
	cpe1_4:ifup) mwan3 ifup cpe1 ;;
	cpe1_4:ifdown)
		case "$(uci -q get network.cpe1.proto)" in
			wwan|odu|nrcpe) mwan3 ifdown cpe1 ;;
		esac
		;;
esac
if [ "$ACTION" = "ifdown" ]; then
	# Native defaults added outside netifd must leave with the uplink too.
	case "$INTERFACE" in
		cpe_4) down_device="$(uci -q get network.cpe.device)" ;;
		cpe1|cpe1_4) down_device="$(uci -q get network.cpe1.device)" ;;
	esac
	if [ -n "$down_device" ]; then
		ip -4 route flush table main default dev "$down_device"
		ip -6 route flush table main default dev "$down_device"
	fi
	exit 0
fi

. /lib/functions.sh
. /lib/functions/network.sh
. /lib/mwan3/mwan3.sh
mwan3_init

refresh_default() {
	local iface="$1" table="$2" true_iface device address gateway protocol lan_device route
	mwan3_get_true_iface true_iface "$iface"
	network_is_up "$true_iface" || return 0
	network_get_ipaddr address "$true_iface" || return 0
	network_get_device device "$true_iface" || return 0
	if network_get_gateway gateway "$true_iface" && [ "$gateway" != "0.0.0.0" ]; then
		ip -4 route replace table "$table" default via "$gateway" dev "$device"
	else
		network_get_protocol protocol "$true_iface"
		[ "$protocol" = "pppoe" ] && ip -4 route replace table "$table" default dev "$device"
	fi
	# Replies marked for this WAN must retain the route back to LAN.
	network_get_device lan_device lan || return 0
	ip -4 route show table main | while read -r route; do
		case "$route " in
			*" dev $lan_device "*) ip -4 route replace table "$table" $route ;;
		esac
	done
}

mwan3_get_iface_id main_table cpe_4
mwan3_get_iface_id secondary_table cpe1
refresh_default cpe_4 "$main_table"
refresh_default cpe1 "$secondary_table"
# DHCP renewals must retain the user's selected factory routing mode.
exit 0
