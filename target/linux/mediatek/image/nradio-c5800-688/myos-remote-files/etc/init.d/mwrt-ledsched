#!/bin/sh /etc/rc.common
# Apply the LED blackout schedule at boot and whenever the config is committed.
#
# No instance is opened: this is a trigger-only service. rc.common registers
# service_triggers() from _procd_close_service() regardless of how many
# instances were declared, so procd calls reload_service() on commit without
# anything having to stay resident.
#
# Two triggers, for two different reasons:
#   mwrt_led - somebody changed the schedule (web UI's Save & Apply, the APP,
#              or plain `uci commit mwrt_led`), so act on it now instead of
#              waiting for the next minute's cron tick.
#   system   - the stock LED config was applied, which runs /etc/init.d/led and
#              lights every configured LED back up. If that happens inside a
#              dark window the LEDs have to go back down.

START=99
USE_PROCD=1

ENGINE=/usr/bin/mwrt-ledsched

boot() {
	# Reset stale runtime snapshots under the engine's lock after stock LEDs boot.
	[ -x "$ENGINE" ] && "$ENGINE" boot
	start "$@"
}

start_service() {
	[ -x "$ENGINE" ] && "$ENGINE" apply
}

reload_service() {
	[ -x "$ENGINE" ] && "$ENGINE" apply
}

stop_service() {
	# Leaving the LEDs dark with the service stopped would strand them, since
	# nothing would be left to bring them back.
	[ -x "$ENGINE" ] && "$ENGINE" restore >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger mwrt_led system
}

