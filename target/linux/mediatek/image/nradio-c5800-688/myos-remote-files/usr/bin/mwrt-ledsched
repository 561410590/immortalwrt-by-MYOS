#!/bin/sh
# mwrt-ledsched -- scheduled LED blackout.
#
# One engine, two front-ends: the LuCI page at admin/system/leds and the NRadio
# APP (myos_nradio_data.lua) both read and write /etc/config/mwrt_led and both
# call this script, so changing either side is immediately visible on the other.
#
# Plain ash, the uci CLI and flock; Lua is only needed by the APP adapter.
#
# The pre-blackout snapshot is kept in the config (not in /tmp) so that a reboot
# in the middle of a dark window still restores the original triggers afterwards.

CFG=mwrt_led
SEC=main
LEDDIR=/sys/class/leds
LEDFLAG=/tmp/ledflag.conf
LEGACY=/etc/init.d/ledctrl

# Serialize APP, LuCI, procd and cron calls, including snapshot restoration.
exec 9>/var/lock/mwrt-ledsched.lock || exit 1
# BusyBox flock has no -w option. Bound contention without an extra package.
lock_attempt=0
until flock -xn 9; do
	[ "$lock_attempt" -lt 15 ] || exit 1
	lock_attempt=$((lock_attempt + 1))
	sleep 1
done

[ -f "/etc/config/$CFG" ] || exit 0

uget() { uci -q get "$CFG.$SEC.$1"; }
uset() { uci -q set "$CFG.$SEC.$1=$2"; }

# Pause the existing business LED daemon only for a blackout. Keep its autostart
# setting intact and restart it only when this engine stopped a running service.
# Close the engine lock descriptor in service calls so procd children cannot
# inherit it and hold the LED lock after this command exits.
pause_legacy() {
	[ -x "$LEGACY" ] || return 0
	if "$LEGACY" running >/dev/null 2>&1; then
		uset ledctrl_resume 1
		uci -q commit "$CFG" || return 1
		"$LEGACY" stop 9>&- >/dev/null 2>&1 || return 1
	fi
}

resume_legacy() {
	[ "$(uget ledctrl_resume)" = "1" ] || return 0
	[ -x "$LEGACY" ] || return 1
	"$LEGACY" start 9>&- >/dev/null 2>&1 || return 1
	uci -q delete "$CFG.$SEC.ledctrl_resume"
	uci -q commit "$CFG"
}

# ---------------------------------------------------------------- enumeration

# Every LED the kernel lets us drive. Enumerated, never hardcoded: boards in
# this tree expose different names. The default selection contains the five
# front-panel LEDs verified on both MyOS targets; additional LEDs remain selectable.
led_all() {
	for d in "$LEDDIR"/*; do
		[ -w "$d/brightness" ] || continue
		echo "${d##*/}"
	done
}

# The subset the user asked us to manage; empty selection means all of them.
led_managed() {
	sel=$(uci -q get "$CFG.$SEC.leds")
	if [ -z "$sel" ]; then
		led_all
		return
	fi
	for n in $(led_all); do
		for s in $sel; do
			[ "$n" = "$s" ] && { echo "$n"; break; }
		done
	done
}

# Saveable attributes, chosen by exclusion rather than by an allowlist: that way
# we pick up the netdev trigger's full set (link_10 .. link_10000, offloaded,
# full_duplex, half_duplex, device_name, interval, ...) and timer's
# delay_on/delay_off without this script needing to know they exist.
attr_list() {
	for f in "$LEDDIR/$1"/*; do
		[ -f "$f" ] && [ -r "$f" ] && [ -w "$f" ] || continue
		case "${f##*/}" in
			# brightness and trigger are handled explicitly and in a specific
			# order; max_brightness/uevent are not settings. "offloaded" reports
			# 0644 but the netdev trigger refuses writes to it -- it is a
			# kernel-computed status, not a knob.
			brightness|trigger|max_brightness|uevent|offloaded) continue ;;
		esac
		echo "${f##*/}"
	done
}

# The trigger file lists every trigger with the active one in [brackets].
active_trigger() {
	sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$LEDDIR/$1/trigger" 2>/dev/null
}

# ------------------------------------------------------------------- blackout

do_off() {
	[ -n "$(uget restore)" ] && return 0	# already dark

	uci -q delete "$CFG.$SEC.restore"
	for n in $(led_managed); do
		trg=$(active_trigger "$n")
		[ -n "$trg" ] || trg=none
		br=$(cat "$LEDDIR/$n/brightness" 2>/dev/null)
		[ -n "$br" ] || br=0
		kv=
		for a in $(attr_list "$n"); do
			v=$(cat "$LEDDIR/$n/$a" 2>/dev/null) || continue
			# our record separators; an attribute containing them is skipped
			# rather than silently corrupting the whole snapshot
			case "$v" in *"|"* | *";"* | *" "*) continue ;; esac
			kv="$kv$a=$v;"
		done
		uci -q add_list "$CFG.$SEC.restore=$n|$trg|$br|$kv"
	done

	# Commit the snapshot BEFORE touching the hardware. If the commit fails we
	# must not end up dark with no record of how to get back.
	uci -q commit "$CFG" || {
		uci -q revert "$CFG"
		resume_legacy
		return 1
	}

	# /tmp/ledflag.conf is this firmware's existing "LEDs are under manual
	# control" marker -- mwrt_wan_failover.sh checks it and stops driving
	# status/error while it exists, which is the only reason our blackout
	# survives more than a few seconds. Only remove it later if we created it,
	# so we never clobber a flag the user set by hand via led.sh.
	if [ -e "$LEDFLAG" ]; then
		uset ledflag_ours 0
	else
		echo 2 > "$LEDFLAG" && uset ledflag_ours 1
	fi

	enforce_off || return 1
	uci -q commit "$CFG"
}

# Hold the managed LEDs down. Run on every tick while the window is open, not
# just at its start: /etc/init.d/led re-applies the whole stock LED config on
# `reload_config` -- which is exactly what LuCI's Save & Apply ends with -- and
# that lights everything back up in the middle of a dark window. Both writes are
# no-ops when nothing changed, so this costs nothing to repeat.
enforce_off() {
	for n in $(led_managed); do
		[ "$(active_trigger "$n")" = "none" ] || \
			{ echo none > "$LEDDIR/$n/trigger"; } 2>/dev/null || return 1
		[ "$(cat "$LEDDIR/$n/brightness" 2>/dev/null)" = "0" ] || \
			{ echo 0 > "$LEDDIR/$n/brightness"; } 2>/dev/null || return 1
	done
}

do_on() {
	list=$(uget restore)
	[ -n "$list" ] || { resume_legacy; return $?; }

	for e in $list; do
		n=${e%%|*}
		rest=${e#*|}
		trg=${rest%%|*}
		rest=${rest#*|}
		br=${rest%%|*}
		kv=${rest#*|}
		[ -d "$LEDDIR/$n" ] || continue

		# Trigger first: a trigger's attribute files only exist while that
		# trigger is selected, so writing them any earlier is a no-op.
		{ echo "$trg" > "$LEDDIR/$n/trigger"; } 2>/dev/null || return 1

		oldifs=$IFS
		IFS=';'
		for p in $kv; do
			[ -n "$p" ] || continue
			a=${p%%=*}
			v=${p#*=}
			# The redirect has to be silenced around the *whole* command: a
			# rejected sysfs write fails in the shell's redirection, so the
			# diagnostic comes from the shell and not from echo's stderr.
			# Some attributes advertise 0644 yet the owning trigger still says
			# no, and that must not turn into console noise every restore.
			[ -w "$LEDDIR/$n/$a" ] && { echo "$v" > "$LEDDIR/$n/$a"; } 2>/dev/null
		done
		IFS=$oldifs

		# Brightness last, and only where no trigger owns it. While a trigger is
		# active it drives brightness itself, and an explicit write of 0 detaches
		# the trigger again -- the trap the NROS implementation warns about.
		if [ "$trg" = "none" ]; then
			{ echo "$br" > "$LEDDIR/$n/brightness"; } 2>/dev/null || return 1
		fi
	done

	[ "$(uget ledflag_ours)" = "1" ] && rm -f "$LEDFLAG"
	uci -q delete "$CFG.$SEC.restore"
	uci -q delete "$CFG.$SEC.ledflag_ours"
	uci -q commit "$CFG" || return 1
	resume_legacy
}

# ------------------------------------------------------------------ scheduling

# Strip one leading zero and print the result, or 0 for an empty field.
#
# Necessary because busybox ash's $(( )) has no "10#" radix prefix (a bashism)
# and rejects a leading zero outright -- $(( 08 )) is a syntax error, not 8. So
# neither "10#$h" nor a bare "$h" works on values straight out of date +%H.
num() {
	v=${1#0}
	echo "${v:-0}"
}

hhmm_to_min() {
	case "$1" in
		[0-9]*:[0-9]*)
			h=$(num "${1%%:*}")
			m=$(num "${1##*:}")
			echo $(( h * 60 + m ))
			;;
		*) echo -1 ;;
	esac
}

# Minutes since local midnight.
now_min() {
	nh=$(num "$(date +%H)")
	nm=$(num "$(date +%M)")
	echo $(( nh * 60 + nm ))
}

# Empty weekday list means every day. $1 is a 0..6 weekday, Sunday = 0, matching
# `date +%w`.
#
# The loop variable is local and deliberately not "d": next_switch() counts days
# in $d and calls us from inside that loop, so an unscoped "d" here overwrites
# its counter and the while loop never terminates -- a cron tick that spins
# forever, once per minute, for any schedule with weekdays set.
active_day() {
	local wd=$(uci -q get "$CFG.$SEC.weekdays")
	local x
	[ -z "$wd" ] && return 0
	for x in $wd; do
		[ "$x" = "$1" ] && return 0
	done
	return 1
}

# 1 if the schedule alone says the LEDs should be dark right now.
#
# A window that crosses midnight belongs to the weekday it *starts* on, so
# picking only Monday with 23:00-07:00 means Mon 23:00 through Tue 07:00.
sched_state() {
	[ "$(uget enabled)" = "1" ] || { echo 0; return; }
	[ "$(uget mode)" = "always_off" ] && { echo 1; return; }

	s=$(hhmm_to_min "$(uget starttime)")
	e=$(hhmm_to_min "$(uget endtime)")
	[ "$s" -ge 0 ] && [ "$e" -ge 0 ] && [ "$s" != "$e" ] || { echo 0; return; }

	nowm=$(now_min)
	tw=$(date +%w)
	yw=$(( (tw + 6) % 7 ))

	if [ "$s" -lt "$e" ]; then
		if active_day "$tw" && [ "$nowm" -ge "$s" ] && [ "$nowm" -lt "$e" ]; then
			echo 1
			return
		fi
	else
		if active_day "$tw" && [ "$nowm" -ge "$s" ]; then echo 1; return; fi
		if active_day "$yw" && [ "$nowm" -lt "$e" ]; then echo 1; return; fi
	fi
	echo 0
}

# Next scheduled flip as "<minutes from today 00:00> <off|on>", or nothing when
# there is no schedule to speak of. Walks the next eight days and takes the
# earliest boundary still ahead of us, rather than stepping minute by minute.
next_switch() {
	[ "$(uget enabled)" = "1" ] || return 1
	[ "$(uget mode)" = "always_off" ] && return 1

	s=$(hhmm_to_min "$(uget starttime)")
	e=$(hhmm_to_min "$(uget endtime)")
	[ "$s" -ge 0 ] && [ "$e" -ge 0 ] && [ "$s" != "$e" ] || return 1

	nowm=$(now_min)
	tw=$(date +%w)
	best=-1
	beststate=

	# Yesterday may own a cross-midnight window ending later today.
	d=-1
	while [ $d -le 7 ]; do
		w=$(( (tw + d + 7) % 7 ))
		if active_day "$w"; then
			sa=$(( d * 1440 + s ))
			if [ "$s" -lt "$e" ]; then
				ea=$(( d * 1440 + e ))
			else
				ea=$(( d * 1440 + e + 1440 ))
			fi
			for c in "$sa off" "$ea on"; do
				set -- $c
				if [ "$1" -gt "$nowm" ] && { [ "$best" -lt 0 ] || [ "$1" -lt "$best" ]; }; then
					best=$1
					beststate=$2
				fi
			done
		fi
		d=$(( d + 1 ))
	done

	[ "$best" -lt 0 ] && return 1
	echo "$best $beststate"
}

# -------------------------------------------------------------------- commands

cmd_apply() {
	case "$(uget manual)" in
		off) want=1 ;;
		on)  want=0 ;;
		*)   want=$(sched_state) ;;
	esac

	dark=0
	[ -n "$(uget restore)" ] && dark=1

	if [ "$want" = 1 ]; then
		pause_legacy || return 1
		# Already dark by our own bookkeeping: keep it that way rather than
		# returning early, because something else may have re-lit the LEDs
		# since the last tick (see enforce_off).
		if [ "$dark" = 1 ]; then
			enforce_off
		else
			do_off
		fi
	elif [ "$dark" = 1 ]; then
		do_on
	else
		resume_legacy
	fi
}

cmd_status() {
	n_all=$(led_all | wc -l)
	sup=false
	[ "$n_all" -gt 0 ] && sup=true
	dk=false
	[ -n "$(uget restore)" ] && dk=true

	printf '{"supported":%s,"dark":%s,"manual":"%s","enabled":"%s","mode":"%s"' \
		"$sup" "$dk" "$(uget manual)" "$(uget enabled)" "$(uget mode)"

	ns=$(next_switch)
	if [ -n "$ns" ]; then
		set -- $ns
		dayoff=$(( $1 / 1440 ))
		mm=$(( $1 % 1440 ))
		printf ',"next_at":"%02d:%02d","next_day":%d,"next_state":"%s"' \
			$(( mm / 60 )) $(( mm % 60 )) "$dayoff" "$2"
	fi

	printf ',"leds":['
	first=1
	managed=$(led_managed)
	for n in $(led_all); do
		[ $first = 1 ] || printf ','
		first=0
		br=$(cat "$LEDDIR/$n/brightness" 2>/dev/null)
		trg=$(active_trigger "$n")
		mg=false
		for x in $managed; do
			[ "$x" = "$n" ] && { mg=true; break; }
		done
		printf '{"name":"%s","brightness":%s,"trigger":"%s","managed":%s}' \
			"$n" "${br:-0}" "${trg:-none}" "$mg"
	done
	printf ']}\n'
}

case "$1" in
	boot)
		# Hardware has its new boot state; discard only the old runtime snapshot.
		uci -q delete "$CFG.$SEC.restore"
		uci -q delete "$CFG.$SEC.ledflag_ours"
		uci -q delete "$CFG.$SEC.ledctrl_resume"
		uci -q commit "$CFG" || exit 1
		cmd_apply
		;;
	apply)  cmd_apply ;;
	# Put the LEDs back without touching the configuration -- for the init
	# script's stop, which must not strand them dark, but also must not leave
	# a manual override behind the way "on" deliberately does.
	restore) do_on ;;
	off)    uset manual off; uci -q commit "$CFG"; cmd_apply ;;
	on)     uset manual on;  uci -q commit "$CFG"; cmd_apply ;;
	auto)   uci -q delete "$CFG.$SEC.manual"; uci -q commit "$CFG"; cmd_apply ;;
	status) cmd_status ;;
	*)      echo "usage: ${0##*/} {apply|restore|off|on|auto|status|boot}" >&2; exit 1 ;;
esac
