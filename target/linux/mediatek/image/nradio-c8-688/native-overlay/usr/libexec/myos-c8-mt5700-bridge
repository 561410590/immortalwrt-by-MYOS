#!/usr/bin/python3
"""Share the C8 ATSd owner with the upstream MT5700 TCP backend."""
import re
import select
import socket
import subprocess

def execute(command):
    timeout = 180 if command.upper().startswith("AT^CELLSCAN") else 2
    try:
        result = subprocess.run(
            ["/usr/sbin/atsd_cli", "-i", "cpe", "-c", command, "-w", str(timeout * 1000)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout + 3)
        response = result.stdout.decode(errors="replace").replace("\r\n", "\n").replace("\r", "\n")
        return (response.rstrip("\n") + "\n").replace("\n", "\r\n").encode() if response.strip() else b"ERROR\r\n"
    except (OSError, subprocess.TimeoutExpired) as error:
        print(error, flush=True)
        return b"ERROR\r\n"

with socket.socket() as server:
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 20250))
    server.listen(4)
    while True:
        client, _ = server.accept()
        reports = subprocess.Popen(["logread", "-f", "-l", "1"], stdout=subprocess.PIPE)
        pending, log_pending = b"", b""
        try:
            with client:
                while True:
                    ready, _, _ = select.select([client, reports.stdout], [], [])
                    if client in ready:
                        data = client.recv(16384)
                        if not data:
                            break
                        pending += data
                        while b"\r" in pending or b"\n" in pending:
                            command, pending = re.split(b"[\r\n]", pending, maxsplit=1)
                            if command.strip():
                                client.sendall(execute(command.decode(errors="replace")))
                    if reports.stdout in ready:
                        data = reports.stdout.read1(16384)
                        if not data:
                            break
                        log_pending += data
                        lines = log_pending.split(b"\n")
                        log_pending = lines.pop()
                        for line in lines:
                            if b"[cpe]" in line:
                                report = re.search(rb"\^PDCPDATAINFO:\s*[\d,]+", line)
                                if report:
                                    client.sendall(report.group() + b"\r\n")
        except OSError as error:
            print(error, flush=True)
        finally:
            reports.terminate()
            reports.wait()
