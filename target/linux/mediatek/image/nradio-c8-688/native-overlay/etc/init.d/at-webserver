#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    config_load at-webserver
    local enabled
    config_get_bool enabled config enabled 1
    [ "$enabled" -eq 1 ] || return 0

    procd_open_instance atsd_bridge
    procd_set_param command /usr/bin/python3 /usr/libexec/myos-c8-mt5700-bridge
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance backend
    procd_set_param command /usr/bin/at-webserver
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger at-webserver
}
