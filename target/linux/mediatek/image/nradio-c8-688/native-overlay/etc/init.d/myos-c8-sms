#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get myos_c8_sms.main.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/myos-c8-sms
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger myos_c8_sms
}
