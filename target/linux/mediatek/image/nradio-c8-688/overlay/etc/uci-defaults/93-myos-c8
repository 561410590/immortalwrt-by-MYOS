#!/bin/sh
. /lib/functions/myos-c8-identity.sh
myos_c8_board || exit 0
. /lib/functions.sh
# Remove only the obsolete topology generated by the shared 04_defaults.
if [ ! -e /sys/class/net/BLUE4 ]; then
    for c8_interface in BLUE4WAN BLUE4WANV6; do
        [ "$(uci -q get "network.$c8_interface.device")" = BLUE4 ] || continue
        uci -q delete "network.$c8_interface"
    done
fi
c8_legacy_bridge() {
    local name ports port
    config_get name "$1" name
    [ "$name" = br-lan ] || return 0
    config_get ports "$1" ports
    if [ "$ports" = 'lan1 lan2 lan3' ] &&
       [ ! -e /sys/class/net/lan1 ] && [ ! -e /sys/class/net/lan2 ] &&
       [ ! -e /sys/class/net/lan3 ]; then
        uci -q delete "network.$1"
        return 0
    fi
    for port in lan1 lan2 lan3; do
        [ -e "/sys/class/net/$port" ] || uci -q del_list "network.$1.ports=$port"
    done
}
config_load network
config_foreach c8_legacy_bridge device
uci -q commit network
if [ -f /tmp/myos-c8-new-network ]; then
    . /lib/functions.sh
    c8_bridge_found=0
    c8_bridge() {
        local name
        config_get name "$1" name
        [ "$name" = br-lan ] || return 0
        c8_bridge_found=1
        uci -q delete "network.$1.ports"
        uci -q add_list "network.$1.ports=port1"
        uci -q add_list "network.$1.ports=port2"
        uci -q add_list "network.$1.ports=port3"
    }
    config_load network
    config_foreach c8_bridge device
    if [ "$c8_bridge_found" = 0 ]; then
        uci -q set network.c8_lan=device
        uci -q set network.c8_lan.name=br-lan
        uci -q set network.c8_lan.type=bridge
        uci -q add_list network.c8_lan.ports=port1
        uci -q add_list network.c8_lan.ports=port2
        uci -q add_list network.c8_lan.ports=port3
    fi
    uci -q set network.lan.device=br-lan
    uci -q delete network.lan.ifname
    uci -q set network.wan=interface
    uci -q set network.wan.device=port5
    uci -q set network.wan.proto=dhcp
    uci -q delete network.wan.ifname
    uci -q set network.wan6=interface
    uci -q set network.wan6.device=@wan
    uci -q set network.wan6.proto=dhcpv6
    uci -q delete network.wan6.ifname
    uci -q set network.cpe=interface
    uci -q set network.cpe.proto=wwan
    uci -q set network.cpe.device=eth1
    uci -q delete network.cpe.ifname
    uci -q delete network.cpe.phyifname
    uci -q set network.cpe.forcephy=1
    uci -q set network.cpe.phyifname=eth1
    uci -q set network.cpe.phycap=1
    uci -q set 'network.cpe.desc=TD Tech MT5700'
    uci -q set network.cpe.odu_model=MT5700M-CN
    uci -q set network.cpe.mobility=2
    uci -q set network.cpe.freq_multi=1
    uci -q set network.cpe.nrcap=1
    uci -q set network.cpe.sms=1
    uci -q set network.cpe.ippass=1
    uci -q set network.cpe.nrrc=1
    uci -q set network.cpe.defaultroute=1
    uci -q set network.cpe.compatibility=1
    uci -q set network.cpe.disabled=0
    uci -q delete network.cpe_4
    uci -q delete network.cpe_6
    uci -q delete network.cpe1
    uci -q del_list network.lan.ip6class=cpe_6
    uci -q add_list network.lan.ip6class=cpe_6
    uci -q commit network
    c8_wan_zone() {
        local name
        config_get name "$1" name
        [ "$name" = wan ] || return 0
        uci -q del_list "firewall.$1.network=cpe"
        uci -q del_list "firewall.$1.network=cpe_4"
        uci -q del_list "firewall.$1.network=cpe_6"
        uci -q add_list "firewall.$1.network=cpe"
        uci -q add_list "firewall.$1.network=cpe_4"
        uci -q add_list "firewall.$1.network=cpe_6"
    }
    config_load firewall
    config_foreach c8_wan_zone zone
    uci -q commit firewall
fi
# Migrate the earlier USB-data configuration to the factory Ethernet path.
# The PHY driver owns link negotiation; netifd waits for its real carrier.
if [ "$(uci -q get network.cpe.proto)" = wwan ]; then
    uci -q set network.cpe.device=eth1
    uci -q set network.cpe.forcephy=1
    uci -q set network.cpe.phyifname=eth1
    uci -q set network.cpe.phycap=1
    uci -q delete network.cpe.force_link
    uci -q commit network
fi
# cpe_6 extends the modem's on-link /64 onto LAN. RA alone does not
# answer the modem's neighbour solicitations for LAN addresses.
if [ "$(uci -q get network.cpe.proto)" = wwan ] &&
   [ "$(uci -q get network.cpe.phyifname)" = eth1 ]; then
    case " $(uci -q get network.lan.ip6class) " in
        *" cpe_6 "*)
            if [ -z "$(uci -q get dhcp.lan.ndp)" ]; then
                uci -q set dhcp.lan.ndp=relay
            fi
            if [ "$(uci -q get dhcp.lan.ndp)" = relay ] &&
               [ -z "$(uci -q get dhcp.c8_cpe6)" ]; then
                uci -q set dhcp.c8_cpe6=dhcp
                uci -q set dhcp.c8_cpe6.interface=cpe_6
                uci -q set dhcp.c8_cpe6.master=1
                uci -q set dhcp.c8_cpe6.ndp=relay
            fi
            uci -q commit dhcp
            ;;
    esac
fi
# Extend known earlier definitions using the board's two external/two internal routes.
case "$(uci -q get cpesel.sim.max):$(uci -q get cpesel.sim.gval)" in
  '2:10-1,11-1'|'3:10-1,11-1,11-2')
    uci -q set cpesel.sim.max=4
    uci -q set cpesel.sim.gval='10-1,11-1,11-2,01-2'
    uci -q set cpesel.sim.stype='0,0,4,4'
    uci -q commit cpesel
    ;;
esac
# Default IP passthrough on all four choices; preserve an explicit off setting.
for c8_sim in 1 2 3 4; do
    if [ -z "$(uci -q get cpecfg.cpesim$c8_sim)" ]; then
        uci -q set "cpecfg.cpesim$c8_sim=cpesim"
    fi
    if [ -z "$(uci -q get cpecfg.cpesim$c8_sim.ippass)" ]; then
        uci -q set "cpecfg.cpesim$c8_sim.ippass=1"
    fi
done
[ -n "$(uci -q get network.cpe.ippass)" ] || uci -q set network.cpe.ippass=1
uci -q commit cpecfg
uci -q commit network
# Keep DHCP and cellular default routes distinct. Equal zero metrics let
# the later cellular lease replace the wired default in the kernel table.
if [ "$(uci -q get network.wan.device)" = port5 ] &&
   [ "$(uci -q get network.wan.proto)" = dhcp ] &&
   [ "$(uci -q get network.cpe.proto)" = wwan ]; then
    c8_wan_metric="$(uci -q get network.wan.metric)"
    c8_cpe_metric="$(uci -q get network.cpe.metric)"
    if [ "${c8_wan_metric:-0}" = 0 ] && [ "${c8_cpe_metric:-0}" = 0 ]; then
        uci -q set network.wan.metric=100
        uci -q commit network
    fi
fi
# Retain an existing wired recovery uplink across upgrades. Factory defaults
# still assign port1 to LAN; prefer cellular when both uplinks are available.
if [ "$(uci -q get network.111.device)" = port1 ] &&
   [ "$(uci -q get network.111.proto)" = dhcp ]; then
    uci -q set network.111.metric=100
    uci -q commit network
fi
# Retained configurations may lack the factory bridge MAC. A random port1
# address must not replace the cloud identity when it rejoins the LAN bridge.
c8_lan_mac="$(myos_c8_identity mac)"
if [ -n "$c8_lan_mac" ]; then
    c8_bridge_mac() {
        local name
        config_get name "$1" name
        [ "$name" = br-lan ] || return 0
        uci -q set "network.$1.macaddr=$c8_lan_mac"
    }
    config_load network
    config_foreach c8_bridge_mac device
    uci -q set "network.lan.macaddr=$c8_lan_mac"
    uci -q commit network
fi
/etc/init.d/myos-c8-led enable >/dev/null 2>&1
/etc/init.d/myos-c8-fan enable >/dev/null 2>&1
exit 0
