#!/bin/sh
# C8 variant of iStore's Docker Manager autoconfiguration.
# Keep the vendor application and LuCI authentication; enable its TCP entry.
[ -n "$ISTORE_CONF_DIR" ] || {
    echo "Docker Manager installation directory is missing" >&2
    exit 1
}
c8_enabled=1
[ -z "$ISTORE_DONT_START" ] || c8_enabled=0
mkdir -p "$ISTORE_CONF_DIR/DockerManager" || exit 1
uci -q set "dockermanager.@dockermanager[0].enabled=$c8_enabled"
uci -q set "dockermanager.@dockermanager[0].data_dir=$ISTORE_CONF_DIR/DockerManager"
uci -q set "dockermanager.@dockermanager[0].listen_mode=auto"
uci -q set "dockermanager.@dockermanager[0].external_port_enabled=1"
uci -q set "dockermanager.@dockermanager[0].socket_path=/var/run/dockermanager.sock"
uci -q set "dockermanager.@dockermanager[0].port=8192"
uci -q set "dockermanager.@dockermanager[0].bind_addr=0.0.0.0"
uci -q set "dockermanager.@dockermanager[0].base_path=/apps/dockermanager/"
uci -q commit dockermanager || exit 1
/etc/init.d/dockermanager restart
