REQUIRE_IMAGE_METADATA=1
RAMFS_COPY_BIN='blkid fwtool jsonfilter /usr/libexec/myos-ultra-gpt'

# Both layouts keep kernel/rootfs labels. Resolve the validated layout rather
# than deriving offsets or capacity from an old card image.
c2000ultra_upgrade_parts() {
	local state
	state="$(/usr/libexec/myos-ultra-gpt status)" || return 1
	[ "$(printf '%s' "$state" | jsonfilter -e '@.backup_gpt_valid')" = true ] || return 1
	C2000ULTRA_UPGRADE_LAYOUT="$(printf '%s' "$state" | jsonfilter -e '@.layout')"
	case "$C2000ULTRA_UPGRADE_LAYOUT" in
		official) EMMC_KERN_DEV=/dev/mmcblk0p3; EMMC_ROOT_DEV=/dev/mmcblk0p4 ;;
		legacy) EMMC_KERN_DEV=/dev/mmcblk0p5; EMMC_ROOT_DEV=/dev/mmcblk0p6 ;;
		*) echo 'Unsupported C2000ULTRA SD layout.' >&2; return 1 ;;
	esac
	[ "$(blkid -s PARTLABEL -o value "$EMMC_KERN_DEV")" = kernel ] &&
		[ "$(blkid -s PARTLABEL -o value "$EMMC_ROOT_DEV")" = rootfs ] || return 1
	export EMMC_KERN_DEV EMMC_ROOT_DEV
}

platform_check_image() {
	local dir name bytes capacity
	[ "$#" = 1 ] || return 1
	[ "$(dd if="$1" bs=1 skip=257 count=5 2>/dev/null)" = ustar ] || return 1
	c2000ultra_upgrade_parts || return 1
	dir="$(tar tf "$1" | grep -m 1 '^sysupgrade-[^/]*/$')"
	[ -n "$dir" ] || return 1
	for name in kernel root; do
		bytes="$(tar xf "$1" "${dir}${name}" -O | wc -c)"
		case "$bytes" in ''|*[!0-9]*) return 1 ;; esac
		if [ "$name" = kernel ]; then
			capacity="$(cat /sys/class/block/${EMMC_KERN_DEV##*/}/size)"
		else
			capacity="$(cat /sys/class/block/${EMMC_ROOT_DEV##*/}/size)"
		fi
		case "$capacity" in ''|*[!0-9]*) return 1 ;; esac
		[ "$bytes" -gt 0 ] && [ "$bytes" -lt "$((capacity * 512 - 65536))" ] || {
			echo "C2000ULTRA $name does not fit its SD partition." >&2
			return 1
		}
	done
}

platform_do_upgrade() {
	c2000ultra_upgrade_parts || return 1
	if [ "$C2000ULTRA_UPGRADE_LAYOUT" = legacy ] && [ -n "$UPGRADE_BACKUP" ]; then
		fwtool -i /tmp/c2000ultra-upgrade-metadata.json "$1" || return 1
		C2000ULTRA_UPGRADE_VERSION="$(jsonfilter -i /tmp/c2000ultra-upgrade-metadata.json -e '@.version.version')"
		case "$C2000ULTRA_UPGRADE_VERSION" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
	fi
	emmc_do_upgrade "$1"
}

platform_copy_config() {
	if [ "$C2000ULTRA_UPGRADE_LAYOUT" = legacy ] && [ -b /dev/mmcblk0p7 ]; then
		local target=/tmp/c2000ultra-upgrade-overlay rc=0
		[ -n "$C2000ULTRA_UPGRADE_VERSION" ] && [ -s "$UPGRADE_BACKUP" ] || return 1
		mkdir -p "$target" || return 1
		mount -t ext4 /dev/mmcblk0p7 "$target" || return 1
		cp "$UPGRADE_BACKUP" "$target/myos-update-config.tgz" &&
			printf '%s\n' "$C2000ULTRA_UPGRADE_VERSION" > "$target/.myos-update-restore" || rc=1
		sync
		umount "$target" || rc=1
		return "$rc"
	fi
	emmc_copy_config
}
