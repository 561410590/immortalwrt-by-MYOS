#!/bin/sh /etc/rc.common

START=97

extra_command "select_sim" "<logical-slot> [mode] select a SIM and redial asynchronously"
extra_command "status_json" "show SIM selection and cellular interface state"
SIM_LOCK=/var/run/c2000ultra-sim-select.lock
SIM_STATE=/var/run/c2000ultra-sim-select.status.json
SIM_READY=/var/run/c2000ultra-sim-select.ready

save_selection() {
	local cur="$1" mode="$2" slot
	case "$cur" in
		1) slot=simcard1 ;;
		2) slot=simcard2 ;;
		3) slot=esimcard1 ;;
		*) return 1 ;;
	esac
	uci -q set cpesel.sim=cpesel &&
	uci -q set "cpesel.sim.cur=$cur" &&
	uci -q set cpesel.sim.selection_synced=1 || return 1
	[ -z "$mode" ] || uci -q set "cpesel.sim.mode=$mode" || return 1
	uci -q set embed_simcard.general=general &&
	uci -q set "embed_simcard.general.slot=$slot" &&
	uci -q commit embed_simcard && uci -q commit cpesel
}

resolve_target() {
	local mapping="$1" cur="$2" index entry gpio usim
	case "$cur" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$cur" -ge 1 ] || return 1
	index=1
	while [ "$index" -lt "$cur" ]; do
		case "$mapping" in
			*,*) mapping="${mapping#*,}" ;;
			*) return 1 ;;
		esac
		index=$((index + 1))
	done
	entry="${mapping%%,*}"
	case "$entry" in
		*-*) gpio="${entry%%-*}"; usim="${entry#*-}" ;;
		*) return 1 ;;
	esac
	case "$gpio" in ''|*[!01]*) return 1 ;; esac
	case "$usim" in 1|2) ;; *) return 1 ;; esac
	printf '%s %s\n' "$gpio" "$((usim - 1))"
}

pick_modem() {
	local section="$1" state port override path
	[ -z "$modem_section" ] || return
	config_get state "$section" state
	[ "$state" != "disabled" ] || return
	config_get path "$section" path
	[ -n "$path" ] && [ -d "$path" ] || return
	config_get port "$section" at_port
	config_get override "$section" override_at_port
	[ -z "$override" ] || port="$override"
	[ -n "$port" ] && [ -c "$port" ] || return
	modem_section="$section"
	modem_at_port="$port"
}

wait_for_modem() {
	local retries="${1:-45}"
	while [ "$retries" -gt 0 ]; do
		modem_section=
		modem_at_port=
		config_load qmodem
		config_foreach pick_modem modem-device
		[ -z "$modem_section" ] || return 0
		retries=$((retries - 1))
		sleep 1
	done
	return 1
}

find_gpio_prefix() {
	local prefix default root="${SIM_GPIO_ROOT:-/sys/class/gpio}"
	default="$(uci -q get network.globals.default_cellular 2>/dev/null)"
	for prefix in "$modem_section" "$default" cpe; do
		case "$prefix" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
		[ -w "$root/$prefix-sel0/value" ] || continue
		printf '%s\n' "$prefix"
		return 0
	done
	return 1
}

read_gpio() {
	local prefix="$1" root="${SIM_GPIO_ROOT:-/sys/class/gpio}" index=0 bit value=
	while [ -r "$root/$prefix-sel$index/value" ]; do
		read -r bit < "$root/$prefix-sel$index/value"
		case "$bit" in 0|1) value="$bit$value" ;; *) return 1 ;; esac
		index=$((index + 1))
	done
	printf '%s\n' "$value"
}

write_gpio() {
	local prefix="$1" value="$2" root="${SIM_GPIO_ROOT:-/sys/class/gpio}"
	local index=0 rest bit path
	while [ -n "$value" ]; do
		rest="${value%?}"
		bit="${value#"$rest"}"
		path="$root/$prefix-sel$index/value"
		[ -w "$path" ] || return 1
		printf '%s\n' "$bit" > "$path" || return 1
		value="$rest"
		index=$((index + 1))
	done
}

current_pid() {
	local rest
	read -r own_pid rest < /proc/self/stat
}

lock_alive() {
	local owner
	[ -r "$SIM_LOCK/pid" ] || return 1
	read -r owner < "$SIM_LOCK/pid"
	case "$owner" in ''|*[!0-9]*) return 1 ;; esac
	kill -0 "$owner" 2>/dev/null
}

release_lock() {
	local owner
	current_pid
	read -r owner < "$SIM_LOCK/pid" 2>/dev/null
	[ "$owner" = "$own_pid" ] || return 0
	rm -f "$SIM_LOCK/pid" "$SIM_LOCK/target" "$SIM_LOCK/mode"
	rmdir "$SIM_LOCK" 2>/dev/null
}

reply() {
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string message "$1"
	json_dump
}

set_status() {
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string stage "$1"
	json_add_string message "$2"
	json_add_string target "${selection_cur:-}"
	json_add_string actual "${actual_cur:-}"
	json_add_string physical_slot "${actual_slot:-}"
	json_add_string cpin "${sim_cpin:-}"
	json_add_string modem "${modem_section:-}"
	json_add_int updated "$(date +%s)"
	json_dump > "$SIM_STATE.new" && mv "$SIM_STATE.new" "$SIM_STATE"
}

fail_selection() {
	set_status error "$1"
	logger -t c2000ultra-sim-select "$1"
	return 1
}

lock_selection() {
	local cur="$1" mode="$2" mapping target held_mode created now
	case "$cur" in 1|2|3) ;; *) reply "无效卡槽"; return 1 ;; esac
	case "$mode" in ''|0|1) ;; *) reply "无效切卡模式"; return 1 ;; esac
	mapping="$(uci -q get cpesel.sim.gval)"
	resolve_target "$mapping" "$cur" >/dev/null || {
		reply "SIM 卡槽映射无效"; return 1
	}
	if ! mkdir "$SIM_LOCK" 2>/dev/null; then
		if lock_alive; then
			read -r target < "$SIM_LOCK/target" 2>/dev/null
			read -r held_mode < "$SIM_LOCK/mode" 2>/dev/null
			if [ "$cur" = "$target" ] && { [ -z "$mode" ] || [ "$mode" = "$held_mode" ]; }; then
				reply "相同切卡任务正在执行"
				return 3
			fi
			reply "正在切换其他卡槽，请等待当前任务完成"
			return 2
		fi
		# Allow the acquiring process time to create its PID file.
		created="$(stat -c %Y "$SIM_LOCK" 2>/dev/null)"
		now="$(date +%s)"
		if [ ! -s "$SIM_LOCK/pid" ] && [ -n "$created" ] && [ "$((now - created))" -lt 3 ]; then
			reply "切卡任务正在启动，请稍后重试"; return 2
		fi
		rm -f "$SIM_LOCK/pid" "$SIM_LOCK/target" "$SIM_LOCK/mode"
		rmdir "$SIM_LOCK" 2>/dev/null
		mkdir "$SIM_LOCK" 2>/dev/null || { reply "切卡任务繁忙"; return 2; }
	fi
	current_pid
	printf '%s\n' "$own_pid" > "$SIM_LOCK/pid"
	printf '%s\n' "$cur" > "$SIM_LOCK/target"
	printf '%s\n' "$mode" > "$SIM_LOCK/mode"
}

status_json() {
	local stage target actual modem busy=0 info interface ip4 ip6 live_cpin live_slot prefix gpio mapping logical
	. /usr/share/libubox/jshn.sh
	json_init
	[ ! -s "$SIM_STATE" ] || json_load "$(cat "$SIM_STATE")"
	json_get_var stage stage
	json_get_var target target
	json_get_var actual actual
	json_get_var modem modem
	[ -n "$target" ] || json_add_string target "$(uci -q get cpesel.sim.cur)"
	lock_alive && busy=1
	if [ "$busy" = 0 ]; then
		case "$stage" in
			queued|stopping|switching|checking|recovering)
				json_add_string stage error
				json_add_string message "切卡任务已中断，请重新选择卡槽"
				;;
			dialing)
				modem_section="$modem"
				modem_at_port="$(uci -q get "qmodem.$modem.override_at_port")"
				[ -n "$modem_at_port" ] || modem_at_port="$(uci -q get "qmodem.$modem.at_port")"
				if [ -c "$modem_at_port" ]; then
					info="$(tom_modem -u -t 2 -d "$modem_at_port" -o a -c 'AT+CPIN?' 2>/dev/null)"
					live_cpin="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*+CPIN:[[:space:]]*//p' | tr -d '\r' | head -n 1)"
					[ -z "$live_cpin" ] || json_add_string cpin "$live_cpin"
					if [ "$(uci -q get "qmodem.$modem.manufacturer"):$(uci -q get "qmodem.$modem.platform")" = huawei:hisilicon ]; then
						info="$(tom_modem -u -t 2 -d "$modem_at_port" -o a -c 'AT^SCICHG?' 2>/dev/null)"
						live_slot="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*\^SCICHG:[[:space:]]*\([01]\)[[:space:]]*,.*/\1/p' | head -n 1)"
						json_add_string physical_slot "$live_slot"
						prefix="$(find_gpio_prefix)"
						gpio="$(read_gpio "$prefix")"
						mapping="$(uci -q get cpesel.sim.gval)"
						actual=
						for logical in 1 2 3; do
							[ "$(resolve_target "$mapping" "$logical")" != "$gpio $live_slot" ] || actual="$logical"
						done
						json_add_string actual "$actual"
					fi
				fi
				interface=2_1
				case "$interface" in ''|*[!A-Za-z0-9_-]*) interface= ;; esac
				if [ -n "$interface" ]; then
					info="$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null)"
					if [ "$(printf '%s' "$info" | jsonfilter -e '@.up')" = true ]; then
						ip4="$(printf '%s' "$info" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
						ip6="$(printf '%s' "$info" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)"
					fi
					info="$(ubus -t 2 call "network.interface.${interface}v6" status 2>/dev/null)"
					if [ -z "$ip6" ] && [ "$(printf '%s' "$info" | jsonfilter -e '@.up')" = true ]; then
						ip6="$(printf '%s' "$info" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)"
					fi
					json_add_string ipv4 "$ip4"
					json_add_string ipv6 "$ip6"
					if [ -n "$ip4$ip6" ]; then
						json_add_string stage online
						json_add_string message "蜂窝接口已获取地址"
					else
						json_add_string message "卡槽已确认，等待蜂窝拨号获取地址"
					fi
				fi
				;;
		esac
	fi
	[ -n "$stage" ] || { json_add_string stage idle; json_add_string message "等待卡槽状态"; }
	json_add_boolean busy "$busy"
	json_dump
}

at_command() {
	tom_modem -u -t 5 -d "$modem_at_port" -o a -c "$1" 2>/dev/null
}

check_sim_ready() {
	local retries="$1" result hvsst
	while [ "$retries" -gt 0 ]; do
		if [ -c "$modem_at_port" ]; then
			result="$(at_command 'AT+CPIN?')"
			sim_cpin="$(printf '%s\n' "$result" | sed -n 's/^[[:space:]]*+CPIN:[[:space:]]*//p' | tr -d '\r' | head -n 1)"
			if [ "$manufacturer:$platform" = huawei:hisilicon ]; then
				result="$(at_command 'AT^SCICHG?')"
				actual_slot="$(printf '%s\n' "$result" | sed -n 's/^[[:space:]]*\^SCICHG:[[:space:]]*\([01]\)[[:space:]]*,.*/\1/p' | head -n 1)"
				result="$(at_command 'AT^HVSST?')"
				hvsst="$(printf '%s\n' "$result" | tr -d ' \r' | grep "^\^HVSST:1,1,$target_slot," | head -n 1)"
			else
				actual_slot="$target_slot"
				hvsst=active
			fi
			if [ "$actual_slot" = "$target_slot" ] && [ "$(read_gpio "$gpio_prefix")" = "$target_gpio" ] && [ -n "$hvsst" ]; then
				case "$sim_cpin" in
					READY) actual_cur="$selection_cur"; return 0 ;;
					'SIM PIN'|'SIM PUK') actual_cur="$selection_cur"; return 2 ;;
				esac
			fi
			set_status checking "正在核对实际卡槽与 SIM 识卡状态"
		else
			# Rediscover after reset; USB paths may return under another device node.
			wait_for_modem 1 >/dev/null 2>&1
		fi
		retries=$((retries - 1))
		sleep 2
	done
	return 1
}

apply_sim() {
	local cur="$1" mapping target target_gpio target_slot gpio_prefix payload result status retries
	local old_modem_section manufacturer platform hvsst check_result
	mapping="$(uci -q get cpesel.sim.gval)"
	target="$(resolve_target "$mapping" "$cur")" || { fail_selection "SIM 卡槽映射无效"; return 1; }
	set -- $target
	target_gpio="$1"; target_slot="$2"
	. /lib/functions.sh
	wait_for_modem || { fail_selection "模组 AT 端口未就绪"; return 1; }
	old_modem_section="$modem_section"
	config_get manufacturer "$modem_section" manufacturer
	config_get platform "$modem_section" platform
	gpio_prefix="$(find_gpio_prefix)" || { fail_selection "SIM 选择 GPIO 未就绪"; return 1; }
	set_status switching "正在切换并激活目标 SIM"
	# MT5700 manual 11.11/11.17: deactivate hardware SIM, hot switch, activate.
	if [ "$manufacturer:$platform" = huawei:hisilicon ]; then
		result="$(at_command 'AT^HVSST=1,0')"
		case "$result" in *OK*) ;; *) fail_selection "模组拒绝停用旧 SIM"; return 1 ;; esac
	fi
	write_gpio "$gpio_prefix" "$target_gpio" || { fail_selection "SIM 选择 GPIO 写入失败"; return 1; }
	payload="{\"config_section\":\"$modem_section\",\"slot\":\"$target_slot\"}"
	retries=3
	while [ "$retries" -gt 0 ]; do
		result="$(ubus -t 10 call qmodem set_sim_slot "$payload" 2>/dev/null)"
		status="$(printf '%s' "$result" | jsonfilter -e '@.status' 2>/dev/null)"
		[ "$status" = 1 ] && break
		retries=$((retries - 1)); sleep 1
	done
	[ "$status" = 1 ] || { fail_selection "模组拒绝切换物理 SIM 卡槽"; return 1; }
	if [ "$manufacturer:$platform" = huawei:hisilicon ]; then
		result="$(at_command 'AT^HVSST=1,1')"
		case "$result" in *OK*) ;; *) fail_selection "目标 SIM 激活失败"; return 1 ;; esac
	fi
	result="$(at_command 'AT+CFUN=1')"
	case "$result" in *OK*) sleep 2 ;; *) fail_selection "模组进入 online 模式失败"; return 1 ;; esac
	set_status checking "目标 SIM 已激活，等待识卡"
	check_sim_ready 20
	check_result=$?
	if [ "$check_result" = 1 ]; then
		set_status recovering "热切卡识卡未恢复，正在软复位模组"
		# Manual 6.1: CFUN=1,1 is valid only in online mode, with >1s spacing.
		result="$(at_command 'AT+CFUN=1')"
		case "$result" in *OK*) sleep 2 ;; *) fail_selection "恢复识卡前无法进入 online 模式"; return 1 ;; esac
		at_command 'AT+CFUN=1,1' >/dev/null
		sleep 3
		wait_for_modem 60 || { fail_selection "软复位后 AT 端口未恢复"; return 1; }
		# HVSST activation is not retained across modem reset.
		if [ "$manufacturer:$platform" = huawei:hisilicon ]; then
			result="$(at_command 'AT^HVSST=1,1')"
			case "$result" in *OK*) ;; *) fail_selection "软复位后目标 SIM 激活失败"; return 1 ;; esac
		fi
		check_sim_ready 30
		check_result=$?
	fi
	if [ "$check_result" = 1 ]; then
		if [ "$actual_slot" != "$target_slot" ]; then
			fail_selection "实际物理卡槽与目标不符"
		else
			fail_selection "目标 SIM 识卡超时，请检查卡片及内置卡状态"
		fi
		return 1
	fi
	if [ "$old_modem_section" != "$modem_section" ]; then
		uci -q set "qmodem.$old_modem_section.state=disabled" || return 1
	fi
	uci -q set "qmodem.$modem_section.state=enabled" &&
	uci -q commit qmodem || { fail_selection "保存模组拨号状态失败"; return 1; }
	if [ "$manufacturer" = huawei ]; then
		printf '%s\n' "$target_slot" > "/tmp/huawei_sim_slot_$modem_section"
	fi
	if [ "$check_result" = 2 ]; then
		# Let QModem apply the target card's configured PIN, never issue repeated PIN attempts here.
		set_status dialing "目标卡槽已确认，SIM 需要 PIN/PUK；等待拨号程序处理"
	else
		set_status dialing "实际卡槽与识卡已确认，正在恢复拨号"
	fi
	return 0
}

run_selection() {
	local cur="$1" booting="$2" status
	set_status stopping "正在停止旧卡拨号"
	# Stop the old worker before GPIO/AT changes; it retains the previous SIM's APN.
	/etc/init.d/qmodem_network stop >/dev/null 2>&1 || {
		fail_selection "停止旧卡拨号失败"
		return 1
	}
	apply_sim "$cur"
	status=$?
	if [ "$status" -eq 0 ]; then
		uci -q set "qmodem.$modem_section.alias=2_1" && uci -q commit qmodem || {
			fail_selection "固定蜂窝接口绑定失败"
			return 1
		}
		ubus call network reload >/dev/null 2>&1
		# QModem keeps 2_1/2_1v6 on the discovered Ultra modem's actual netdev.
		: > /var/run/c2000ultra-sim-select.ready
		[ "$booting" = 1 ] || /etc/init.d/qmodem_network start >/dev/null 2>&1 || {
			rm -f /var/run/c2000ultra-sim-select.ready
			fail_selection "启动目标卡拨号失败"
			return 1
		}
	else
		logger -t c2000ultra-sim-select "SIM selection failed; keep modem dial blocked"
	fi
	return "$status"
}

start() {
	local cur status mapping booting="$1"
	cur="$(uci -q get cpesel.sim.cur)"
	[ -n "$cur" ] || cur=1
	selection_cur="$cur"; actual_cur=; actual_slot=; sim_cpin=
	mapping="$(uci -q get cpesel.sim.gval)"
	resolve_target "$mapping" "$cur" >/dev/null || {
		fail_selection "SIM 卡槽映射无效，配置初始化未完成"
		return 1
	}
	lock_selection "$cur" || return 1
	trap 'release_lock' EXIT
	trap 'fail_selection "切卡任务被中断"; exit 1' INT TERM
	rm -f "$SIM_READY"
	set_status queued "切卡任务已启动"
	if save_selection "$cur"; then
		run_selection "$cur" "$booting"; status=$?
	else
		fail_selection "保存目标卡槽失败"; status=1
	fi
	release_lock
	trap - EXIT INT TERM
	return "$status"
}

boot() {
	# S98qmodem_network starts the worker after synchronous boot selection.
	start 1
}

select_sim() {
	local cur="$1" mode="$2" status worker
	lock_selection "$cur" "$mode"
	status=$?
	[ "$status" != 3 ] || return 0
	[ "$status" = 0 ] || return "$status"
	selection_cur="$cur"; actual_cur=; actual_slot=; sim_cpin=
	save_selection "$cur" "$mode" || {
		fail_selection "保存目标卡槽失败"
		release_lock
		reply "保存目标卡槽失败"; return 1
	}
	rm -f "$SIM_READY"
	set_status queued "切卡任务已提交"
	(
		current_pid
		printf '%s\n' "$own_pid" > "$SIM_LOCK/pid"
		trap 'release_lock' EXIT
		trap 'fail_selection "切卡任务被中断"; exit 1' INT TERM
		run_selection "$cur"
	) </dev/null >/tmp/c2000ultra-sim-select.log 2>&1 &
	worker=$!
	# The worker owns the lock before the request process exits.
	printf '%s\n' "$worker" > "$SIM_LOCK/pid"
	reply "切卡任务已提交"
	return 0
}
