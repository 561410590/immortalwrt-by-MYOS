#!/bin/sh
# 把孪生配置回收挂进 crontab(幂等),写法照 99g-mwrt-cellinfo。
#
# 光靠 hotplug 兜不住开机: 内核早期枚举的 USB 设备在 procd 的 hotplug 处理器起来
# 之前就完事了,事件直接丢 —— 这也正是 qmodem 自己要有 _try_vendor_preset_usb 的
# 原因。所以再加一条每分钟的兜底。
# 脚本首行就是闸门(没有 /usr/share/qmodem/modem_scan.sh 或 /etc/config/qmodem 就
# 立刻退出),无事可做时开销可以忽略。

CRONTAB=/etc/crontabs/root
TICK='* * * * * /usr/bin/mwrt-qmodem-usb3 >/dev/null 2>&1; /usr/bin/mwrt-qmodem-dedup >/dev/null 2>&1'

[ -x /usr/bin/mwrt-qmodem-dedup ] || exit 0

touch "$CRONTAB"

# 上一版只挂了 dedup,升级时把那行换成带 usb3 的
if grep -qF 'mwrt-qmodem-dedup' "$CRONTAB" 2>/dev/null && \
   ! grep -qF 'mwrt-qmodem-usb3' "$CRONTAB" 2>/dev/null; then
	sed -i '/mwrt-qmodem-dedup/d' "$CRONTAB"
fi

if ! grep -qF 'mwrt-qmodem-dedup' "$CRONTAB" 2>/dev/null; then
	echo "$TICK" >> "$CRONTAB"
	/etc/init.d/cron enable >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
fi

# 串行,理由同 hotplug: usb3 复位模组时它会离开总线三十来秒
(/usr/bin/mwrt-qmodem-usb3 >/dev/null 2>&1; /usr/bin/mwrt-qmodem-dedup >/dev/null 2>&1) &

exit 0
