#!/bin/sh
#
# /usr/libexec/rpcd/mwrt-wizard —— 快速向导的后端
#
# 设计约束(都是这台机器上真实踩过的坑, 不是假想):
#
#  * 绝不碰 AT 口。模组信息只读 mwrt-cellinfo 写的粘滞缓存
#    /tmp/run/mwrt/modem_info_<sec>.json。直接调 /usr/libexec/rpcd/qmodem list
#    会触发真实 AT 流量 -> tom_modem 堆积 -> PID 耗尽 -> Web 502 + SSH 失联。
#  * LED 只经 /usr/bin/mwrt-ledsched, 不写 sysfs brightness, 不动 system.led_*。
#  * 主备切换只经 Mwrt-Assurance, primary_if/secondary_if 填物理网卡名。
#    不调 mwrt_assurance_switch(没实现)。
#  * NROS 只经 /usr/sbin/myos-nros-cloudctl, 不自己启停 mosquitto/agent。
#    endpoint 和 remote_password 一律不出现在输出里。
#  * 系统切换(mwrt-bootswitch)不进统一 apply, 单独确认。
#  * 网络/无线/DHCP 的提交不在这里做 —— 那几项由前端 uci.set +
#    ui.changes.apply(true) 走 LuCI 自带的 90 秒回滚, 后端插手会绕掉回滚。
#
# 配置镜像: mwrt 和 WTMmodem 是真·两份(showtime 都不一样), CBI 的 Map("mwrt")
# 以 mwrt 为准, 但 WTMmodem 另有脚本在读。按要求两边都写。
#
# 协议: rpcd shell 插件。`list` 吐方法表, `call <method>` 从 stdin 读参数。
# 复杂入参统一走单个 payload 字符串(里面是 JSON), 免得方法表膨胀成几十个标量。

. /usr/share/libubox/jshn.sh

CACHE_DIR=/tmp/run/mwrt
APPLIED_MARK=$CACHE_DIR/wizard_applied
LEDSCHED=/usr/bin/mwrt-ledsched
BOOTSW=/usr/bin/mwrt-bootswitch
NROSCTL=/usr/sbin/myos-nros-cloudctl

u() { uci -q get "$1" 2>/dev/null; }

# 主备守护进程**本体**的个数。
#
# 不能直接 `ps w | grep -c mwrt_wan_failover`: 它是个 shell 脚本, 主循环每轮要
# uci get 八次(mwrt_wan_failover.sh:243-250), 每个命令替换 fork 出来的子 shell
# 都**继承父进程的 argv**, 于是 ps 里会短暂地多出几行 cmdline 一模一样的进程。
#
# 这个误差是用户能看见的: 前端拿这个数直接弹警告(wizard.js:1215)
#   failover_procs > 1 -> "检测到 N 个线路监测进程，建议重启设备。"
# 实测中就撞上过一次 —— 刚 redial 完紧接着再 apply, 守护进程正在为路由变化
# 忙着 fork, 后端回了 failover_procs:3, 而真正的守护进程始终只有一个
# (pid 6358, ppid 1 = procd)。等于无端劝用户去重启一台好机器。
#
# 判据: cmdline 匹配、但**父进程的 cmdline 也匹配**的, 是子 shell, 不算。
# 守护进程本体是 modeminit 直接 `&` 起来的, 父进程会是 procd/init, 不会匹配。
# 这个判据在设备上连采 30 次稳定为 1(_t_foproc_count.sh)。
#
# 用 /proc 而不是 ps: ps 的 comm 被截成 {mwrt_wan_failov}, 按全名根本匹配不上;
# 而且 ps 一行里的 cmdline 还会把本脚本自己的命令行也匹配进去(就是那个
# [x]pattern 自匹配的老坑)。/proc/<pid>/cmdline 配上"父也匹配就跳过"是干净的。
# 遍历中进程退出很正常(glob 完到 read 之间的竞态), 所以每次读都容错跳过。
failover_count() {
	local n=0 p c ppid pc
	for p in /proc/[0-9]*; do
		c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
		case "$c" in *mwrt_wan_failover*) ;; *) continue ;; esac
		ppid=$(awk '{print $4}' "$p/stat" 2>/dev/null)
		[ -n "$ppid" ] || continue
		pc=$(tr '\0' ' ' < "/proc/$ppid/cmdline" 2>/dev/null)
		case "$pc" in *mwrt_wan_failover*) continue ;; esac
		n=$((n+1))
	done
	echo "$n"
}

# 两份配置镜像写入。mwrt 为准, WTMmodem 跟着走。
# WTMmodem 里不存在的 option(USBEN / fan_driver 之类)照样写进去是安全的:
# 读它的脚本都用 `uci -q get ... || 默认值`, 多一个键不会出错, 少一个才会。
mirror_set() {
	local opt="$1" val="$2"
	uci -q set "mwrt.@ndis[0].$opt=$val" 2>/dev/null
	uci -q set "WTMmodem.@ndis[0].$opt=$val" 2>/dev/null
}

is_c2000() {
	local s
	s=$(cat /tmp/sysinfo/model /tmp/sysinfo/board_name 2>/dev/null | tr 'a-z' 'A-Z')
	case "$s" in *C2000*) return 0;; esac
	return 1
}

# 当前模组所在的 qmodem 段。只认已启用的那个, 没有就空。
modem_section() {
	local s
	for s in $(uci -q show qmodem 2>/dev/null | sed -n "s/^qmodem\.\([^.=]*\)=modem-device$/\1/p"); do
		[ "$(u qmodem.$s.state)" = "disabled" ] && continue
		echo "$s"
		return 0
	done
	return 1
}

# 内置卡(simsel=1)只有 5700 模组能用 —— 其他模组切过去等于封卡。
# 判据跟 modem5700.lua 一致: 模组名里有 5700。
is_5700() {
	local n
	n=$(u qmodem.$1.name | tr 'A-Z' 'a-z')
	case "$n" in *5700*) return 0;; esac
	return 1
}

# ── 卡槽切换的硬件动作 ────────────────────────────────────────────────────
#
# simsel 写进 uci 只是记下"想用哪个槽", 硬件一动不动。真正拨 cpe-sel0 引脚、
# 发 AT^SCICHG/^HVSST/+CFUN 的是 /usr/share/modem/mt5700m.sh。
#
# CBI 的「卡槽/UI」页(modem5700.lua:1189-1206)点"保存并应用"时就是无条件跑一次
# 这个脚本, 判据只有一条: /tmp/modconf.conf 里是 MT5700。这里按**同一条**判据,
# 不扩大到别的模组 —— 那个 CBI 里 RM520/RM500U 两个分支的 io.popen 都是注释掉
# 的状态, 它们有自己的脚本和时序, 不在这次的范围里。

is_mt5700_board() {
	[ -x /usr/share/modem/mt5700m.sh ] || return 1
	grep -q "MT5700" /tmp/modconf.conf 2>/dev/null
}

# 硬件当前**实际**在哪个槽。
#
# /tmp/sim_sel 是 mt5700m.sh 在真正切完之后才写的(它自己的 128/144/160/176 行),
# 所以它反映硬件现状, 而 uci 的 simsel 只是"上次有人写了什么"。两者会不一致:
# 设备上就撞见过 uci simsel=1(内置卡) 而 /tmp/sim_sel=0(外置槽1) —— 配置改了
# 但切卡动作从来没执行过, 正是这次要修的 bug 本身。
#
# 判据必须用硬件现状, 否则在这种不一致状态下, 用户选一个"跟 uci 相同"的值
# 会被当成没改动而跳过, 硬件永远对不上配置。
# 读不到(刚开机还没切过)就退回 uci 值, 两头都空就返回空 -> 当成需要切。
current_slot() {
	local s
	s=$(tr -d ' \t\r\n' < /tmp/sim_sel 2>/dev/null)
	[ -n "$s" ] || s=$(u mwrt.@ndis[0].simsel)
	echo "$s"
}

# 触发切卡。**必须在所有 uci commit 之后调用** —— mt5700m.sh 第 25 行是
# `sleep 2 && /sbin/uci commit`(无参数, 提交全部包), 会把还在暂存区的东西
# 一并落盘。在 method_apply 中途调它就绕掉了"出错整体 revert"的边界。
#
# 后台跑, 不等它完成: 整套动作约 30 秒(sleep 11 等模组上电 + 每个槽位两轮
# sleep 3 + chkSimExt 里两个 sleep 5), 而 rpcd 的 call 是同步的 —— 等它就是
# 让向导的"确认并执行"挂住半分钟, uhttpd 早超时了。
#
# 重复触发不会叠起来: 脚本开头自己管 /tmp/rm520n.lock, 锁在就 kill 旧 PID
# 再等 2 秒(mt5700m.sh:13-21)。
sim_switch_exec() {
	is_mt5700_board || return 1
	[ -x /usr/share/modem/mt5700m.sh ] || return 1
	/usr/share/modem/mt5700m.sh >/dev/null 2>&1 &
	return 0
}

mask_tail() {
	# 前 n 位 + 星号 + 后 4 位
	local s="$1" keep="$2" len
	len=${#s}
	[ "$len" -le $((keep + 4)) ] && { echo "$s"; return; }
	printf '%s' "$(printf '%s' "$s" | cut -c1-$keep)"
	local i=$keep
	while [ $i -lt $((len - 4)) ]; do printf '*'; i=$((i + 1)); done
	printf '%s\n' "$(printf '%s' "$s" | cut -c$((len - 3))-$len)"
}

mask_mac() {
	local m="$1"
	[ -n "$m" ] || { echo ""; return; }
	echo "$m" | awk -F: 'NF==6{printf "%s:%s:%s:**:**:%s\n",$1,$2,$3,$6;next}{print}'
}

carrier() {
	local c
	c=$(cat "/sys/class/net/$1/carrier" 2>/dev/null)
	[ -n "$c" ] && echo "$c" || echo ""
}

# 可以填进 primary_if / secondary_if 的物理网卡名。
#
# 这两个键要的是物理网卡名(eth0 / eth2 / pppoe-wan), 不是 netifd 的逻辑接口名
# (wan / lan / 2_1) —— 守护进程拿它直接去 `ip route ... dev <name>`, 填逻辑名
# 会一条路由都匹配不上, 而且不报错, 只是静默不切换。
#
# 白名单而不是黑名单: 桥、虚拟设备、各种无线 vif 混进来只会让用户选错。
phys_ifaces() {
	local d n
	for d in /sys/class/net/*; do
		n=${d##*/}
		case "$n" in
			eth*|usb*|wwan*) echo "$n" ;;
		esac
	done
	# pppoe-* 只在拨号起来之后才存在于 /sys, 但配置里要能提前选上
	uci -q show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)\.proto='pppoe'$/pppoe-\1/p"
}

#--------------------------------------------------------------------- status

method_status() {
	local sec radio ifc
	json_init

	json_add_string model "$(cat /tmp/sysinfo/model 2>/dev/null)"
	json_add_string board "$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	is_c2000 && json_add_boolean c2000 1 || json_add_boolean c2000 0
	json_add_string hostname "$(u system.@system[0].hostname)"
	json_add_string timezone "$(u system.@system[0].timezone)"
	json_add_string zonename "$(u system.@system[0].zonename)"
	json_add_string lang "$(u luci.main.lang)"
	json_add_string done_flag "$(u mwrt.wizard.done)"

	# 刚 apply 完的标记: 页面被 ui.changes.apply 的重载打断后用它回到完成页
	if [ -f "$APPLIED_MARK" ]; then
		local age now mt
		now=$(date +%s); mt=$(date -r "$APPLIED_MARK" +%s 2>/dev/null || echo 0)
		age=$((now - mt))
		[ "$age" -lt 600 ] && json_add_int applied_age "$age"
	fi

	# ---- 模组 ----
	json_add_object modem
	sec=$(modem_section)
	if [ -n "$sec" ]; then
		json_add_boolean present 1
		json_add_string section "$sec"
		json_add_string name "$(u qmodem.$sec.name)"
		json_add_string state "$(u qmodem.$sec.state)"
		json_add_string network "$(u qmodem.$sec.network)"
		json_add_string pdp_type "$(u qmodem.$sec.pdp_type)"
		json_add_string metric "$(u qmodem.$sec.metric)"
		json_add_string enable_dial "$(u qmodem.$sec.enable_dial)"
		# APN 留空 = 自动(modem_dial.sh:674 自己填 "auto"), 不要替用户编一个
		json_add_string apn "$(u qmodem.$sec.apn)"
		json_add_string force_set_apn "$(u qmodem.$sec.force_set_apn)"
		is_5700 "$sec" && json_add_boolean is5700 1 || json_add_boolean is5700 0
		json_add_string cache "$CACHE_DIR/modem_info_${sec}.json"
	else
		json_add_boolean present 0
		json_add_boolean is5700 0
	fi
	json_add_string simsel "$(max_slot)"
	# 硬件**实际**在哪个槽(读 /tmp/sim_sel, 切卡脚本切完才写)。
	# 前端拿这个而不是 simsel 来判断"用户的选择有没有变化" —— 两者会不一致,
	# 而不一致恰恰是最需要触发切卡的情形(配置改过但动作没执行过)。
	json_add_string slot_active "$(current_slot)"
	json_close_object

	# ---- 无线 ----
	json_add_array radios
	for radio in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		local iface=""
		for i in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
			[ "$(u wireless.$i.device)" = "$radio" ] || continue
			[ "$(u wireless.$i.mode)" = "ap" ] || continue
			iface="$i"; break
		done
		json_add_object ""
		json_add_string device "$radio"
		json_add_string band "$(u wireless.$radio.band)"
		json_add_string channel "$(u wireless.$radio.channel)"
		json_add_string htmode "$(u wireless.$radio.htmode)"
		json_add_string country "$(u wireless.$radio.country)"
		json_add_string radio_disabled "$(u wireless.$radio.disabled)"
		json_add_string iface "$iface"
		if [ -n "$iface" ]; then
			json_add_string ssid "$(u wireless.$iface.ssid)"
			json_add_string key "$(u wireless.$iface.key)"
			json_add_string encryption "$(u wireless.$iface.encryption)"
			json_add_string iface_disabled "$(u wireless.$iface.disabled)"
		fi
		json_close_object
	done
	json_close_array

	# ---- LAN / WAN ----
	json_add_object lan
	json_add_string ipaddr "$(u network.lan.ipaddr)"
	json_add_string netmask "$(u network.lan.netmask)"
	json_add_string start "$(u dhcp.lan.start)"
	json_add_string limit "$(u dhcp.lan.limit)"
	json_add_string leasetime "$(u dhcp.lan.leasetime)"
	json_add_string ignore "$(u dhcp.lan.ignore)"
	json_close_object

	json_add_object wan
	json_add_string proto "$(u network.wan.proto)"
	json_add_string device "$(u network.wan.device)"
	json_add_string username "$(u network.wan.username)"
	json_add_string ipaddr "$(u network.wan.ipaddr)"
	json_add_string netmask "$(u network.wan.netmask)"
	json_add_string gateway "$(u network.wan.gateway)"
	json_add_string dns "$(u network.wan.dns)"
	json_add_string carrier "$(carrier "$(u network.wan.device)")"
	json_close_object

	json_add_array ifaces
	for ifc in $(phys_ifaces | sort -u); do json_add_string "" "$ifc"; done
	json_close_array

	# ---- 主备切换 ----
	json_add_object failover
	json_add_string enabled "$(u Mwrt-Assurance.wan_failover.enabled)"
	json_add_string primary_if "$(u Mwrt-Assurance.wan_failover.primary_if)"
	json_add_string secondary_if "$(u Mwrt-Assurance.wan_failover.secondary_if)"
	json_add_string ping_target "$(u Mwrt-Assurance.wan_failover.ping_target)"
	json_add_string check_interval "$(u Mwrt-Assurance.wan_failover.check_interval)"
	json_add_string fail_threshold "$(u Mwrt-Assurance.wan_failover.fail_threshold)"
	json_add_string success_threshold "$(u Mwrt-Assurance.wan_failover.success_threshold)"
	json_add_string force_primary "$(u Mwrt-Assurance.wan_failover.force_primary)"
	json_add_int procs "$(failover_count)"
	json_close_object

	# ---- LED(原样转交 ledsched 的 status) ----
	if [ -x "$LEDSCHED" ]; then
		json_add_string led_raw "$("$LEDSCHED" status 2>/dev/null)"
	fi
	json_add_object led_cfg
	json_add_string enabled "$(u mwrt_led.main.enabled)"
	json_add_string mode "$(u mwrt_led.main.mode)"
	json_add_string starttime "$(u mwrt_led.main.starttime)"
	json_add_string endtime "$(u mwrt_led.main.endtime)"
	json_add_string manual "$(u mwrt_led.main.manual)"
	json_add_string weekdays "$(u mwrt_led.main.weekdays)"
	json_close_object

	# ---- NROS(endpoint / remote_password 一概不输出) ----
	json_add_object nros
	json_add_string local_enabled "$(u myos_nros.main.local_enabled)"
	json_add_string enabled "$(u myos_nros.main.enabled)"
	json_add_string remote_web_enabled "$(u myos_nros.main.remote_web_enabled)"
	json_add_string app_sim_swap "$(u myos_nros.main.app_sim_swap)"
	json_add_string manual_mac_masked "$(mask_mac "$(u myos_nros.main.manual_mac)")"
	json_add_boolean manual_mac_set "$([ -n "$(u myos_nros.main.manual_mac)" ] && echo 1 || echo 0)"
	json_add_string label_mac_masked "$(mask_mac "$(u oem.board.id)")"
	json_add_string imei_masked "$(mask_tail "$(u oem.board.imei)" 6)"
	json_add_string device_name "$(u oem.board.name)"
	if [ -x "$NROSCTL" ]; then
		local st
		# status 是 key=value 纯文本, 不是 JSON; 这里只取"活着没有", 不转发内容
		st=$("$NROSCTL" status 2>/dev/null)
		if echo "$st" | grep -q 'nros-app-agent'; then
			json_add_boolean agent_running 1
		else
			json_add_boolean agent_running 0
		fi
		if echo "$st" | grep -q 'mosquitto'; then
			json_add_boolean broker_running 1
		else
			json_add_boolean broker_running 0
		fi
	fi
	json_close_object

	# ---- 屏保 / USB 检测 ----
	json_add_object sysopt
	json_add_string rshowtime "$(u mwrt.@ndis[0].rshowtime)"
	json_add_string showtime "$(u mwrt.@ndis[0].showtime)"
	json_add_string USBEN "$(u mwrt.@ndis[0].USBEN)"
	json_add_string ipv6mode "$(u mwrt.@ndis[0].ipv6mode)"
	json_close_object

	# ---- 系统切换(只读, 不进 apply) ----
	if [ -x "$BOOTSW" ]; then
		json_add_string bootsw_raw "$("$BOOTSW" status 2>/dev/null)"
	fi

	json_dump
}

#--------------------------------------------------------------------- modem

# 只读粘滞缓存, 永不发 AT。缓存不在就老实说不在, 让前端显示"正在获取"。
method_modem() {
	local sec f age now mt
	json_init
	sec=$(modem_section)
	if [ -z "$sec" ]; then
		json_add_boolean ok 0
		json_add_string reason "no_modem"
		json_dump; return
	fi
	f=$CACHE_DIR/modem_info_${sec}.json
	if [ ! -f "$f" ]; then
		json_add_boolean ok 0
		json_add_string reason "no_cache"
		json_add_string section "$sec"
		json_dump; return
	fi
	now=$(date +%s); mt=$(date -r "$f" +%s 2>/dev/null || echo 0)
	age=$((now - mt))
	json_add_boolean ok 1
	json_add_string section "$sec"
	json_add_int age "$age"
	json_add_string raw "$(cat "$f" 2>/dev/null)"
	json_dump
}

#---------------------------------------------------------------------- slot

# 切卡槽。内置卡(1)只放给 5700 —— 别的模组切过去是封卡, 救不回来。
#
# 第二个参数 defer: 非空时**只写配置不执行**切卡, 由调用方自己在合适的时机调
# sim_switch_exec。method_apply 要用这个 —— 它那边 system/qmodem 还在暂存区
# 等统一提交, 而 mt5700m.sh 会无参 `uci commit` 把它们一并落盘(理由见
# sim_switch_exec 的注释)。单独调 `call slot` 时没有这个顾虑, 直接执行。
#
# 回的 JSON 多两个字段:
#   switching  —— 这次有没有真的触发硬件切卡(前端据此决定要不要提示"约 30 秒")
#   slot_from  —— 切换前硬件在哪个槽, 方便排查
method_slot() {
	local slot="$1" defer="$2" sec from
	json_init
	case "$slot" in
		0|6) ;;
		1)
			sec=$(modem_section)
			if [ -z "$sec" ] || ! is_5700 "$sec"; then
				json_add_boolean ok 0
				json_add_string error "internal_slot_not_supported"
				json_dump; return
			fi
			if ! is_c2000; then
				json_add_boolean ok 0
				json_add_string error "internal_slot_not_present"
				json_dump; return
			fi
			;;
		*)
			json_add_boolean ok 0
			json_add_string error "bad_slot"
			json_dump; return
			;;
	esac
	# 非 C2000 机型物理上只有机身槽(6), 不给它别的选择
	if ! is_c2000 && [ "$slot" != "6" ]; then
		json_add_boolean ok 0
		json_add_string error "only_body_slot"
		json_dump; return
	fi
	# 切换前硬件在哪个槽。**在写 uci 之前取** —— current_slot 读不到
	# /tmp/sim_sel 时会退回 uci 值, 写完再取就比不出差异了。
	from=$(current_slot)

	mirror_set simsel "$slot"
	uci -q commit mwrt
	uci -q commit WTMmodem

	# 硬件已经在这个槽上了就不动它: 切卡要断网重拨 30 秒, 为一个没有变化的
	# 选择付这个代价没道理。注意判据是硬件现状而不是 uci 旧值 —— 两者会不一致,
	# 见 current_slot 的注释。
	local switching=0
	if [ "$from" != "$slot" ] && is_mt5700_board; then
		if [ -z "$defer" ]; then
			sim_switch_exec && switching=1
		else
			# 延后执行: 只报告"需要切", 真正的触发由调用方做
			switching=1
		fi
	fi

	json_add_boolean ok 1
	json_add_string simsel "$slot"
	json_add_string slot_from "$from"
	json_add_boolean switching "$switching"
	json_dump
}

#----------------------------------------------------------------------- led

# 全部经 ledsched。mode: always_on / always_off / schedule
method_led() {
	local mode="$1" start="$2" end="$3" days="$4"
	json_init
	[ -x "$LEDSCHED" ] || { json_add_boolean ok 0; json_add_string error "no_engine"; json_dump; return; }

	uci -q set mwrt_led.main=sched 2>/dev/null
	case "$mode" in
		always_on)
			uci -q set mwrt_led.main.enabled=0
			uci -q commit mwrt_led
			"$LEDSCHED" on >/dev/null 2>&1
			;;
		always_off)
			uci -q set mwrt_led.main.enabled=1
			uci -q set mwrt_led.main.mode=always_off
			uci -q commit mwrt_led
			"$LEDSCHED" off >/dev/null 2>&1
			;;
		schedule)
			uci -q set mwrt_led.main.enabled=1
			uci -q set mwrt_led.main.mode=schedule
			[ -n "$start" ] && uci -q set mwrt_led.main.starttime="$start"
			[ -n "$end" ]   && uci -q set mwrt_led.main.endtime="$end"
			uci -q delete mwrt_led.main.weekdays 2>/dev/null
			local d
			for d in $days; do uci -q add_list mwrt_led.main.weekdays="$d"; done
			uci -q commit mwrt_led
			# auto 会删掉 manual, 把控制权交回定时, 再按当前时间点算一次
			"$LEDSCHED" auto >/dev/null 2>&1
			"$LEDSCHED" apply >/dev/null 2>&1
			;;
		*)
			json_add_boolean ok 0; json_add_string error "bad_mode"; json_dump; return
			;;
	esac
	json_add_boolean ok 1
	json_add_string led_raw "$("$LEDSCHED" status 2>/dev/null)"
	json_dump
}

#---------------------------------------------------------------------- nros

method_nros() {
	local enabled="$1" mac="$2" out=""
	json_init
	[ -x "$NROSCTL" ] || { json_add_boolean ok 0; json_add_string error "no_cloudctl"; json_dump; return; }

	if [ -n "$mac" ]; then
		# 交给 cloudctl 自己校验/归一化, 不在这儿重写一遍正则
		out=$("$NROSCTL" set-mac "$mac" 2>&1)
		if [ $? -ne 0 ]; then
			json_add_boolean ok 0
			json_add_string error "bad_mac"
			json_dump; return
		fi
	fi

	case "$enabled" in
		1) out="$out
$("$NROSCTL" enable 2>&1)" ;;
		0) out="$out
$("$NROSCTL" disable 2>&1)" ;;
	esac

	json_add_boolean ok 1
	json_add_string label_mac_masked "$(mask_mac "$(u oem.board.id)")"
	json_add_string manual_mac_masked "$(mask_mac "$(u myos_nros.main.manual_mac)")"
	json_add_string enabled "$(u myos_nros.main.enabled)"
	json_dump
}

#-------------------------------------------------------------------- bootsw

# 系统切换单独确认, 不进统一 apply。这里只转交, 不加自己的判断。
method_bootsw() {
	local action="$1"
	json_init
	[ -x "$BOOTSW" ] || { json_add_boolean ok 0; json_add_string error "no_bootsw"; json_dump; return; }
	case "$action" in
		status|check|to-official|to-sd) ;;
		*) json_add_boolean ok 0; json_add_string error "bad_action"; json_dump; return;;
	esac
	json_add_boolean ok 1
	json_add_string raw "$("$BOOTSW" "$action" 2>&1)"
	json_dump
}

#--------------------------------------------------------------------- apply

# 统一提交。网络/无线/DHCP 不在这里 —— 那几项前端走 ui.changes.apply(true),
# 才有 90 秒没确认就自动回滚。这里只管不会把人关在门外的那些配置。
#
# 全程先 uci set 暂存, 最后一次性 commit; 中途出错就 revert, 配置不留半截。
method_apply() {
	local payload="$1"
	local errors="" changed=""

	json_init
	json_load "$payload" 2>/dev/null || {
		json_init; json_add_boolean ok 0; json_add_string error "bad_payload"; json_dump; return
	}

	local tz zonename simsel rshowtime showtime usben
	local fo_enabled fo_primary fo_secondary fo_target
	local led_mode led_start led_end led_days
	local nros_enabled nros_mac
	local apn pdp_type enable_dial
	# 待切的卡槽。非空 = 卡槽真的要换, 统一提交之后才触发硬件动作。
	local slot_pending=""

	json_get_var tz timezone
	json_get_var zonename zonename
	json_get_var simsel simsel
	json_get_var apn apn
	json_get_var pdp_type pdp_type
	json_get_var enable_dial enable_dial
	json_get_var rshowtime rshowtime
	json_get_var showtime showtime
	json_get_var usben USBEN
	json_get_var fo_enabled fo_enabled
	json_get_var fo_primary fo_primary
	json_get_var fo_secondary fo_secondary
	json_get_var fo_target fo_target
	json_get_var led_mode led_mode
	json_get_var led_start led_start
	json_get_var led_end led_end
	json_get_var led_days led_days
	json_get_var nros_enabled nros_enabled
	json_get_var nros_mac nros_mac

	# ---- 地区 / 时区 ----
	# timezone(POSIX 串, 如 CST-8)和 zonename(Olson 名, 如 Asia/Shanghai)
	# 是两个独立字段, 各自判空各自写 —— 以前 zonename 嵌在 tz 的 if 里,
	# 前端查不到 tzstring 而留空时, zonename 会被一起丢掉。
	# changed 里加 system 的条件是「uci 真的多了暂存改动」, 不是「字段非空」 ——
	# 理由同下面蜂窝那段(前端这两项永远非空), 只是 system reload 的代价比重拨小,
	# 不至于断网, 但也没有理由每次点确认都重起一遍 syslog / 重设一次时区。
	local spre spost
	spre=$(uci changes system 2>/dev/null)
	[ -n "$tz" ]       && uci -q set system.@system[0].timezone="$tz"
	[ -n "$zonename" ] && uci -q set system.@system[0].zonename="$zonename"
	spost=$(uci changes system 2>/dev/null)
	if [ "$spre" != "$spost" ]; then
		changed="$changed system"
	fi

	# ---- 卡槽(复用 method_slot 的门控, 失败只记错不阻断其他项) ----
	#
	# 带 defer: 这里只让它写配置并判断"要不要切", 真正的硬件动作留到下面
	# 统一提交之后 —— mt5700m.sh 会无参 uci commit, 在这里跑会把 system/qmodem
	# 那些还在暂存区的改动一并落盘, 绕掉整体 revert 的边界。
	if [ -n "$simsel" ]; then
		local r
		r=$(method_slot "$simsel" defer)
		case "$r" in
			*'"ok":true'*|*'"ok": true'*)
				changed="$changed mwrt WTMmodem"
				# switching 为真才记下待切标志。
				# **不能用 changed 里有没有 mwrt 来判断** —— mwrt/WTMmodem 还有
				# rshowtime / showtime / USBEN 三个来源(都是界面显示开关), 拿它
				# 当判据的话, 用户改一下"显示运行时间"就白切一次卡、白断 30 秒网。
				case "$r" in
					*'"switching":1'*|*'"switching": 1'*|*'"switching":true'*|*'"switching": true'*)
						slot_pending="$simsel" ;;
				esac
				;;
			*) errors="$errors slot" ;;
		esac
	fi

	# ---- 蜂窝(APN / PDP / 拨号开关) ----
	#
	# 写 qmodem 的设备段, 不是 qmodem.main —— modem_dial.sh 是按 $modem_config
	# 逐段 config_get 的。APN 留空就真的删掉键, 让 modem_dial.sh 自己走 "auto";
	# 替用户编一个 APN 比不填更糟(填错直接拨不上)。
	#
	# 只改配置, 不发 AT、不碰 at_port、不重起 websocket_server。拨号生效靠
	# qmodem_network reload, 由它自己去跟模组讲话。
	#
	# changed 里加不加 qmodem, 判据是「uci 真的多了暂存改动」, 不是「字段非空」。
	#
	# 为什么必须这么判: 前端 finish() 发出来的这三项**永远非空** ——
	# apn 是 `d.apn || 'auto'`(wizard.js:1146), enable_dial 的种子值就是 '1'
	# (wizard.js:174)。于是原先 `[ -n "$apn" ] || ...` 这个条件恒真, 用户在第 3 步
	# 一个字都没改、甚至根本没留意过那一页, 点一次「确认并应用」也会走到下面的
	# qmodem_network reload, 白白断开重拨一次。
	#
	# 这台机器上代价尤其实在: eth0 无载波, 蜂窝 eth2 是唯一上行且持有默认路由,
	# 所以"白重拨一次"就是"用户的网白断一次"。真机探针实测过 (_t_redial_probe.sh):
	# 载荷 {"enable_dial":"1","apn":"auto","pdp_type":"ipv4v6"} 全是现值, 配置
	# 逐字节没变, 后端照样报 changed=qmodem 并走到 reload。
	#
	# 改成比对 uci changes 是可行的, 因为 uci 自己会去重: set 成相同值、删一个
	# 本来就不存在的键, 都**不会**产生暂存条目(都在设备上验过)。所以"配置真变了"
	# 和"暂存列表变长了"是等价的, 不需要我再手写一遍逐字段比对。
	local msec="" qpre qpost
	if [ -n "$apn" ] || [ -n "$pdp_type" ] || [ -n "$enable_dial" ]; then
		msec=$(modem_section)
		if [ -n "$msec" ]; then
			qpre=$(uci changes qmodem 2>/dev/null)
			if [ -n "$apn" ]; then
				if [ "$apn" = "auto" ]; then
					uci -q delete "qmodem.$msec.apn" 2>/dev/null
					uci -q delete "qmodem.$msec.force_set_apn" 2>/dev/null
				else
					uci -q set "qmodem.$msec.apn=$apn"
				fi
			fi
			[ -n "$pdp_type" ]    && uci -q set "qmodem.$msec.pdp_type=$pdp_type"
			[ -n "$enable_dial" ] && uci -q set "qmodem.$msec.enable_dial=$enable_dial"
			qpost=$(uci changes qmodem 2>/dev/null)
			[ "$qpre" != "$qpost" ] && changed="$changed qmodem"
		else
			# 没有可用模组段才是真错误; 用户没改蜂窝不算错误, 上面那条已经不报了。
			errors="$errors no_modem"
		fi
	fi

	# ---- 屏保 / USB 检测(两份配置都写) ----
	if [ -n "$rshowtime" ]; then mirror_set rshowtime "$rshowtime"; changed="$changed mwrt WTMmodem"; fi
	if [ -n "$showtime" ];  then mirror_set showtime  "$showtime";  changed="$changed mwrt WTMmodem"; fi
	if [ -n "$usben" ];     then mirror_set USBEN     "$usben";     changed="$changed mwrt WTMmodem"; fi

	# ---- 主备切换 ----
	if [ -n "$fo_enabled" ]; then
		uci -q set Mwrt-Assurance.wan_failover=settings 2>/dev/null
		uci -q set Mwrt-Assurance.wan_failover.enabled="$fo_enabled"
		[ -n "$fo_primary" ]   && uci -q set Mwrt-Assurance.wan_failover.primary_if="$fo_primary"
		[ -n "$fo_secondary" ] && uci -q set Mwrt-Assurance.wan_failover.secondary_if="$fo_secondary"
		[ -n "$fo_target" ]    && uci -q set Mwrt-Assurance.wan_failover.ping_target="$fo_target"
		changed="$changed Mwrt-Assurance"
	fi

	# ---- 一次性提交 ----
	local c
	for c in $(echo $changed | tr ' ' '\n' | sort -u); do
		uci -q commit "$c" || errors="$errors commit:$c"
	done

	# ---- 提交后才动服务 ----
	case " $changed " in
		*" system "*) /etc/init.d/system reload >/dev/null 2>&1 ;;
	esac

	# qmodem 改了才重载拨号, 而且必须走 redial, **不能走 reload**。
	#
	# 为什么 reload 不行(在设备上逐步坐实的, 见 _t_redial_works.sh):
	#   /etc/init.d/qmodem_network 的 reload_service -> update_modem ->
	#   _update_modem, 它只比两件事:
	#     target  = 由 state / enable_dial 推出来的"这个模组该不该拨"
	#     current = procd 里有没有 modem_<sec> 实例
	#   两边都是 1 就只 logger 一行 "current:1;target:1" 然后直接返回。
	#   也就是说 reload 只能处理"拨/不拨"的切换, 对 APN、PDP 类型这种
	#   "还是要拨, 但参数变了"的改动**完全是空转**。
	#
	# 而参数是一次性读进 shell 变量的: modem_dial.sh 的 dial() 开头调
	#   update_config(modem_dial.sh:549)把 apn/pdp_type/at_port 等 config_get
	#   进变量, 然后进 at_dial_monitor 的 `while true`(:1148)就再也不重读 uci。
	#   所以实例不重起 => 用户新填的 APN 永远不生效, 直到下次重启。
	#
	# 实测对照(同一台机器, 间隔两分钟):
	#   reload -> 实例 pid 5097 纹丝不动, 日志只有那行 current:1;target:1
	#   redial -> 实例 pid 5097 变 7542, 2 秒内完成, eth2 地址和默认路由
	#             全程没掉(采样到的断网窗口 0s)
	#
	# redial 是作者自己留的 extra_command(qmodem_network:14,66-70),
	#   redial() { hang $1; dial $1; }  —— hang 会 procd_kill 掉旧实例,
	#   dial 用 rc_procd 重开一个。仍然是作者的脚本去跟模组讲话, 我们不代劳:
	#   自己发 AT 就是 tom_modem 泄漏的起点。
	#
	# redial 要带模组段号(hang/dial 都按 $1 取段)。$msec 在上面蜂窝那段已经
	# 求过了; 但 changed 里有 qmodem 不一定意味着走过那段(以后可能有别的调用方
	# 改 qmodem), 所以这里判空后兜底再求一次。求不到段就退回 reload ——
	# 至少"拨/不拨"的切换还能生效, 比什么都不做好。
	case " $changed " in
		*" qmodem "*)
			[ -z "$msec" ] && msec=$(modem_section)
			if [ -n "$msec" ]; then
				/etc/init.d/qmodem_network redial "$msec" >/dev/null 2>&1
			else
				/etc/init.d/qmodem_network reload >/dev/null 2>&1
			fi
			;;
	esac

	# ---- 卡槽: 硬件切换 ----
	#
	# 排在这里有三个理由:
	#
	#  1) **必须在统一提交之后。** mt5700m.sh:25 是 `sleep 2 && /sbin/uci commit`
	#     —— 无参数, 提交全部包。放在提交之前就会把还在暂存区的 system/qmodem
	#     一并落盘, 绕掉 method_apply "出错就整体 revert" 的边界。
	#
	#  2) **必须在 qmodem redial 之后。** 两件事都要动模组, 顺序不能倒:
	#     redial 只要 2 秒, 它重开拨号实例、把新 APN 读进去(实例启动时
	#     update_config 一次性读完, 之后不再重读 uci);
	#     接着切卡的 AT+CFUN=0/1 会让模组重新注册, 拨号实例的 at_dial_monitor
	#     循环自己会跟上。反过来先切卡再 redial, 就会在模组正做 CFUN 循环、
	#     SIM 还没初始化完的时候去拨号, 必然失败一轮。
	#
	#  3) 放在 LED/NROS 之前也行, 但那两个是毫秒级的本地操作, 没必要让它们
	#     等在一个后台进程后面 —— 这里是 `&` 异步, 实际也不会等。
	#
	# 切卡不进 errors: 它是异步的, 这一刻只知道"进程起来了", 成功与否要 30 秒
	# 之后看 /tmp/simcardstat。前端拿 slot_switching 自己提示, 不假装已经成功。
	if [ -n "$slot_pending" ]; then
		sim_switch_exec || errors="$errors slot_exec"
	fi

	# Mwrt-Assurance 故意不重起守护进程:
	#   mwrt_wan_failover.sh 的主循环每一轮都把 8 个配置项重新 uci get 一遍
	#   (它自己的 243-250 行), 所以 commit 完下一个检测周期就生效, 不需要重起。
	#   而且它没有 init 脚本 —— 开机是 modeminit:118 直接 `&` 起来的, 没有
	#   "restart" 这回事; 自己 kill 再拉起很容易变成两个守护进程同时抢默认路由。
	#   硬性要求是"恰好 1 个", 所以这里一个进程都不动, 只在返回值里报数。
	#   (顺便: ps 里它的 comm 被截成 {mwrt_wan_failov}, killall 按全名根本匹配不上。)

	# ---- LED / NROS 各自经自己的唯一入口 ----
	[ -n "$led_mode" ] && method_led "$led_mode" "$led_start" "$led_end" "$led_days" >/dev/null 2>&1
	if [ -n "$nros_enabled" ] || [ -n "$nros_mac" ]; then
		local nr
		nr=$(method_nros "$nros_enabled" "$nros_mac")
		case "$nr" in *'"ok":false'*|*'"ok": false'*) errors="$errors nros" ;; esac
	fi

	# ---- 收尾 ----
	uci -q set mwrt.wizard=wizard
	uci -q set mwrt.wizard.done=1
	uci -q set WTMmodem.wizard=wizard 2>/dev/null
	uci -q set WTMmodem.wizard.done=1 2>/dev/null
	uci -q commit mwrt
	uci -q commit WTMmodem

	mkdir -p "$CACHE_DIR" 2>/dev/null
	date +%s > "$APPLIED_MARK" 2>/dev/null

	json_init
	[ -z "$errors" ] && json_add_boolean ok 1 || json_add_boolean ok 0
	json_add_string changed "$(echo $changed | tr ' ' '\n' | sort -u | tr '\n' ' ')"
	json_add_string errors "$errors"
	json_add_int failover_procs "$(failover_count)"
	# 卡槽是否正在切换。前端据此提示"约 30 秒、期间会断网", 而不是显示"已完成"
	# —— 切卡是异步的, 这一刻它才刚开始。
	[ -n "$slot_pending" ] && json_add_boolean slot_switching 1 \
		|| json_add_boolean slot_switching 0
	json_dump
}

#---------------------------------------------------------------------- done

# 方法名用 markdone 而不是 done: done 是 shell 关键字, 当 case 分支还好,
# 但函数名 method_done 配上它迟早有人读错, 不如一开始就避开。
method_markdone() {
	local v="$1"
	json_init
	case "$v" in 0|1) ;; *) json_add_boolean ok 0; json_add_string error "bad_value"; json_dump; return;; esac
	uci -q set mwrt.wizard=wizard
	uci -q set mwrt.wizard.done="$v"
	uci -q set WTMmodem.wizard=wizard 2>/dev/null
	uci -q set WTMmodem.wizard.done="$v" 2>/dev/null
	uci -q commit mwrt
	uci -q commit WTMmodem
	[ "$v" = "0" ] && rm -f "$APPLIED_MARK" 2>/dev/null
	json_add_boolean ok 1
	json_add_string done_flag "$v"
	json_dump
}

#------------------------------------------------------------------ dispatch


# MAX card selection goes through the existing GPIO/AT owner.
max_slot() {
    local cur
    cur=$(jsonfilter -i /var/run/c2000ultra-sim-select.status.json -e '@.actual' 2>/dev/null)
    [ -n "$cur" ] || cur=$(u cpesel.sim.cur)
    case "$cur" in 1) echo 0 ;; 2) echo 6 ;; 3) echo 1 ;; esac
}
current_slot() { max_slot; }
is_mt5700_board() { [ -x /etc/init.d/c2000ultra-sim-select ]; }
sim_switch_exec() {
    local target
    case "$(u mwrt.@ndis[0].simsel)" in 0) target=1 ;; 6) target=2 ;; 1) target=3 ;; *) return 1 ;; esac
    /etc/init.d/c2000ultra-sim-select select_sim "$target" >/dev/null 2>&1
}
method_slot() {
    local slot=$1 defer=$2 from
    json_init
    case "$slot" in 0|6|1) ;; *) json_add_boolean ok 0; json_add_string error bad_slot; json_dump; return ;; esac
    from=$(max_slot)
    mirror_set simsel "$slot"
    json_add_boolean ok 1
    json_add_string simsel "$slot"
    json_add_string slot_from "$from"
    [ "$from" = "$slot" ] && json_add_boolean switching 0 || json_add_boolean switching 1
    if [ "$defer" != defer ]; then
        uci -q commit mwrt
        uci -q commit WTMmodem
        if [ "$from" != "$slot" ]; then
            sim_switch_exec || { json_add_boolean ok 0; json_add_string error slot_exec; }
        fi
    fi
    json_dump
}

case "$1" in
	list)
		json_init
		json_add_object status;  json_close_object
		json_add_object modem;   json_close_object
		json_add_object slot;    json_add_string slot "";    json_close_object
		json_add_object led;     json_add_string mode "";    json_add_string starttime ""
		                         json_add_string endtime ""; json_add_string weekdays ""; json_close_object
		json_add_object nros;    json_add_string enabled ""; json_add_string mac "";      json_close_object
		json_add_object bootsw;  json_add_string action "";  json_close_object
		json_add_object apply;    json_add_string payload ""; json_close_object
		json_add_object markdone; json_add_string value "";   json_close_object
		json_dump
		;;
	call)
		input=$(cat)
		# 空 stdin(无参方法) 也要喂一个合法 JSON 对象给 json_load
		[ -n "$input" ] || input='{}'
		json_init
		json_load "$input" 2>/dev/null
		case "$2" in
			status) method_status ;;
			modem)  method_modem ;;
			slot)
				json_get_var a slot
				method_slot "$a"
				;;
			led)
				json_get_var a mode; json_get_var b starttime
				json_get_var c endtime; json_get_var d weekdays
				method_led "$a" "$b" "$c" "$d"
				;;
			nros)
				json_get_var a enabled; json_get_var b mac
				method_nros "$a" "$b"
				;;
			bootsw)
				json_get_var a action
				method_bootsw "$a"
				;;
			apply)
				json_get_var a payload
				method_apply "$a"
				;;
			markdone)
				json_get_var a value
				method_markdone "$a"
				;;
			*)
				json_init; json_add_boolean ok 0; json_add_string error "unknown_method"; json_dump
				;;
		esac
		;;
esac

exit 0
