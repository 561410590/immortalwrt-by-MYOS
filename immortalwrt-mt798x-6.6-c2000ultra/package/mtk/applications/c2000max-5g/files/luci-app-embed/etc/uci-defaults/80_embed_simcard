#!/bin/sh
# luci-app-embed first-install / upgrade setup.
# /etc/config/embed_simcard is pre-installed by the package.
# This script handles upgrade compatibility and service activation.

# Add webui section if missing (upgrade from older version)
uci -q get embed_simcard.webui > /dev/null 2>&1 || uci -q batch <<-EOF
	set embed_simcard.webui=webui
	commit embed_simcard
EOF

# Add at_port option if missing (upgrade from older version)
uci -q get embed_simcard.general.at_port > /dev/null 2>&1 || uci -q batch <<-EOF
	set embed_simcard.general.at_port=/dev/ttyUSB1
	commit embed_simcard
EOF

# Enable and start the GPIO restore service
if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "nradio,c2000-ultra" ] &&
   [ -x /etc/init.d/c2000ultra-sim-select ]; then
	/etc/init.d/embed_simcard disable
	/etc/init.d/c2000ultra-sim-select enable
	# S97 performs the first boot selection after ubus-at-daemon is available.
	if [ -e /var/run/c2000ultra-sim-select.ready ]; then
		/etc/init.d/c2000ultra-sim-select select_sim "$(uci -q get cpesel.sim.cur)"
	fi
else
	/etc/init.d/embed_simcard enable
	/etc/init.d/embed_simcard start
fi

exit 0
