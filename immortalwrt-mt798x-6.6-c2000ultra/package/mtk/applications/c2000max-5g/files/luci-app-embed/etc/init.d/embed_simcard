#!/bin/sh /etc/rc.common
# Restore SIM slot GPIO state from /etc/config/embed_simcard on boot

START=95
USE_PROCD=1

# Detect device model from device tree
get_model() {
	tr -d '\0' < /proc/device-tree/model 2>/dev/null || echo ''
}

apply_gpio_c8_688() {
	local slot="$1"
	case "$slot" in
		simcard1)
			echo 1 > /sys/class/gpio/cpe-sel1/value
			echo 0 > /sys/class/gpio/cpe-sel0/value
			;;
		simcard2)
			echo 1 > /sys/class/gpio/cpe-sel1/value
			echo 1 > /sys/class/gpio/cpe-sel0/value
			;;
		esimcard1)
			echo 1 > /sys/class/gpio/cpe-sel1/value
			echo 1 > /sys/class/gpio/cpe-sel0/value
			;;
		esimcard2)
			echo 0 > /sys/class/gpio/cpe-sel1/value
			echo 1 > /sys/class/gpio/cpe-sel0/value
			;;
	esac
}

# Wait until the AT serial port device file exists (modem may not be ready at boot)
wait_for_at_port() {
	local port="$1"
	local retries=15
	while [ $retries -gt 0 ]; do
		[ -c "$port" ] && return 0
		logger -t embed_simcard "Waiting for AT port $port... ($retries retries left)"
		sleep 2
		retries=$((retries - 1))
	done
	logger -t embed_simcard "AT port $port not available after waiting, aborting"
	return 1
}

# NRadio C2000-MAX/Ultra: GPIO (cpe-sel0) + AT command sequence via tom_modem
apply_gpio_C2000MAX() {
	local slot="$1"
	local at_port
	at_port=$(uci -q get embed_simcard.general.at_port)
	[ -z "$at_port" ] && at_port="/dev/ttyUSB1"

	# Ensure the AT port is available before sending any commands
	wait_for_at_port "$at_port" || return 1

	local m="/usr/bin/tom_modem -u -d $at_port"
	case "$slot" in
		simcard1)
			echo 0 > /sys/class/gpio/cpe-sel0/value
			$m -c 'AT^SCICHG=1,0'
			$m -c 'AT^HVSST=1,0'
			sleep 3
			$m -c 'AT^HVSST=1,1'
			$m -c 'AT+CFUN=0'
			sleep 3
			$m -c 'AT+CFUN=1'
			;;
		simcard2)
			echo 1 > /sys/class/gpio/cpe-sel0/value
			$m -c 'AT^SCICHG=0,1'
			$m -c 'AT^HVSST=1,0'
			sleep 3
			$m -c 'AT^HVSST=1,1'
			$m -c 'AT+CFUN=0'
			sleep 3
			$m -c 'AT+CFUN=1'
			;;
		esimcard1)
			echo 1 > /sys/class/gpio/cpe-sel0/value
			$m -c 'AT^SCICHG=1,0'
			$m -c 'AT^HVSST=1,0'
			sleep 3
			$m -c 'AT^HVSST=1,1'
			$m -c 'AT+CFUN=0'
			sleep 3
			$m -c 'AT+CFUN=1'
			;;
	esac
}

apply_gpio() {
	local slot model_str
	slot=$(uci -q get embed_simcard.general.slot)
	[ -z "$slot" ] && slot="simcard1"

	model_str=$(get_model)
	if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "nradio,c2000-ultra" ] &&
	   [ -x /etc/init.d/c2000ultra-sim-select ]; then
		local cur
		case "$slot" in
			simcard1) cur=1 ;;
			simcard2) cur=2 ;;
			esimcard1) cur=3 ;;
			*) return 1 ;;
		esac
		/etc/init.d/c2000ultra-sim-select select_sim "$cur"
		return $?
	fi
	case "$model_str" in
		*C2000-MAX*|*C2000-Ultra*) apply_gpio_C2000MAX "$slot" ;;
		*)           apply_gpio_c8_688 "$slot" ;; # default to c8-688
	esac
}

start_service() {
	apply_gpio
}

reload_service() {
	apply_gpio
}
