#!/bin/sh /etc/rc.common
# Mwrt 数据包分流 (A 方案) 开机应用。
# WiFi 接口/队列可能晚于本脚本才 up,故先应用一次,再后台补几次(幂等)。

START=99
STOP=10

boot() {
	start "$@"
}

start() {
	/usr/bin/mwrt-pktsteer.sh
	# WiFi 网卡与其 rx 队列常在开机稍后才出现,后台再补几轮以覆盖晚到的接口
	( for i in 1 2 3 4 5 6; do sleep 5; /usr/bin/mwrt-pktsteer.sh; done ) >/dev/null 2>&1 &
}

stop() {
	# 恢复默认:RPS 清零、RFS 关闭(中断亲和不强行还原,重启即复位)
	for q in /sys/class/net/*/queues/rx-*/rps_cpus; do
		[ -e "$q" ] && echo 0 > "$q" 2>/dev/null
	done
	echo 0 > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null
}
