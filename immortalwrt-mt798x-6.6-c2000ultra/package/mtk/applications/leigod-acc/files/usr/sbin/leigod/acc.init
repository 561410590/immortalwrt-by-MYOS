#!/bin/sh /etc/rc.common
# runtime/acc.init — OpenWrt procd init 脚本
# 部署到 /etc/init.d/acc。读 acc_firewall.ini 的 mode/backend/tproxy_ip 拼启动参数。
# 设计6：start_service 内嵌 ensure_modules_loaded，开机首启不依赖 monitor。

START=50
USE_PROCD=1

BINARY_PREFIX="acc-gw.router"
FIREWALL_INI="/etc/config/acc_firewall.ini"
ACC_LOG="/tmp/leigod_acc_init.log"

init_log() {
    printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >> "${ACC_LOG}" 2>/dev/null
}

# 读 acc_firewall.ini 字段
read_field() {
    local field="$1"
    [ -f "${FIREWALL_INI}" ] || return 1
    grep "^${field}=" "${FIREWALL_INI}" | head -1 | cut -d'=' -f2-
}

# 确保内核模块已加载（设计6，与 lib/setup.sh 同逻辑，独立内联避免依赖）
ensure_modules_loaded() {
    local mode modules m
    mode=$(read_field mode 2>/dev/null)
    [ -n "${mode}" ] || mode="tproxy"

    if [ "${mode}" = "tproxy" ]; then
        modules="xt_TPROXY nf_tproxy_core xt_set ip_set ip_set_hash_net ip_set_list_set"
    else
        modules="tun"
    fi

    for m in ${modules}; do
        if ! lsmod 2>/dev/null | grep -q "^${m} "; then
            modprobe "${m}" >/dev/null 2>&1 || init_log "modprobe ${m} 失败"
        fi
    done
}

# 探测架构（独立内联，init 不依赖 install 阶段的 ARCH）
get_arch() {
    local raw
    raw=$(uname -m 2>/dev/null)
    case "${raw}" in
        x86_64) echo "amd64" ;;
        aarch64|aarch64_be) echo "arm64" ;;
        mips|mips64) echo "mipsel" ;;
        armv7l|armv7hl|armv6l|armv5tel) echo "arm" ;;
        *) echo "${raw}" ;;
    esac
}

start_service() {
    local sbin_dir="/usr/sbin/leigod"
    local mode backend tproxy_ip args arch

    # 设计6：启动前确保模块已加载（开机首次启动 procd 触发，monitor 可能未起）
    ensure_modules_loaded

    mode=$(read_field mode 2>/dev/null)
    backend=$(read_field backend 2>/dev/null)
    tproxy_ip=$(read_field tproxy_ip 2>/dev/null)
    if [ -z "${mode}" ]; then
        init_log "启动失败: ${FIREWALL_INI} 无 mode 字段"
        return 1
    fi
    arch=$(get_arch)

    args="-r daemon -m ${mode} -p 5588"
    [ "${mode}" = "tproxy" ] && args="${args} -l ${tproxy_ip:-10.20.30.40}"

    init_log "启动 acc: ${sbin_dir}/${BINARY_PREFIX}.${arch} ${args}"

    procd_open_instance
    procd_set_param command "${sbin_dir}/${BINARY_PREFIX}.${arch}" ${args}
    procd_set_param respawn
    procd_close_instance

    procd_open_instance
    procd_set_param command "${sbin_dir}/acc_upgrade_monitor" -r upgrade
    procd_set_param respawn
    procd_close_instance
}

# 遍历 /proc 返回所有 cmdline 含 <pattern> 的 pid。
# 不用 killall：acc-gw.router.<arch> 为 19 字符，内核 comm 截断为 15 字符
# （如 acc-gw.router.a），killall 按 comm 匹配找不到。cmdline 不截断，可靠。
_find_pids_by_cmdline() {
    local pattern="$1" p cmdline
    for p in /proc/[0-9]*; do
        [ -r "${p}/cmdline" ] || continue
        cmdline=$(tr '\0' ' ' < "${p}/cmdline" 2>/dev/null) || continue
        case "${cmdline}" in
            *"${pattern}"*) basename "${p}" ;;
        esac
    done
}

# 清理加速防火墙规则（停服必须清，否则流量仍被重定向到已停代理 → 被加速设备断网）。
# 与引擎 IPTablesMgr/NftableMgr 对齐：nft 整表一把删；iptables 链没法一把删
# （-X 有两个硬前提：链内无规则 -F、无跳转引用 -D），每表固定三步，顺序不能乱。
# 禁止 `nft flush ruleset`（会清空整机防火墙）。
_clean_acc_rules() {
    local chain="GAMEACC" tbl built name
    for tbl in mangle filter nat; do
        case "${tbl}" in filter) built="INPUT" ;; *) built="PREROUTING" ;; esac
        iptables -t ${tbl} -D ${built} -j ${chain} 2>/dev/null
        iptables -t ${tbl} -F ${chain} 2>/dev/null
        iptables -t ${tbl} -X ${chain} 2>/dev/null
    done
    nft delete table inet tproxy_table 2>/dev/null
    for name in $(ipset list -n 2>/dev/null); do
        case "${name}" in
            direct_*|target_*|proxy_*) ipset destroy "${name}" 2>/dev/null ;;
        esac
    done
}

stop_service() {
    local arch pat pid
    arch=$(get_arch)
    # 先清规则再杀进程：规则删除后流量立即回正常路由，消除断网窗口
    _clean_acc_rules
    for pat in "${BINARY_PREFIX}.${arch}" acc_upgrade_monitor; do
        for pid in $(_find_pids_by_cmdline "${pat}"); do
            kill -9 "${pid}" 2>/dev/null
        done
    done
    init_log "已停止 acc 并清理加速规则"
}
