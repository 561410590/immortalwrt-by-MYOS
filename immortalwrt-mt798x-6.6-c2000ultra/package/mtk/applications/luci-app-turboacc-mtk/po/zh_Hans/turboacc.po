msgid "Turbo ACC Center"
msgstr "硬件加速"

msgid "Turbo ACC Acceleration Settings"
msgstr "硬件加速设置"

msgid "Opensource Flow Offloading driver (Fast Path or Hardware NAT)"
msgstr "管理快速转发与原生硬件 NAT 加速。"

msgid "MediaTek HNAT"
msgstr "联发科 HNAT 硬件加速"

msgid "Use native MediaTek hardware routing/NAT acceleration without nftables software flow offloading."
msgstr "使用联发科原生路由与 NAT 硬件加速，不与 nftables 软件流量分载混用。"

msgid "IPv6 hardware acceleration"
msgstr "IPv6 硬件加速"

msgid "Synchronize hardware counters"
msgstr "同步硬件流量计数到连接跟踪"

msgid "DSCP priority mapping"
msgstr "DSCP 优先级映射"

msgid "Keep current driver setting"
msgstr "保持当前驱动设置"

msgid "Enabled"
msgstr "启用"

msgid "Disabled"
msgstr "禁用"

msgid "HNAT bind rate threshold (pps)"
msgstr "HNAT 连接绑定阈值（包/秒）"

msgid "The smaller the threshold, the easier it is for the connection to be accelerated."
msgstr "阈值越小，连接越容易进入硬件加速。有效范围为 1 至 30。"

msgid "Hardware QoS mode"
msgstr "硬件 QoS 模式"

msgid "Bidirectional HQoS"
msgstr "双向硬件 QoS"

msgid "Uplink HQoS"
msgstr "仅上行硬件 QoS"

msgid "Downlink HQoS"
msgstr "仅下行硬件 QoS"

msgid "Per-port queues"
msgstr "按端口分配队列"

msgid "Wireless HNAT settings"
msgstr "无线 HNAT 设置"

msgid "Open wireless settings"
msgstr "打开无线设置"

msgid "Software flow offloading"
msgstr "软件流量分载"

msgid "Software based offloading for routing/NAT"
msgstr "使用软件快速转发路由与 NAT 流量。"

msgid "Hardware flow offloading"
msgstr "硬件流量分载"

msgid "Requires hardware NAT support, implemented at least for mt762x"
msgstr "需要设备支持硬件 NAT。"

msgid "MTK WED WO offloading"
msgstr "联发科 WED 无线加速"

msgid "Requires hardware support, implemented at least for Filogic 8x0"
msgstr "需要相应无线驱动及硬件支持。"

msgid "Shortcut-FE flow offloading"
msgstr "Shortcut-FE 快速转发"

msgid "Shortcut-FE based offloading for routing/NAT"
msgstr "使用 Shortcut-FE 转发路由与 NAT 流量。"

msgid "FullCone NAT"
msgstr "全锥形 NAT"

msgid "Using FullCone NAT can improve gaming performance effectively"
msgstr "全锥形 NAT 可改善部分游戏的连接兼容性。"

msgid "IPv6 Full Cone NAT"
msgstr "IPv6 全锥形 NAT"

msgid "Enabling IPv6 Full Cone NAT adds an extra layer of NAT to IPv6. In IPv6, if you obtain an IPv6 prefix through IPv6 Prefix Delegation, each device can be assigned a public IPv6 address, eliminating the need for IPv6 Full Cone NAT."
msgstr "此功能会给 IPv6 增加一层 NAT。若已取得 IPv6 前缀委派，可为终端分配公网 IPv6 地址，无需启用此功能。"

msgid "BBR CCA"
msgstr "BBR 拥塞控制"

msgid "Using BBR CCA can improve TCP network performance effectively"
msgstr "使用 BBR 拥塞控制算法改善设备自身的 TCP 传输。"

msgid "Running Status"
msgstr "运行状态"

msgid "Flow Offloading"
msgstr "流量加速引擎"

msgid "MTK WED driver"
msgstr "WED 无线加速驱动"

msgid "Collecting data..."
msgstr "正在读取状态..."

msgid "Status request failed"
msgstr "状态读取失败"

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Loaded"
msgstr "已加载"

msgid "Not loaded"
msgstr "未加载"

msgid "Driver presence does not prove that traffic is offloaded."
msgstr "驱动已加载不等于当前连接已经进入硬件加速。"
