#!/bin/sh

# Enable remote access once when upgrading the old online-only defaults.
[ "$(uci -q get myos_nros.main.remote_access_version 2>/dev/null)" = "2" ] && exit 0
[ -f /etc/config/myos_nros ] || touch /etc/config/myos_nros
uci -q set myos_nros.main='cloud'
uci -q set myos_nros.main.local_enabled='1'
uci -q set myos_nros.main.enabled='1'
uci -q set myos_nros.main.remote_web_enabled='1'
uci -q set myos_nros.main.remote_ssh_enabled='1'
uci -q set myos_nros.main.remote_access_version='2'
uci -q commit myos_nros
/etc/init.d/myos-nros-mqtt enable >/dev/null 2>&1 || true
/etc/init.d/myos-nros-app enable >/dev/null 2>&1 || true
exit 0
