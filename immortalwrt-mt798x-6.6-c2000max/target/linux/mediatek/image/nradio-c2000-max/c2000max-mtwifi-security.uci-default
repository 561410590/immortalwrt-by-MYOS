#!/bin/sh

. /lib/functions.sh

source_js="/rom/usr/share/luci-app-mtwifi-cfg/wireless-mtk.js"
target_js="/www/luci-static/resources/view/network/wireless.js"
migrated=0

migrate_legacy_ap_psk() {
	local section="$1" mode encryption

	config_get mode "$section" mode
	config_get encryption "$section" encryption
	[ "$mode" = "ap" ] || return 0
	[ "$encryption" = "psk" ] || return 0

	uci -q set "wireless.${section}.encryption=psk2" || return 0
	migrated=1
}

config_load wireless
config_foreach migrate_legacy_ap_psk wifi-iface
if [ "$migrated" = 1 ]; then
	uci -q commit wireless
	logger -t c2000max-wifi "migrated legacy WPA1 AP encryption to WPA2"
fi

[ -f "$source_js" ] || source_js="/usr/share/luci-app-mtwifi-cfg/wireless-mtk.js"
[ -f "$source_js" ] || exit 0
mkdir -p "${target_js%/*}" || exit 1
cp -f "$source_js" "$target_js" || exit 1
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache

exit 0
