#!/bin/sh
#
# /usr/libexec/rpcd/luci.mwrt-notice —— 右上角全局消息中心的数据源
#
# 页面每 10 秒问一次, 所以只读文件和 sysfs: 不发 AT、不联网、不 fork 重活。
# 每条消息: id(稳定标识, 前端按它去重、记已读), level(critical|warn|info),
#   closable(用户能否关掉), text, link(可选, 前端映射成页面地址)。
#
# 现有来源(SIM 和 USB 两条只认 MT5700, 其他模组一律不出):
#   usb3     刷机后第一次开机模组落在 USB2.0(1-1), mwrt-qmodem-usb3 正在把它
#            复位到 3.0(2-1)。判据和那个脚本完全一致: 一次性重训还没用掉
#            (ONCE 标记 != 本镜像), 且模组在 HS 上, 或者已发过复位正离开总线。
#   siminit  mt5700m.sh 正在初始化 SIM 卡(它的锁还活着, 或 simcardstat 停在
#            初始化态), 且模组对应的网口还没拨上。
#   ota      cron 已经查到新固件(读 luci.mwrt-ota 的缓存, 不联网)。
#
# reboot_gate: 重启页用。usb3 那条成立时不让重启 —— 复位做到一半重启, 模组会
#   带着半截状态回来。开机超过 GATE_MAX 秒还没好, 说明重训卡住了(正常最多
#   六分钟左右, 见 mwrt-qmodem-usb3), 就不再算"切换中", 不拦也不提示。

. /usr/share/libubox/jshn.sh

MT5700_ID="3466:3301"
USBDEV=/sys/bus/usb/devices
ONCE=/etc/mwrt-qmodem-usb3.done
TRIES=/tmp/mwrt-qmodem-usb3.tries
SIMLOCK=/tmp/rm520n.lock
SIMSTAT=/tmp/simcardstat
OTA_LATEST=/tmp/myos-update/state.json
GATE_MAX=900
USB3_BOOT_SETTLE=120
USB3_MAX_TRIES=2
WLB_EVENT=/tmp/mwrt-wlbridge.event
WLB_EVENT_TTL=180
# 开机后 mt5700m.sh 还没起来(simcardstat 尚不存在)的这段也算初始化中
SIM_BOOT_WINDOW=300

TXT_USB3='检测到首次刷机，模组初始化在USB2.0，正在切换为3.0通道，网络可能会断开1分钟。'
TXT_SIMINIT='SIM卡正在初始化，目前未拨号。'
TXT_GATE='检测到首次刷机，模组正在从USB2.0切换为3.0通道。请稍等约两分钟再重启，否则可能影响模组使用。'

uptime_s() {
	local u
	u="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
	case "$u" in ''|*[!0-9]*) u=0 ;; esac
	echo "$u"
}

# 与 mwrt-qmodem-usb3 的 find_modem 相同
find_modem() {
	local d
	for d in "$USBDEV"/[0-9]-[0-9]*; do
		[ -d "$d" ] || continue
		case "$(basename "$d")" in *:*) continue ;; esac
		[ "$(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null)" = "$MT5700_ID" ] || continue
		basename "$d"
		return 0
	done
	return 1
}

# 与 mwrt-qmodem-usb3 的 image_id 相同, 两边必须一起改
image_id() {
	local b d
	b="$(sed -n 's/^BUILD_ID="\(.*\)"$/\1/p' /usr/lib/os-release 2>/dev/null)"
	d="$(sed -n 's/^OPENWRT_BUILD_DATE="\(.*\)"$/\1/p' /usr/lib/os-release 2>/dev/null)"
	[ -n "$b$d" ] || b="$(cat /etc/openwrt_version 2>/dev/null)"
	echo "${b:-unknown}-$d"
}

usb3_pending() {
	[ -x /usr/bin/mwrt-qmodem-usb3 ] || return 1
	local slot speed
	[ "$(uptime_s)" -lt "$GATE_MAX" ] || return 1
	[ "$(cat "$ONCE" 2>/dev/null)" = "$(image_id)" ] && return 1
	if slot="$(find_modem)"; then
		speed="$(cat "$USBDEV/$slot/speed" 2>/dev/null)"
		case "$speed" in 480|12|1.5) return 0 ;; esac
		return 1
	fi
	# 不在总线上: 只有已经发过复位(计数文件在)才是"切换途中"
	[ -s "$TRIES" ]
}

sim_initializing() {
	[ -x /usr/share/modem/mt5700m.sh ] || return 1
	local slot pid st mt busy=0
	slot="$(find_modem)" || return 1

	pid="$(cat "$SIMLOCK" 2>/dev/null)"
	case "$pid" in ''|*[!0-9]*) ;; *) [ -d "/proc/$pid" ] && busy=1 ;; esac

	if [ -f "$SIMSTAT" ]; then
		# 只认最近 SIM_BOOT_WINDOW 秒内写的: mt5700m.sh 被杀在半路时文件会一直停在
		# "SIM INIT...", 不能让一条关不掉的消息永远挂着
		mt="$(date -r "$SIMSTAT" +%s 2>/dev/null)"
		case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
		if [ $(( $(date +%s) - mt )) -lt "$SIM_BOOT_WINDOW" ]; then
			st="$(cat "$SIMSTAT" 2>/dev/null)"
			case "$st" in 'SIM INIT...'|*正在初始化*) busy=1 ;; esac
		fi
	else
		[ "$(uptime_s)" -lt "$SIM_BOOT_WINDOW" ] && busy=1
	fi
	[ "$busy" = 1 ] || return 1

	# 已经拨上就不是"未拨号"了。qmodem 的网口段名就是槽位名(2-1 -> 2_1)
	[ "$(ifstatus "$(echo "$slot" | sed 's/[.:-]/_/g')" 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)" = "true" ] && return 1
	return 0
}

add_notice() {
	json_add_object
	json_add_string id "$1"
	json_add_string level "$2"
	json_add_boolean closable "$3"
	json_add_string text "$4"
	[ -n "$5" ] && json_add_string link "$5"
	[ -n "$6" ] && json_add_int progress "$6"
	json_close_object
}

wlb_event_notice() {
	[ -s "$WLB_EVENT" ] || return
	local line ts kind ssid now age
	read -r line < "$WLB_EVENT" 2>/dev/null
	ts="${line%%|*}"
	kind="${line#*|}"; ssid="${kind#*|}"; kind="${kind%%|*}"
	[ -n "$ts" ] || return
	case "$ts" in *[!0-9]*) return ;; esac
	now="$(date +%s)"
	age=$((now - ts))
	[ "$age" -ge 0 ] && [ "$age" -le "$WLB_EVENT_TTL" ] || return
	if [ "$kind" = "up" ]; then
		add_notice "wlbridge-up-$ts" info 1 "已通过无线网桥接入「${ssid:-上游 WiFi}」，网络出口已切换。"
	elif [ "$kind" = "down" ]; then
		add_notice "wlbridge-down-$ts" info 1 "已断开无线网桥「${ssid:-上游 WiFi}」，网络出口已切回原线路。"
	fi
}

# s64: USB2→3 切换进度(0-100)。从切换脚本留下的标记文件和模组当前速率折算, 阶段:
#   等开机判型($TRIES.wait 在、还没复位): uptime 0→BOOT_SETTLE 映射 0→22%;
#   复位重训($TRIES=n): 每次一段, n=1→~55%、n=2→~88%(复位中模组掉总线再给一点);
#   已放弃($TRIES.done): 95%(马上收尾, 保留 HS 链路)。
# 封顶 95 —— 真到 SuperSpeed 后 usb3_pending 直接不成立, 整条通知消失, 不走到 100。
usb3_progress() {
	local n up
	[ -f "$TRIES.done" ] && { echo 95; return; }
	n=0; [ -f "$TRIES" ] && n="$(cat "$TRIES" 2>/dev/null)"
	case "$n" in *[!0-9]*) n=0 ;; esac
	if [ "$n" -ge 1 ]; then
		# 25% 起步, 每次重训占 (90-25)/MAX_TRIES; 复位时模组不在总线上, 多给 8% 表示正在动
		local base step pr
		step=$(( (90 - 25) / USB3_MAX_TRIES ))
		base=$(( 25 + (n - 1) * step ))
		pr=$(( base + step / 2 ))
		find_modem >/dev/null 2>&1 || pr=$(( base + step - 2 ))
		[ "$pr" -gt 94 ] && pr=94
		echo "$pr"; return
	fi
	# 还没复位: 按 uptime 在开机判型窗口里爬 0→22
	up="$(uptime_s)"
	local pr=$(( up * 22 / USB3_BOOT_SETTLE ))
	[ "$pr" -lt 3 ] && pr=3
	[ "$pr" -gt 22 ] && pr=22
	echo "$pr"
}

# 进度阶段对应的中文说明(文案跟着阶段走, 比死字符串更有信息)
usb3_text() {
	[ -f "$TRIES.done" ] && { printf '仅首次开机：模组通道切换收尾中，若仍为2.0将保持当前链路，请勿断电。'; return; }
	local n=0; [ -f "$TRIES" ] && n="$(cat "$TRIES" 2>/dev/null)"
	case "$n" in *[!0-9]*) n=0 ;; esac
	if [ "$n" -ge 1 ]; then
		printf '仅首次开机：正在复位模组切换USB3.0通道（第%s/%s次），网络会短暂断开，请勿断电。' "$n" "$USB3_MAX_TRIES"
	else
		printf '仅首次开机：模组初始化在USB2.0，正在等待开机检测完成后切换3.0通道，请勿断电。'
	fi
}

m_list() {
	local v
	json_init
	json_add_array notices
	usb3_pending && add_notice usb3 critical 0 "$(usb3_text)" "" "$(usb3_progress)"
	sim_initializing && add_notice siminit warn 0 "$TXT_SIMINIT"
	wlb_event_notice
	if [ -s "$OTA_LATEST" ] && [ "$(jsonfilter -i "$OTA_LATEST" -e '@.available' 2>/dev/null)" = "true" ]; then
		v="$(jsonfilter -i "$OTA_LATEST" -e '@.latest' 2>/dev/null)"
		[ -n "$v" ] && add_notice "ota-$v" info 1 "发现新固件 v$v" ota
	fi
	json_close_array
	json_dump
}

m_reboot_gate() {
	json_init
	if usb3_pending; then
		json_add_boolean block 1
		json_add_string reason "$TXT_GATE"
	else
		json_add_boolean block 0
	fi
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object list; json_close_object
		json_add_object reboot_gate; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			list) m_list ;;
			reboot_gate) m_reboot_gate ;;
			*) echo '{"error":"unknown method"}' ;;
		esac
		;;
esac
