#!/bin/sh

uci -q set at-webserver.config.enabled='1'
uci -q set at-webserver.config.connection_type='SERIAL'
uci -q set at-webserver.config.serial_port='/dev/ttyUSB1'
uci -q set at-webserver.config.serial_baudrate='115200'
uci -q set at-webserver.config.serial_timeout='10'
uci -q set at-webserver.config.serial_method='TOM_MODEM'
uci -q set at-webserver.config.serial_feature='UBUS'
uci -q set at-webserver.config.use_ubus='1'
uci -q commit at-webserver
uci -q set qmodem.main.use_ubus='1'
uci -q commit qmodem
/etc/init.d/ubus-at-daemon disable >/dev/null 2>&1
/etc/init.d/ubus-at-daemon enable >/dev/null 2>&1
/etc/init.d/at-webserver enable >/dev/null 2>&1

exit 0
