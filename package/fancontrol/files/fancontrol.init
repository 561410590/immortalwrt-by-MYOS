#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1

NAME=fancontrol
PROG=/usr/bin/$NAME

start_service() {
    config_load "$NAME"

    local enabled
    config_get enabled settings enabled
    [ "$enabled" = "1" ] || { logger -t fancontrol "Instance \"$NAME\" disabled."; return 0; }

    local thermal_file
    local fan_file
    local start_temp
    local start_speed
    local max_temp
    local max_speed
    local temp_div
    local interval
    local candidate

    config_get thermal_file settings thermal_file
    config_get fan_file settings fan_file
    config_get start_temp settings start_temp
    config_get start_speed settings start_speed
    config_get max_temp settings max_temp
    config_get max_speed settings max_speed
    config_get temp_div settings temp_div
    config_get interval settings interval

    if [ ! -e "$fan_file" ]; then
        for candidate in /sys/bus/platform/devices/pwm-fan/hwmon/hwmon*/pwm1; do
            [ -e "$candidate" ] || continue
            fan_file="$candidate"
            break
        done
    fi
    [ -e "$thermal_file" ] && [ -e "$fan_file" ] || {
        logger -t fancontrol "Thermal or PWM sysfs node missing."
        return 1
    }

    procd_open_instance
    procd_set_param command $PROG
    [ -n "$thermal_file" ] && procd_append_param command -T "$thermal_file"
    [ -n "$fan_file" ] && procd_append_param command -F "$fan_file"
    [ -n "$start_temp" ] && procd_append_param command -t "$start_temp"
    [ -n "$start_speed" ] && procd_append_param command -s "$start_speed"
    [ -n "$max_temp" ] && procd_append_param command -x "$max_temp"
    [ -n "$max_speed" ] && procd_append_param command -m "$max_speed"
    [ -n "$temp_div" ] && procd_append_param command -d "$temp_div"
    [ -n "$interval" ] && procd_append_param command -i "$interval"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}

start() {
    start_service
}

stop() {
    procd_kill_instance
}

reload() {
    procd_reload_instance
}

service_triggers() {
    procd_add_reload_trigger "fancontrol"
}
