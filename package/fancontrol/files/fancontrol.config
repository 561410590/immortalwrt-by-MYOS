config fancontrol settings
    option enabled '1'
    option thermal_file '/sys/devices/virtual/thermal/thermal_zone0/temp'
    option fan_file '/sys/bus/platform/devices/pwm-fan/hwmon/hwmon1/pwm1'
    option start_temp '50'
    option start_speed '128'
    option max_temp '78'
    option max_speed '255'
    option temp_div '1000'
    option interval '5'
