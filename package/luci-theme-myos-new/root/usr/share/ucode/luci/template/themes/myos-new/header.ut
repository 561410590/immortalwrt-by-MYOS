{%
 const board = ubus.call('system', 'board') ?? {};
 const model = replace(lc(board.model ?? ''), /[^a-z0-9]/g, '');
 const device = replace(lc(board.board_name ?? ''), /[^a-z0-9]/g, '');
 const compact = model in ['c5800688', 'nradioc5800688', 'c8688', 'nradioc8688',
                           'c8new688', 'nradioc8new688', 'nbcpe688', 'nradionbcpe688', 'nradionb68no2'] ||
                  device in ['nradioc5800688', 'hcmt7981688emmc', 'nradiowt9104no2manpernew688',
                            'hcmt7981emmcnb68', 'nradionbcpe688', 'nradiowt9111no2manpernb68'];
 const submenu = compact && !blank_page && !(join('/', ctx.path ?? []) in ['admin/embedded/simcard', 'admin/modem/qmodem/sim_switch']);
 const show_support_links = !(model in ['c5800688', 'nradioc5800688', 'c8688', 'nradioc8688',
                                       'c8new688', 'nradioc8new688', 'nbcpe688', 'nradionbcpe688', 'nradionb68no2'] ||
                             device in ['nradioc5800688', 'hcmt7981688emmc', 'nradiowt9104no2manpernew688',
                                        'hcmt7981emmcnb68', 'nradionbcpe688']);
 const color = uci.get('myos_appearance', 'main', 'background_color') ?? '';
 let login_video = '';
 if (model in ['c2000ultra', 'nradioc2000ultra'] || device == 'nradioc2000ultra')
  login_video = 'c2000-ultra-promo.mp4';
 else if (model in ['c5800688', 'nradioc5800688'] || device == 'nradioc5800688')
  login_video = 'c5800-688-login.mp4';
 else if (model in ['c8688', 'nradioc8688', 'c8new688', 'nradioc8new688'] ||
          device in ['hcmt7981688emmc', 'nradiowt9104no2manpernew688'])
  login_video = 'c8-688-login.mp4';
 http.prepare_content('text/html; charset=UTF-8');
-%}
<!doctype html>
<html lang="{{ dispatcher.lang }}" data-myos-motion="smooth" data-appearance="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f5f5f7">
<title>MYOS-NEW · {{ entityencode(board.hostname ?? 'OpenWrt') }}</title>
<link rel="icon" type="image/png" href="{{ media }}/brand.png?v=2">
<link rel="apple-touch-icon" href="{{ media }}/brand.png?v=2">
<script>
document.documentElement.dataset.glass = matchMedia('(prefers-contrast:more), (prefers-reduced-transparency:reduce)').matches ? 'solid' : 'frosted';
document.documentElement.dataset.appearance = 'light';
try {
 if (localStorage.getItem('myos-new-appearance') === 'dark')
  document.documentElement.dataset.appearance = 'dark';
} catch (_) {}
document.querySelector('meta[name="theme-color"]').content = document.documentElement.dataset.appearance === 'dark' ? '#090a0c' : '#edf0f4';
</script>
<link rel="stylesheet" href="{{ media }}/style.css?v=20261111-allmodels1">
<link rel="stylesheet" href="{{ media }}/liquid.css?v=20261105-black-frost">
<link rel="stylesheet" href="{{ media }}/refine.css?v={{ board.model == 'NRadio-C5800-688' ? '20261115-c5800-overview-wan-quality2-c5800-wan1' : '20261114-c8-feedback2-wan-quality2' }}{{ join('/', ctx.path ?? []) == 'admin/myos' ? (board.model == 'NRadio-C5800-688' ? '-c5800-density2-tablet1-outlet3-readout1' : (compact ? '-home-density1-tablet1-outlet1-readout1' : '-home-density1-tablet1-readout1')) : '' }}{{ board.model == 'NRadio-C5800-688' && join('/', ctx.path ?? []) == 'admin/network/wireless' ? '-stations2' : '' }}{{ submenu ? '-submenu1' : '' }}{{ !(join('/', ctx.path ?? []) in ['admin/embedded/simcard', 'admin/modem/qmodem/sim_switch']) ? '-views20261120-nav3' : '' }}{{ join('/', ctx.path ?? []) == 'admin/myos' ? '-iface-links1' : '' }}-page-polish2{{ submenu ? '-status-system1' : '' }}">
{% if (node?.css): %}<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">{% endif %}
{% if (css): %}<style>{{ css }}</style>{% endif %}
<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
<script src="{{ resource }}/cbi.js"></script>
</head>
<body class="myos-new{% if (submenu): %} m-submenu-compact{% endif %}{% if (blank_page): %} m-auth{% endif %}" data-home="{{ dispatcher.build_url('admin/myos') }}" data-device-model="{{ entityencode(board.model ?? '', true) }}" data-device-board="{{ entityencode(board.board_name ?? '', true) }}" data-background-color="{{ entityencode(color, true) }}"{% if (login_video): %} data-login-video="{{ login_video }}" data-login-video-enabled="{{ uci.get('myos_appearance', 'main', 'login_video') == '1' ? '1' : '0' }}"{% endif %}>
{% if (!blank_page): %}
<a class="m-skip" href="#maincontent">跳至内容</a>
<aside class="m-sidebar" id="m-sidebar" aria-label="主导航">
 <a class="m-brand" href="{{ dispatcher.build_url('admin/myos') }}"><img class="m-brand-mark" src="{{ media }}/brand.png?v=2" alt="MYOS"><span>MYOS<span class="m-new">NEW</span></span></a>
 <div class="m-sidebar-device">{{ entityencode(board.model ?? 'OpenWrt') }}</div>
 <label class="m-search"><span aria-hidden="true">⌕</span><input id="m-menu-search" type="search" placeholder="搜索设置" aria-label="搜索设置"></label>
 <a class="m-home" href="{{ dispatcher.build_url('admin/myos') }}"><span class="m-nav-icon">⌂</span>首页</a>
 <nav id="m-menu"><p class="m-muted">正在载入导航…</p></nav>
 <div class="m-sidebar-bottom">
  <button type="button" class="m-unlock-trigger" aria-label="固件版本，连续点击八次打开插件认证">{{ entityencode(board.release?.version ?? '') }}</button>
  {% if (show_support_links): %}
  <div><a href="https://nradio.mayebano.shop/" target="_blank" rel="noopener noreferrer">打赏支持</a><a href="https://laoshenshiwo.cn/" target="_blank" rel="noopener noreferrer">冠名支持</a></div>
  {% endif %}
  <small>MYOS-NEW · LuCI</small>
 </div>
</aside>
<button id="m-scrim" class="m-scrim" aria-label="关闭导航" hidden></button>
<div class="m-workspace">
 <header class="m-toolbar"><div><button id="m-menu-toggle" class="m-icon-button m-mobile-toggle" aria-controls="m-sidebar" aria-expanded="false" aria-label="打开导航">☰</button><span id="m-page-title">设备控制台</span></div><div class="m-toolbar-actions"><span class="m-hostname">{{ entityencode(board.hostname ?? 'OpenWrt') }}</span><span id="indicators"></span><button id="m-background" class="m-icon-button" aria-label="自定义背景" title="自定义背景"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 5-5 4 4 4-6 5 7"/></svg></button><button id="m-appearance" class="m-icon-button" aria-label="切换深浅外观" title="切换深浅外观">◐</button><a class="m-icon-button" href="{{ dispatcher.build_url('admin/logout') }}" aria-label="退出登录" title="退出登录">↗</a></div></header>
 <main id="maincontent"><div id="tabmenu" hidden></div>
{% if (join('/', ctx.path ?? []) == 'admin/status/realtime/bandwidth'): %}
 <link rel="stylesheet" href="{{ media }}/iface-monitor.css?v=3">
 <details id="interface-monitor" class="ifmon-container" data-status-url="{{ dispatcher.build_url('admin/myos/data') }}" data-fast-url="{{ dispatcher.build_url('admin/myos/fast') }}" data-network-url="{{ dispatcher.build_url('admin/network/network') }}">
  <summary>接口监控</summary>
  <p class="ifmon-load-message" role="status" hidden></p>
  <div class="ifmon-content"></div>
 </details>
 <script type="module" src="{{ media }}/iface-bandwidth.js?v=3"></script>
{% endif %}
 <noscript><div class="alert-message warning">请启用 JavaScript 以使用 LuCI 管理界面。</div></noscript>
{% endif %}
