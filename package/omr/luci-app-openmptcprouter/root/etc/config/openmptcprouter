config settings 'settings'
	option enabled '1'
	option integration 'ultra'
	option proxy 'shadowsocks'
	option vpn 'glorytun_tcp'
	option disable_ipv6 '0'
	option disableintfrename '1'
	option defaultgw '1'
	option uci_route '0'
	option force_multipath '1'
	option menu 'OpenMPTCProuter'
	option tracebox '0'
	option check_ipv4_website 'http://ip.openmptcprouter.com'
	option check_ipv6_website 'http://ipv6.openmptcprouter.com'
	option status_vps_timeout '10'
	option status_getip_timeout '1'
	option status_whois_timeout '2'

config server 'vps'
	option username 'openmptcprouter'
	option port '65500'
	option master '1'
	option disabled '1'

config router 'omr'
