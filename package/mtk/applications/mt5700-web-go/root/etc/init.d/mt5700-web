#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

service_triggers() {
	# The serial backend rediscovers QModem for every command.  Reloading this
	# service on QModem runtime commits only tears down healthy WebSockets and
	# is unnecessary; restart solely for panel configuration changes.
	procd_add_reload_trigger "mt5700-web"
}

migrate_legacy_instance() {
	# uci show quotes section types (name='modem'). Accept quoted and legacy
	# unquoted output so an existing multi-modem setup is never recreated or
	# force-enabled on every service restart.
	uci -q show mt5700-web 2>/dev/null |
		grep -Eq "^mt5700-web\\.[^.]+=['\"]?modem['\"]?$" && return 0

	uci -q set mt5700-web.internal='modem'
	uci -q set mt5700-web.internal.enabled='1'
	uci -q set mt5700-web.internal.name='内置 MT5700'
	uci -q set mt5700-web.internal.path='internal'
	uci -q set mt5700-web.internal.ui_variant='modern'
	for option in transport modem_section at_port baudrate network_host network_port \
		command_timeout long_command_timeout queue_timeout websocket_idle_timeout max_clients; do
		value="$(uci -q get "mt5700-web.main.$option")"
		[ -n "$value" ] && uci -q set "mt5700-web.internal.$option=$value"
	done
	uci -q set mt5700-web.internal.transport="$(uci -q get mt5700-web.internal.transport || echo serial)"
	uci -q commit mt5700-web
}

start_service() {
	config_load mt5700-web
	migrate_legacy_instance
	config_load mt5700-web
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get listen main listen '0.0.0.0:9010'
	config_get_bool auth_enabled main auth_enabled 0
	config_get auth_username main auth_username 'admin'
	config_get auth_password_hash main auth_password_hash ''
	config_get transport main transport 'serial'
	config_get modem_section main modem_section 'auto'
	config_get at_port main at_port 'auto'
	config_get baudrate main baudrate '115200'
	config_get network_host main network_host '192.168.8.1'
	config_get network_port main network_port '20249'
	config_get command_timeout main command_timeout '8s'
	config_get long_command_timeout main long_command_timeout '240s'
	config_get queue_timeout main queue_timeout '60s'
	config_get websocket_idle_timeout main websocket_idle_timeout '5m'
	config_get max_clients main max_clients '8'
	config_get log_file main log_file '/var/log/mt5700-web.log'
	config_get log_max_bytes main log_max_bytes '2097152'
	config_get log_backups main log_backups '3'

	procd_open_instance
	procd_set_param command /usr/bin/mt5700-web-go
	procd_append_param command -listen "$listen"
	procd_append_param command -uci-package 'mt5700-web'
	# Go boolean flags must use the -flag=value form.  Passing "-flag 0"
	# makes flag.Parse() set the flag to true and stop at the stray "0",
	# so every option that follows it is silently ignored.
	procd_append_param command "-auth-enabled=$auth_enabled"
	procd_append_param command "-auth-username=$auth_username"
	procd_append_param command "-auth-password-hash=$auth_password_hash"
	procd_append_param command -transport "$transport"
	procd_append_param command -modem-section "$modem_section"
	procd_append_param command -serial "$at_port"
	procd_append_param command -baud "$baudrate"
	procd_append_param command -network-host "$network_host"
	procd_append_param command -network-port "$network_port"
	procd_append_param command -timeout "$command_timeout"
	procd_append_param command -long-timeout "$long_command_timeout"
	procd_append_param command -queue-timeout "$queue_timeout"
	procd_append_param command -ws-idle-timeout "$websocket_idle_timeout"
	procd_append_param command -max-clients "$max_clients"
	procd_append_param command -log-file "$log_file"
	procd_append_param command -log-max-bytes "$log_max_bytes"
	procd_append_param command -log-backups "$log_backups"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="4096 4096"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/mt5700-web /etc/config/qmodem
	procd_close_instance
}

reload_service() {
	stop
	start
}
