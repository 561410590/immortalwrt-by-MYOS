#!/bin/sh

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@turboacc[-1]
	add ucitrack turboacc
	set ucitrack.@turboacc[-1].init=turboacc
	commit ucitrack
EOF

if [ -e /sys/kernel/debug/hnat/hook_toggle ]; then
	uci set turboacc.config.sw_flow='0'
	uci set turboacc.config.sfe_flow='0'
	uci set turboacc.config.hw_flow='1'
fi

uci commit turboacc

exit 0
