#!/bin/sh
# Mwrt 内存优化首boot初始化(A + 拉起 B/C)。成功返回 0 后本脚本会被自动删除。

# ---- A: zram 参数写进 uci(zram-swap 的 init 会读取) ----
#   zstd 压缩 / 虚拟 768MB / 优先级 100(高于 SD swap 的 10,优先使用 zram)
#   小内存板(<768MB,如 512MB 的 C2000MAX)改成 lzo-rle / 虚拟 256MB:
#   - zstd 每核常驻一份压缩工作区,实测比 lzo-rle 多占约 7MB,而这类板平时几乎
#     不用 swap;1G 的板子才值得用 zstd 换压缩率。
#   - 真实数据约 3 倍压缩,768MB 的 zram 还没装满,压缩池就先把 512MB 物理内存吃光,
#     SD swap 永远轮不到,系统只会长时间卡顿、OOM 也不触发(2026-10-14 压测)。
#     256MB 满载时压缩池约 80MB,之后才轮到 SD 接着兜底。
algo=zstd
size=768
if [ "$(awk '/^MemTotal:/{print $2}' /proc/meminfo)" -lt 786432 ]; then
	algo=lzo-rle
	size=256
fi
uci -q batch <<-EOF
	set system.@system[0].zram_size_mb=$size
	set system.@system[0].zram_comp_algo=$algo
	set system.@system[0].zram_priority=100
	commit system
EOF

# 启用并拉起 zram(压缩内存交换,主力)
if [ -x /etc/init.d/zram ]; then
	/etc/init.d/zram enable 2>/dev/null
	/etc/init.d/zram restart 2>/dev/null
fi

# ---- B: SD swap 兜底服务(首次会后台生成 512MB 文件) ----
if [ -x /etc/init.d/mwrt-swapfile ]; then
	/etc/init.d/mwrt-swapfile enable 2>/dev/null
	/etc/init.d/mwrt-swapfile start 2>/dev/null
fi

# ---- C: sysctl 立即生效(文件随包已装入 /etc/sysctl.d/) ----
[ -f /etc/sysctl.d/30-mwrt-mem.conf ] && \
	sysctl -p /etc/sysctl.d/30-mwrt-mem.conf >/dev/null 2>&1

# ---- D: 数据包分流(RPS/RFS + WED 中断亲和),按在线核数自适应 ----
if [ -x /etc/init.d/mwrt-pktsteer ]; then
	/etc/init.d/mwrt-pktsteer enable 2>/dev/null
	/etc/init.d/mwrt-pktsteer start 2>/dev/null
fi

exit 0
