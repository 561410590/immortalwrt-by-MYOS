#!/bin/sh
#
# 99i-mwrt-luci-perf —— 首次启动时装好 LuCI 后台的两项提速
#
# 为什么不在源码里直接改主题模板:
#   注入点是 luci-theme-argon 的 /usr/lib/lua/luci/view/themes/argon/header.htm。
#   在 feeds/luci/themes/luci-theme-argon/ 里改会影响用这棵树编的所有板子,
#   所以改成运行期注入 —— 只有装了本脚本的固件才有这两项。
#   (跟 99-mwrt-aurora-skin / 99-mwrt-disclaimer 同一个路子。)
#
# 幂等,重复执行无副作用;install-luci-perf.sh 自己会判断是否已注入。

[ -x /usr/bin/install-luci-perf.sh ] || exit 0

/usr/bin/install-luci-perf.sh >/dev/null 2>&1

# 两条自愈,都避开整点、也避开 17 分(disclaimer)和 23 分(aurora-skin):
#
#   luci-theme-argon 升级会把 header.htm 覆盖回去 -> 每小时 41 分重新注入。
#   装/删带翻译的包会让静态字典过期 -> 每小时 43 分用 --if-stale 检查,
#   只有 .lmo 比产物新时才真的重写(223KB 一次 flash 擦写,不能每小时无脑刷)。
if ! grep -q 'install-luci-perf.sh' /etc/crontabs/root 2>/dev/null; then
	echo '41 * * * * /usr/bin/install-luci-perf.sh >/dev/null 2>&1' >> /etc/crontabs/root
	echo '43 * * * * /usr/bin/mwrt-gen-translations --if-stale >/dev/null 2>&1' >> /etc/crontabs/root
	/etc/init.d/cron reload >/dev/null 2>&1
fi

exit 0
