#!/bin/sh
# Install the fan schedule config and its cron tick.
#
# Idempotent: safe to re-run, keeps any config the user has already written.

CRONTAB=/etc/crontabs/root
TICK='* * * * * /usr/bin/mwrt-fansched apply >/dev/null 2>&1'

# ---- config ---------------------------------------------------------------

[ -f /etc/config/mwrt_fan ] || cat > /etc/config/mwrt_fan <<'CFG'
config sched 'main'
	option enabled '0'
	option starttime '23:00'
	option endtime '07:00'
	option weekdays ''
	option gear '0'
	option pwm '64'
	option tempmax '80'
CFG

# A config from an older build may predate the 'main' section.
uci -q get mwrt_fan.main >/dev/null || {
	uci -q set mwrt_fan.main=sched
	uci -q set mwrt_fan.main.enabled=0
	uci -q set mwrt_fan.main.starttime=23:00
	uci -q set mwrt_fan.main.endtime=07:00
	uci -q set mwrt_fan.main.gear=0
	uci -q set mwrt_fan.main.pwm=64
	uci -q set mwrt_fan.main.tempmax=80
	uci -q commit mwrt_fan
}

# tempmax was added after the first builds; without it an upgraded unit would
# pin a quiet gear with no thermal escape at all.
[ -n "$(uci -q get mwrt_fan.main.tempmax)" ] || {
	uci -q set mwrt_fan.main.tempmax=80
	uci -q commit mwrt_fan
}

# ---- cron tick ------------------------------------------------------------
#
# The minute tick is what opens and closes the window. The init script only
# reacts to config commits, so it cannot see the clock roll past 23:00.

touch "$CRONTAB"
if ! grep -qF 'mwrt-fansched apply' "$CRONTAB" 2>/dev/null; then
	echo "$TICK" >> "$CRONTAB"
	/etc/init.d/cron enable >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
fi

# ---- config-commit trigger ------------------------------------------------

if [ -x /etc/init.d/mwrt-fansched ]; then
	/etc/init.d/mwrt-fansched enable >/dev/null 2>&1
	/etc/init.d/mwrt-fansched start >/dev/null 2>&1
fi

exit 0
