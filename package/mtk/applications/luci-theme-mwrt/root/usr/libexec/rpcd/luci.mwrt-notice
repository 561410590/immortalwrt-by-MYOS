#!/bin/sh
# N5000: SD storage and firmware-update notices.
. /usr/share/libubox/jshn.sh
OTA_LATEST=/tmp/myos-update/state.json
SWAPBUSY=/tmp/mwrt-swapfile.busy
SWAPFILE=/overlay/swapfile
SWAP_MB=512
EXPAND_MARK=/tmp/mwrt-expand-rootfs.grown

# 在生成就输出进度(0-100), 还在等那 60 秒输出空串; 没在生成返回 1
swap_progress() {
	local pid sz
	pid="$(cat "$SWAPBUSY" 2>/dev/null)"
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	# 后台进程没了(被杀在半路)就不算, 关不掉的消息不能永远挂着
	grep -q mwrt-swapfile "/proc/$pid/cmdline" 2>/dev/null || return 1
	if [ -f "$SWAPFILE.tmp" ]; then
		sz="$(stat -c %s "$SWAPFILE.tmp" 2>/dev/null)"
		case "$sz" in ''|*[!0-9]*) sz=0 ;; esac
		echo $(( 5 + sz / 1048576 * 85 / SWAP_MB ))
	elif [ -f "$SWAPFILE" ]; then
		echo 95
	else
		echo
	fi
}

swap_text() {
	local sz=""
	[ -s "$EXPAND_MARK" ] && sz="$(df -h /overlay 2>/dev/null | awk 'NR==2{print $2}')"
	[ -n "$sz" ] && printf 'SD卡已自动扩容到%s，' "$sz"
	printf '正在创建%sMB虚拟内存（仅首次开机），约需2分钟，期间系统可能稍慢，请勿断电。' "$SWAP_MB"
}

add_notice() {
	json_add_object
	json_add_string id "$1"
	json_add_string level "$2"
	json_add_boolean closable "$3"
	json_add_string text "$4"
	[ -n "$5" ] && json_add_string link "$5"
	[ -n "$6" ] && json_add_int progress "$6"
	json_close_object
}

m_list() {
	local v p
	json_init
	json_add_array notices
	p="$(swap_progress)" && add_notice swapfile warn 0 "$(swap_text)" "" "$p"
	if [ -s "$OTA_LATEST" ] && [ "$(jsonfilter -i "$OTA_LATEST" -e '@.available' 2>/dev/null)" = "true" ]; then
		v="$(jsonfilter -i "$OTA_LATEST" -e '@.latest' 2>/dev/null)"
		[ -n "$v" ] && add_notice "ota-$v" info 1 "发现新固件 v$v" ota
	fi
	json_close_array
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object list; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			list) m_list ;;
			*) echo '{"error":"unknown method"}' ;;
		esac
		;;
esac
