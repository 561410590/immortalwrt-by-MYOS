#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	[ "$(uci -q get network.lan.proto)" = dhcp ] || return 0
	case "$(uci -q get network.lan.hostname)" in
		myos-ap-*|myos-n5000-ap-*) ;;
		*) return 0 ;;
	esac

	procd_open_instance control
	procd_set_param command /usr/sbin/uhttpd -f -p 0.0.0.0:9443 \
		-h /usr/share/myos-ap -x /cgi-bin -D -S -t 20
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance discovery
	procd_set_param command /usr/bin/lua -e 'require("myos_ap_discovery").listen()'
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
