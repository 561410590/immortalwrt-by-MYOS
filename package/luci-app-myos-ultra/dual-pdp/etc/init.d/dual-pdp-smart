#!/bin/sh /etc/rc.common
START=99
STOP=12
USE_PROCD=1
wanted() {
 [ "$(uci -q get dual_pdp.main.enabled)" = 1 ] &&
 [ "$(uci -q get dual_pdp.main.smart_enabled)" = 1 ] || return 1
 [ "$(uci -q get dual_pdp.main.dpi_enabled)" = 1 ] &&
 [ "$(jsonfilter -i /var/run/dual-pdp-manager/classifier.json -e @.enabled 2>/dev/null)" = true ]
}
start_service() {
 wanted || return 0
 procd_open_instance learner
 procd_set_param command /usr/sbin/dual-pdp-smart --config /var/run/dual-pdp-manager/classifier.json --output /var/run/dual-pdp-manager/learned.json
 procd_set_param nice 5
 procd_set_param respawn 3600 10 5
 procd_set_param limits core="0 0" nofile="64 64"
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_close_instance
}
reload_service() {
 if wanted; then
  service_running learner || start
 else stop; fi
}
service_triggers() { procd_add_reload_trigger dual_pdp; }
