config service 'main'
	option enabled '1'
	option listen '0.0.0.0:5700'
	option auth_enabled '0'
	option auth_username 'admin'
	option auth_password_hash ''
	option log_file '/var/log/mt5700-web.log'
	option log_max_bytes '2097152'
	option log_backups '3'

config modem 'internal'
	option enabled '1'
	option name '主模组 · 内置5G'
	option path 'internal'
	option ui_variant 'modern'
	option transport 'native'
	option modem_section 'cpe'
	option at_port 'auto'
	option baudrate '115200'
	option network_host '192.168.8.1'
	option network_port '20249'
	option command_timeout '8s'
	option long_command_timeout '240s'
	option queue_timeout '60s'
	option websocket_idle_timeout '5m'
	option max_clients '8'

config modem 'external'
	option enabled '1'
	option name '副模组 · PoE 5G'
	option path 'external'
	option ui_variant 'modern'
	option transport 'native'
	option modem_section 'cpe1'
	option command_timeout '8s'
	option long_command_timeout '240s'
	option queue_timeout '60s'
	option websocket_idle_timeout '5m'
	option max_clients '8'
