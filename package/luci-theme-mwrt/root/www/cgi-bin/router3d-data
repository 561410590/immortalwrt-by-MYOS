#!/bin/sh
# =============================================================================
# router3d-data  ——  免鉴权只读状态端点 (放 /www/cgi-bin/, 需 chmod +x)
# 只读 /proc /sys uci ubus,绝不调 sendat/AT(热路径,避免 tom_modem 进程泄漏)。
# 输出: Content-type application/json + 空行 + JSON。
# =============================================================================
printf 'Content-type: application/json\r\n'
printf 'Cache-Control: no-store\r\n'
printf '\r\n'

# --- helpers ---------------------------------------------------------------
rd() { cat "$1" 2>/dev/null; }
json_str() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    printf '%s' "$value"
}
is_num() { case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }

# --- model -----------------------------------------------------------------
# board_name 对 MAX/Ultra 是同一份 DTS(实测为 "NRadio-C2000MAX-Ultra",同时含
# MAX 与 Ultra 字样),无法据此区分。改用【物理核心数】判定:MAX=双核(mt7987B),
# Ultra=四核(mt7987A)。核心数是真实硬件反馈,不受共用机型名影响。
BOARD=$(rd /tmp/sysinfo/board_name)
[ -n "$BOARD" ] || BOARD=$(rd /proc/device-tree/model)
NCPU=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
is_num "$NCPU" || NCPU=1
[ "$NCPU" -gt 0 ] 2>/dev/null || NCPU=1
# E87N 先按机型串识别(model="EdgePi E87N" / board_name="edgepi,e87n"),它也是四核,
# 不先拦下会被下面"≥4核=Ultra"误判成 Ultra。前端 IMG 表据此选 e87n.png。
MODEL_ID=$(printf '%s %s' "$BOARD" "$(rd /tmp/sysinfo/model)" | tr 'A-Z' 'a-z')
case "$MODEL_ID" in
  *c5800*|*hcmt7981*) MODEL="C5800-688" ;;
  *h5000m*) MODEL="H5000M" ;;
  *n5000*) MODEL="N5000" ;;   # 与 Ultra 同款四核主板,须先拦下
  *e87n*|*edgepi*) MODEL="E87N" ;;
  *) if [ "$NCPU" -ge 4 ]; then MODEL="Ultra"; else MODEL="MAX"; fi ;;
esac
UPTIME=$(cut -d. -f1 /proc/uptime 2>/dev/null)
is_num "$UPTIME" || UPTIME=0

# --- firmware --------------------------------------------------------------
FW=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release 2>/dev/null)
[ -n "$FW" ] || FW=$(rd /etc/openwrt_version)
[ -n "$FW" ] || FW="OpenWrt"
if [ "$MODEL" = "C5800-688" ]; then
    VERSION=$(sed -n "s/^DISTRIB_RELEASE='\(.*\)'/\1/p" /etc/openwrt_release 2>/dev/null)
    [ -z "$VERSION" ] || FW="MYOS $VERSION"
else
    FW="${FW%% by *}"
fi

# --- cpu (load + cores) ----------------------------------------------------
# NCPU 已在上面 model 区块算过(用于机型判定),此处复用。
read LOAD1 _rest < /proc/loadavg 2>/dev/null
[ -n "$LOAD1" ] || LOAD1=0

# --- memory (KB) -----------------------------------------------------------
MEM_LINE=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{print t,a}' /proc/meminfo 2>/dev/null)
MEM_T=${MEM_LINE% *}; MEM_A=${MEM_LINE#* }
is_num "$MEM_T" || MEM_T=0
is_num "$MEM_A" || MEM_A=0

# --- temperature (max thermal zone, °C) ------------------------------------
TEMP="null"; TMAX=-1
for z in /sys/class/thermal/thermal_zone*/temp; do
    [ -e "$z" ] || continue
    v=$(rd "$z"); is_num "$v" || continue
    [ "$v" -gt "$TMAX" ] && TMAX="$v"
done
[ "$TMAX" -ge 0 ] 2>/dev/null && TEMP=$(( (TMAX + 500) / 1000 ))

# --- storage (overlay, KB) -------------------------------------------------
SLINE=$(df -k /overlay 2>/dev/null | awk 'NR==2{print $2" "$3}')
[ -n "$SLINE" ] || SLINE=$(df -k / 2>/dev/null | awk 'NR==2{print $2" "$3}')
ST_T=${SLINE%% *}; ST_U=${SLINE#* }
is_num "$ST_T" || ST_T=0
is_num "$ST_U" || ST_U=0

# --- online clients (distinct reachable MACs on LAN bridge) ----------------
# 用 ARP 完成态(flag 0x2)按 MAC 去重,而非 DHCP 租约行数
# (租约会残留离线设备;同一主机多 IP 也应算 1 台)。
LANDEV=$(uci -q get network.lan.device); [ -n "$LANDEV" ] || LANDEV=br-lan
CLIENTS=$(awk -v d="$LANDEV" '$6==d && $3=="0x2" && $4!="00:00:00:00:00:00" && !seen[$4]++{n++} END{print n+0}' /proc/net/arp 2>/dev/null)
is_num "$CLIENTS" || CLIENTS=0

# --- wan ip (effective default-route source addr, no AT) -------------------
ROUTE=$(ip -4 route get 8.8.8.8 2>/dev/null)
WANIP=""; TRDEV=""; EGW=""
set -- $ROUTE
while [ "$#" -gt 1 ]; do
    case "$1" in src) WANIP=$2 ;; dev) TRDEV=$2 ;; via) EGW=$2 ;; esac
    shift
done
# 子网前缀位数(/24 这种)。首页卡片把它做成一枚小徽章挂在 IP 末尾(内容美化,不另发请求)。
# WANIP 是实际出口的源地址,从各接口的 inet 行里反查它的 /NN;取不到就留 0,前端不显示徽章。
WANPFX=0
if [ -n "$WANIP" ]; then
    WANPFX=$(ip -4 addr show 2>/dev/null | sed -n "s#.*inet $WANIP/\([0-9][0-9]*\).*#\1#p" | head -1)
    is_num "$WANPFX" || WANPFX=0
fi

# --- unique premium fields (与下方蜂窝模组区块不重复) -----------------------
KERNEL=$(rd /proc/sys/kernel/osrelease)
LANIP=$(uci -q get network.lan.ipaddr)
[ -n "$LANIP" ] || LANIP=$(ip -4 addr show br-lan 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
# LAN 前缀: 先看 netmask(uci 配置里就是点分形式),换算成位数;netmask 空就从 br-lan 的 inet /NN 取
LANPFX=0
LANMASK=$(uci -q get network.lan.netmask)
if [ -n "$LANMASK" ]; then
    oIFS=$IFS; IFS=.; set -- $LANMASK; IFS=$oIFS
    for o in "$@"; do
        case "$o" in
            255) LANPFX=$((LANPFX+8)) ;;
            254) LANPFX=$((LANPFX+7)) ;; 252) LANPFX=$((LANPFX+6)) ;;
            248) LANPFX=$((LANPFX+5)) ;; 240) LANPFX=$((LANPFX+4)) ;;
            224) LANPFX=$((LANPFX+3)) ;; 192) LANPFX=$((LANPFX+2)) ;;
            128) LANPFX=$((LANPFX+1)) ;;
        esac
    done
fi
if [ "$LANPFX" = "0" ] && [ -n "$LANIP" ]; then
    LANPFX=$(ip -4 addr show br-lan 2>/dev/null | sed -n "s#.*inet $LANIP/\([0-9][0-9]*\).*#\1#p" | head -1)
    is_num "$LANPFX" || LANPFX=0
fi
CONNS=$(rd /proc/sys/net/netfilter/nf_conntrack_count); is_num "$CONNS" || CONNS=0

# --- ports (eth carrier/speed) --------------------------------------------
WANDEV=$(uci -q get network.wan.device)
[ -n "$WANDEV" ] || WANDEV=eth0
port_json=""
PORTS="/sys/class/net/eth*"
[ "$MODEL" != "C5800-688" ] || PORTS="/sys/class/net/lan* /sys/class/net/port5"
for dev in $PORTS; do
    [ -e "$dev" ] || continue
    name=${dev##*/}
    # 只保留【物理真实存在】的网口:
    #   1) 设备树 GMAC(uevent 含 OF_NAME=mac),排除 modem/内部虚拟口
    #      (如 eth2 = 2_1 数据口,MAC 伪造、carrier 恒 1);
    #   2) 且必须绑定了 PHY(存在 phydev 符号链接)。C2000MAX 只有一个物理网口,
    #      源码 02_network 为方便同时声明了 eth0/eth1,但 MAX 上未接 PHY 的那个 MAC
    #      (eth0)无 phydev、operstate 恒 down —— 据此过滤掉,面板只反映真实网口。
    #      Ultra 两个物理口都绑 PHY,均保留。
    if [ "$MODEL" != "C5800-688" ]; then
        grep -q 'OF_NAME=mac' "$dev/uevent" 2>/dev/null || continue
        [ -e "$dev/phydev" ] || continue
    fi
    car=$(rd "$dev/carrier"); [ "$car" = "1" ] || car=0
    spd=$(rd "$dev/speed"); is_num "$spd" || spd=-1
    [ "$car" = "1" ] || spd=-1
    up=$(rd "$dev/operstate"); [ "$up" = "up" ] && upv=1 || upv=0
    if [ "$name" = "$WANDEV" ]; then role="WAN";
    elif [ "$MODEL" = "C5800-688" ] && [ "$name" = "port5" ]; then role="ODU";
    else role="LAN"; fi
    # cnt = 开机以来插线次数, 前端据此判断"刚插上"(放一次接入动画), 不靠自己记上一轮
    cnt=$(rd "$dev/carrier_up_count"); is_num "$cnt" || cnt=0
    # s74 悬停浮层用: 本口累计收发、双工、MAC(都是 sysfs 单文件)
    prx=$(rd "$dev/statistics/rx_bytes"); is_num "$prx" || prx=0
    ptx=$(rd "$dev/statistics/tx_bytes"); is_num "$ptx" || ptx=0
    dup=""; [ "$car" = "1" ] && dup=$(rd "$dev/duplex")
    mac=$(rd "$dev/address")
    [ -n "$port_json" ] && port_json="$port_json,"
    port_json="$port_json{\"id\":\"$name\",\"role\":\"$role\",\"carrier\":$car,\"speed\":$spd,\"up\":$upv,\"cnt\":$cnt,\"rx\":$prx,\"tx\":$ptx,\"dup\":\"$(json_str "$dup")\",\"mac\":\"$(json_str "$mac")\"}"
done

# --- usb (外接 USB 设备, 只读 sysfs) ----------------------------------------
# 判型交给 /usr/libexec/mwrt-usbinfo(全局接入通知用的同一份), 一台一行 "|" 分隔。
usb_json=""
if [ -x /usr/libexec/mwrt-usbinfo ]; then
    while IFS='|' read -r ub uv up us ut um usub user umfr uname; do
        [ -n "$ub" ] || continue
        is_num "$us" || us=0; is_num "$um" || um=0; is_num "$usub" || usub=0
        [ -n "$usb_json" ] && usb_json="$usb_json,"
        usb_json="$usb_json{\"bus\":\"$(json_str "$ub")\",\"vid\":\"$(json_str "$uv")\",\"pid\":\"$(json_str "$up")\",\"speed\":$us,\"type\":\"$(json_str "$ut")\",\"mb\":$um,\"sub\":$usub,\"mfr\":\"$(json_str "$umfr")\",\"name\":\"$(json_str "$uname")\"}"
    done <<USBEOF
$(/usr/libexec/mwrt-usbinfo 2>/dev/null)
USBEOF
fi

# --- wan traffic (累计收发字节,单次读取) -----------------------------------
# 计数取【实际出口】,不取 network.wan.device: 后者是物理 WAN 口(eth0),
# 走 5G 模组上网时它没插线、计数恒 0,真正出流量的是模组数据口(eth2 = 2_1)。
# 出口和上面 WANIP 用同一条 route get,两格永远对应同一个接口;
# 没有默认路由时回落到物理 WAN 口。
# TRDEV、WANIP、EGW 复用上面同一次实际路由读取。
# s74 当前上网方式(产品图左上角徽章): 按实际出口网卡归类, 没有默认路由就是 none。
#   apcli*/wlan* = WiFi 桥接; 物理 WAN 口 / pppoe-* / 其他物理 GMAC 口 = 有线;
#   其余(模组数据口 eth2、usb0、wwan0 等) = 蜂窝
EGDEV=$TRDEV; EGKIND=none
if [ -n "$EGDEV" ]; then
    case "$EGDEV" in
        apcli*|wlan*) EGKIND=wifi ;;
        port5|eth1) if [ "$MODEL" = "C5800-688" ]; then EGKIND=cell; else EGKIND=wired; fi ;;
        pppoe-*|"$WANDEV") EGKIND=wired ;;
        *) if grep -q 'OF_NAME=mac' "/sys/class/net/$EGDEV/uevent" 2>/dev/null; then EGKIND=wired; else EGKIND=cell; fi ;;
    esac
fi
# 物理 WAN 口自己的协议和地址(不管它是不是当前出口; pppoe 时地址在 pppoe-wan 上)
WANPROTO=$(uci -q get network.wan.proto)
WANL3=$WANDEV; [ "$WANPROTO" = "pppoe" ] && WANL3=pppoe-wan
WANADDR=$(ip -4 addr show dev "$WANL3" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\/[0-9]*\).*/\1/p' | head -1)
[ -n "$TRDEV" ] && [ -e "/sys/class/net/$TRDEV/statistics" ] || TRDEV=$WANDEV
WRX=$(rd "/sys/class/net/$TRDEV/statistics/rx_bytes"); is_num "$WRX" || WRX=0
WTX=$(rd "/sys/class/net/$TRDEV/statistics/tx_bytes"); is_num "$WTX" || WTX=0

# --- modem (no AT!) --------------------------------------------------------
MODCONF=$(rd /tmp/modconf.conf)
SIMSEL=$(rd /tmp/sim_sel); [ -n "$SIMSEL" ] || SIMSEL=$(uci -q get mwrt.@ndis[0].simsel)
[ -n "$SIMSEL" ] || SIMSEL="0"
present=0
[ -n "$MODCONF" ] && present=1
if [ "$MODEL" = "C5800-688" ]; then
    [ -n "$(uci -q get network.cpe.proto)" ] && present=1
    SIMSEL=$(uci -q get cpesel.sim.cur)
fi
CSQ="null"
for cf in /tmp/modem_csq /tmp/run/modem_csq; do
    v=$(rd "$cf"); if is_num "$v"; then CSQ="$v"; fi
done

printf '{"model":"%s","board":"%s","fw":"%s","kernel":"%s","uptime":%s,"cpu":{"load1":%s,"ncpu":%s},"mem":{"total":%s,"avail":%s},"temp":%s,"storage":{"total":%s,"used":%s},"clients":%s,"conns":%s,"wan_ip":"%s","wan_pfx":%s,"lan_ip":"%s","lan_pfx":%s,"wan_rx":%s,"wan_tx":%s,"ports":[%s],"usb":[%s],"egress":{"dev":"%s","kind":"%s","gw":"%s"},"wan_proto":"%s","wan_addr":"%s","modem":{"present":%s,"modconf":"%s","sim_sel":"%s","csq":%s}}\n' \
    "$MODEL" "$(json_str "$BOARD")" "$(json_str "$FW")" "$(json_str "$KERNEL")" "$UPTIME" \
    "$LOAD1" "$NCPU" "$MEM_T" "$MEM_A" "$TEMP" "$ST_T" "$ST_U" "$CLIENTS" "$CONNS" \
    "$(json_str "$WANIP")" "$WANPFX" "$(json_str "$LANIP")" "$LANPFX" "$WRX" "$WTX" "$port_json" "$usb_json" \
    "$(json_str "$EGDEV")" "$EGKIND" "$EGW" "$(json_str "$WANPROTO")" "$WANADDR" \
    "$present" "$(json_str "$MODCONF")" "$(json_str "$SIMSEL")" "$CSQ"
