#!/bin/sh
# Deliberately public: a single non-sensitive image, no path or command input.
base=/www/luci-static/c2000max-ui/wallpaper
image="$base/default.jpg"
info="$base/default.json"
if [ -s /tmp/c2000max-ui/bing.jpg ] && [ -s /tmp/c2000max-ui/bing.json ]; then
 image=/tmp/c2000max-ui/bing.jpg
 info=/tmp/c2000max-ui/bing.json
fi
if [ "$QUERY_STRING" = info ]; then
 printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
 [ "$REQUEST_METHOD" = HEAD ] || cat "$info"
elif [ -s "$image" ]; then
 printf 'Content-Type: image/jpeg\r\nCache-Control: no-cache\r\nX-Content-Type-Options: nosniff\r\n\r\n'
 [ "$REQUEST_METHOD" = HEAD ] || cat "$image"
else
 printf 'Status: 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
 printf 'Wallpaper unavailable\n'
fi
